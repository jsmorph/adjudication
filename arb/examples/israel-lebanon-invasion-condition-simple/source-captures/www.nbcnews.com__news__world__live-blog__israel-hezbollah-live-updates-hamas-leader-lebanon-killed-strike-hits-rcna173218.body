      'cat': mpsSection,
      'cag[platform]': 'ramen',
      'cag[targeting]': mpsTargeting,
      'cag[sentiment]': 'none',
      'adunit': `${mpsAdUnitPath}`,
      'type': `${targetType}`,
      'content_id': id,
      'referrer': undefined,
      'site': `${mpsVendorName}-bento`,
      'path': `${mpsContentPath}`,
      'cag[adunit1]': mpsAdUnit,
      'cag[adunit2]': mpsVendorAdUnit,
      'cag[adunit3]': mpsSection,
      'cag[adunit4]': '',
      'cag[adunit5]': '',
      'title': headline,
    };
  })();</script><script>(function(){const mpsVendorUrl = "https://mps.nbcuni.com/fetch/ext/load-nbcnews-bento.js?nowrite=jq";

    function loadScript(src, eventName) {
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;

        script.onload = () => {
          if (eventName) {
            const event = new CustomEvent(eventName, { detail: { src } });
            window.dispatchEvent(event);
            document.documentElement.dataset[eventName.toLowerCase()] = 'true';
          }
          resolve();
        };

        script.onerror = () => {
          reject(new Error(`## Failed to load script: ${src}`));
        };

        document.head.appendChild(script);
      });
    }

    loadScript(mpsVendorUrl, 'mpsLoaded')
      .then(() => {
        return Promise.all([]);
      })
      .catch((error) => {
        console.error(error);
      });
  })();</script><script>(function(){const MPS_MEDIA_QUERY = {"mobile":"(max-width: 757px)","tablet":"(min-width: 758px) and (max-width: 999px)","desktop":"(min-width: 1000px)"};

    const breakpoints = {
      mobile: MPS_MEDIA_QUERY.mobile,
      tablet: MPS_MEDIA_QUERY.tablet,
      desktop: MPS_MEDIA_QUERY.desktop,
    };

    function onBreakpointChange(callback) {
      Object.entries(breakpoints).forEach(([key, query]) => {
        const mediaQuery = window.matchMedia(query);
        callback(key, mediaQuery.matches);

        const listener = (event) => {
          if (event.matches) {
            callback(key, true);
          } else {
            callback(key, false);
          }
        };
        mediaQuery.addEventListener('change', listener);
      });
    }

    window.addEventListener('mpsLoaded', () => {
      window.mps &&
        mps._ready(function () {
          onBreakpointChange((breakpoint, matches) => {
            if (matches) {
              mps.refreshAds(['topbanner', 'boxflex']);
            }
          });
        });
    });
  })();</script><style>@layer varsReact{._omegaContainer_1pyq3_8{--omega-floating-container-height: 147px;--omega-floating-container-bottom: 20px}@media (width >= 758px){._omegaContainer_1pyq3_8{--omega-floating-container-height: 205px;--omega-floating-container-bottom: 40px}}@media (width >= 1000px){._omegaContainer_1pyq3_8{--omega-floating-container-height: 188px}}@media (width >= 1240px){._omegaContainer_1pyq3_8{--omega-floating-container-height: 208px}}}@layer componentsReact{._slate_1pyq3_30{container:slate/inline-size;flex-direction:column;aspect-ratio:16/9;font-family:"FoundersGroteskCond",var(--font-sans);color:var(--text-white);background:radial-gradient(72.09% 72.09% at 50% 17.15%,#3a4856 0,#29333c 40%,#0e161a)}._slateIntro_1pyq3_38,._slateMessage_1pyq3_39{margin-bottom:0;line-height:normal}._slateIntro_1pyq3_38{font-size:calc(6.2cqi + 2px);margin-top:calc(-2.6cqi - 26px)}._slateMessage_1pyq3_39{font-size:calc(4.2cqi + 2px);margin-top:6px;width:75%}._omegaContainer_1pyq3_8,._omegaFloatingContainer_1pyq3_53{aspect-ratio:16/9}._omegaFloatingContainer_1pyq3_53{bottom:var(--omega-floating-container-bottom);right:0;height:var(--omega-floating-container-height)}._dismissFloatingPipButton_1pyq3_61{background:transparent;position:absolute;top:8px;right:8px;z-index:2}.hed:has(._omegaFloatingContainer_1pyq3_53){z-index:4}.header.sticky:has(~main ._omegaFloatingContainer_1pyq3_53){z-index:5}}@layer varsReact{._exampleClass_1focg_8{--fill: var(--bg-1)}@media (width >= 758px){._exampleClass_1focg_8{--fill: var(--bg-2)}}.vars-today ._exampleClass_1focg_8{--fill: var(--bg-2)}@media (width >= 758px){.vars-today ._exampleClass_1focg_8{--fill: var(--bg-1)}}}@layer componentsReact{._exampleClass_1focg_8{background-color:var(--fill)}}@layer vars{._tooltip_i12cn_8{--text-bg: var(--bg-2);--triangle-size: 10px;--text-distance: calc(100% + var(--triangle-size) + 1px);--border-radius: 5px;--stroke-width: 1px;--stroke-color: var(--gray-3);--text-font: var(--font-sans);--text-size: 