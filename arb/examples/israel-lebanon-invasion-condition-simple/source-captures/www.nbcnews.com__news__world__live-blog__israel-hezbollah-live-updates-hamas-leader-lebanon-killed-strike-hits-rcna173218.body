dItems":"e2","countNewItems":"e4"},"\u0002q-CV7VKWvn.js#s_mNTj9dDf5Yk[2 0 1]",true,"\u0012e7","\u0003a 0 e6 #0 e8","rcrd57634","markup","p","Arata Yamamoto has been an NBC News producer in Tokyo since 1993.",{"type":"eb","element":"ec","html":"ed"},["ee"],"",null,"ncpn6496","Arata.Yamamoto@nbcuni.com",[],"Arata Yamamoto","nbcnews","organization",{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"eh","youtube":"eh"},"person",[],[],[],{"bio":"ef","liveBlogShortBio":"eg","shortBio":"eh","id":"ei","email":"ej","jobTitle":"ek","name":"el","primaryImage":"eh","publisher":"eo","socialMediaProfiles":"ep","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"er","educationAndExpertise":"es","awards":"et"},["eu"],"Japan would much rather see a cease-fire between Israel and foes to its west and north than the limited ground incursion targeting Hezbollah fighters in Lebanon, Japan’s chief cabinet secretary said at his daily news briefing.",{"type":"eb","element":"ec","html":"ew"},"“Amidst calls by the international community for restraint for all parties concerned ... Israel conducted a ground operation in Lebanon,” Yoshimasa Hayashi said. ",{"type":"eb","element":"ec","html":"ey"},"“Japan expresses its grave concern,” he added.",{"type":"eb","element":"ec","html":"f0"},"Yoshimasa called for Israel and its enemies to lay down their arms and perform the following: do earnest work on a diplomatic solution, show restraint on the battlefield, implement measures to prevent civilian casualties, comply with international humanitarian laws and implement a United Nations resolution, known as 1701, that calls on peacekeeping forces and Lebanese soldiers to maintain a zone between Israel and Hezbollah fighters.",{"type":"eb","element":"ec","html":"f2"},"About 50 Japanese citizens are in Lebanon, Hayashi said. The country is prepared to do whatever is needed to get them out, he said, including using Self-Defense Force aircraft for evacuations.",{"type":"eb","element":"ec","html":"f4"},["ex","ez","f1","f3","f5"],["ew","ey","f0","f2","f4"],{"markupAndEmbeds":"f6","text":"f7"},"2024-10-01T05:07:43.539Z","2024-10-01T05:17:55.202Z",{"createdAt":"f9","publishedAt":"f9","modifiedAt":"fa"},"Japan would much rather see a cease-fire between Israel and foes to its west and north than the limited ground incursion targeting Hezbollah fighters in Lebanon",{"primary":"fc","seo":"fc"},"Japan has 'grave concern' over Israel's incursion",{"primary":"fe","seo":"fe","social":"fe"},"default",{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57634",{"primary":"fi"},"Reporting from Tokyo",[],{"markupAndEmbeds":"fl"},[],{"markupAndEmbeds":"fn"},[],{"markupAndEmbeds":"fp"},{"analysis":"fm","citations":"fo","verdict":"fq"},[],{"nativeAd":"e2","id":"ea","authors":"ev","isHeadlineHidden":"e2","content":"f8","date":"fb","description":"fd","headline":"ff","presentation":"fh","primaryImage":"eh","teaseImage":"eh","url":"fj","reportingFrom":"fk","factCheckContent":"fr","replies":"fs"},"rcrd57580","NBC News",{"type":"eb","element":"ec","html":"fv"},["fw"],"ncpn399176",[],{"name":"em","subType":"eh","type":"en"},"http://www.facebook.com/nbcnews","@nbcnews",{"email":"eh","facebook":"g1","instagram":"em","pinterest":"eh","snapchat":"eh","twitter":"g2","youtube":"eh"},[],[],[],{"bio":"fx","liveBlogShortBio":"eg","shortBio":"eh","id":"fy","email":"eh","jobTitle":"fz","name":"fv","primaryImage":"eh","publisher":"g0","socialMediaProfiles":"g3","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"g4","educationAndExpertise":"g5","awards":"g6"},["g7"],"embeddedVideo","mmvo220498501747","video","PT1M11S","Tue Oct 01 2024 00:44:18 GMT+0000 (UTC)","2024-10-01T00:03:11.000Z",{"publishedAt":"ge","createdAt":"ge"},"NONE","220498501747","f_mo_beirut_airport_explosions_240930",{"id":"gh","guid":"gi","externalAdvertiserId":"gi"},"negative","webExtra",[],{"contentClassifications":"gm"},"Video shows smoke and explosions in distance at Beirut airport",{"primary":"go","seo":"go"},"Smoke can be seen in the distance as explosions happen at Beirut-Rafic Hariri International Airport. Officials said Israel's ground incursion into Lebanon appears to have begun.",{"primary":"gq"},"https://www.nbcnews.com/video/video-shows-smoke-and-explosions-in-distance-at-beirut-airport-220498501747","video-shows-smoke-and-explosions-in-distance-at-beirut-airport-220498501747",{"canonical":"gs","primary":"gs","slug":"gt"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2024/09/f_mo_beirut_airport_explosions_240930_0806.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2024/09/f_mo_beirut_airport_explosions_240930_0806.vtt",{"srt":"gv","webvtt":"gw"},"EMP","M3U","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/f_mo_beirut_airport_explosions_240930/1/abs/index.m3u8",1080,1920,71,4512000,{"assetType":"gy","format":"gz","publicUrl":"h0","height":"h1","width":"h2","assetDuration":"h3","bitrate":"h4"},"akamaiMp4","MPEG4","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2024/09/f_mo_beirut_airport_explosions_240930_0839_4500.mp4",4512956,{"assetType":"h6","format":"h7","publicUrl":"h8","height":"h1","width":"h2","assetDuration":"h3","bitrate":"h9"},["h5","ha"],"vidimg3251502743",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2024_10/f_mo_beirut_airport_explosions_240930.00_00_08_25.Still001-ughiuv.jpg",{"primary":"he"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"hc","headline":"hd","caption":"eh","altText":"eh","url":"hf","encodingFormat":"eh","height":"eh","width":"eh","date":"hg","authors":"hh","source":"eh"},{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},{"primary":"he"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"hc","headline":"hj","caption":"eh","altText":"eh","url":"hk","encodingFormat":"eh","height":"eh","width":"eh","date":"hl","authors":"hm","source":"eh"},"Israel-Iran attacks",{"primary":"ho"},"mmvo262517829603","262517829603","tdy_news_7a_cheung_gas_prices_war_260501",{"id":"hr","guid":"hs","externalAdvertiserId":"hs"},"vidimg1363687875",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_05/1777634482858_tdy_news_7a_cheung_gas_prices_war_260501_S3_1920x1080-hlzu21.jpg",{"primary":"hw"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"hu","headline":"hv","caption":"eh","altText":"eh","url":"hx","encodingFormat":"eh","height":"eh","width":"eh","date":"hy","authors":"hz","source":"eh"},"https://www.today.com/video/us-gas-prices-spike-more-than-30-cents-in-just-one-week-262517829603","us-gas-prices-spike-more-than-30-cents-in-just-one-week-262517829603",{"canonical":"i1","primary":"i1","slug":"i2"},"PT1M54S","neutral","broadcast","US Gas Prices Surge 9 Cents in Just One Day to $4.39 a Gallon","US Gas Prices Spike More Than 30 Cents in Just One Week",{"primary":"i7","seo":"i8"},"As the war in Iran enters its 60th day, gas prices in the United States are even higher with the national average climbing to $4.39 — a nine cent increase in just one day and up more than 30 cents in a week. NBC’s Brian Cheung joins TODAY to break down how much higher gas prices are expected to go, as well as what the latest GDP numbers say about the economy.",{"primary":"ia"},"today",{"name":"ic"},"TODAY",{"name":"ie"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/05/1777634482858_tdy_news_7a_cheung_gas_prices_war_260501.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/05/1777634482858_tdy_news_7a_cheung_gas_prices_war_260501.vtt",{"srt":"ig","webvtt":"ih"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/tdy_news_7a_cheung_gas_prices_war_260501/1/abs/index.m3u8",113.614,4199000,{"assetType":"gy","format":"gz","publicUrl":"ij","height":"h1","width":"h2","assetDuration":"ik","bitrate":"il"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/05/1777634482858_tdy_news_7a_cheung_gas_prices_war_260501_6.mp4",4199069,{"assetType":"h6","format":"h7","publicUrl":"in","height":"h1","width":"h2","assetDuration":"ik","bitrate":"io"},["im","ip"],{"type":"gb","id":"hq","mpxMetadata":"ht","primaryImage":"i0","url":"i3","duration":"i4","sentiment":"i5","videoType":"i6","headline":"i9","description":"ib","publisher":"id","source":"if","closedCaptioning":"ii","videoAssets":"iq"},"mmvo262445637675","262445637675","tdy_news_7a_romans_gas_prices_iran_260430",{"id":"it","guid":"iu","externalAdvertiserId":"iu"},"vidimg2766115370",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_04/1777548015869_tdy_news_7a_romans_gas_prices_iran_260430_S3_1920x1080-le49z3.jpg",{"primary":"iy"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"iw","headline":"ix","caption":"eh","altText":"eh","url":"iz","encodingFormat":"eh","height":"eh","width":"eh","date":"j0","authors":"j1","source":"eh"},"https://www.today.com/video/gas-prices-are-up-more-than-1-since-start-of-war-with-iran-262445637675","gas-prices-are-up-more-than-1-since-start-of-war-with-iran-262445637675",{"canonical":"j3","primary":"j3","slug":"j4"},"PT2M8S","National Average for Gas Prices Now at $4.30 a Gallon","Gas Prices Are Up More Than $1 Since Start of War With Iran",{"primary":"j7","seo":"j8"},"The war in Iran is fueling new inflation fears and higher gas prices with the national average jumping another seven cents to $4.30 for a gallon of regular gas. It is up more than $1.30 since the start of the war. NBC’s Christine Romans joins TODAY to break down how the standoff in the Strait of Hormuz is impacting prices at the pump and provides analysis on the Federal Reserve’s decision to keep interest rates steady.",{"primary":"ja"},{"name":"ic"},{"name":"ie"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777548015869_tdy_news_7a_romans_gas_prices_iran_260430.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777548015869_tdy_news_7a_romans_gas_prices_iran_260430.vtt",{"srt":"je","webvtt":"jf"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/tdy_news_7a_romans_gas_prices_iran_260430/1/abs/index.m3u8",128.362,4229000,{"assetType":"gy","format":"gz","publicUrl":"jh","height":"h1","width":"h2","assetDuration":"ji","bitrate":"jj"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/1777548015869_tdy_news_7a_romans_gas_prices_iran_260430_6.mp4",4229777,{"assetType":"h6","format":"h7","publicUrl":"jl","height":"h1","width":"h2","assetDuration":"ji","bitrate":"jm"},["jk","jn"],{"type":"gb","id":"is","mpxMetadata":"iv","primaryImage":"j2","url":"j5","duration":"j6","sentiment":"i5","videoType":"i6","headline":"j9","description":"jb","publisher":"jc","source":"jd","closedCaptioning":"jg","videoAssets":"jo"},"mmvo262445125718","262445125718","tdy_news_7a_nobles_iran_cost_blockade_260430",{"id":"jr","guid":"js","externalAdvertiserId":"js"},"vidimg828317456",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_04/1777547487151_tdy_news_7a_nobles_iran_cost_blockade_260430_S3_1920x1080-bxf23u.jpg",{"primary":"jw"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"ju","headline":"jv","caption":"eh","altText":"eh","url":"jx","encodingFormat":"eh","height":"eh","width":"eh","date":"jy","authors":"jz","source":"eh"},"https://www.today.com/video/trump-and-iran-remain-deadlocked-as-oil-prices-continue-to-rise-262445125718","trump-and-iran-remain-deadlocked-as-oil-prices-continue-to-rise-262445125718",{"canonical":"k1","primary":"k1","slug":"k2"},"PT2M3S","Trump Vows to Keep Hormuz Blockade as Gas Prices Climb Higher","Trump and Iran Remain Deadlocked as Oil Prices Continue to Rise",{"primary":"k5","seo":"k6"},"President Donald Trump says the war with Iran and the United States' blockade of the Strait of Hormuz will continue unless Iran gives in, saying, “At this moment, there will never be a deal unless they agree that there will be no nuclear weapons.” It comes as Pentagon officials say the war has cost $25 billion so far during a tense hearing on Capitol Hill where Defense Secretary Pete Hegseth faced criticism of the administration’s strategy. NBC’s Ryan Nobles reports for TODAY.",{"primary":"k8"},{"name":"ic"},{"name":"ie"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777547487151_tdy_news_7a_nobles_iran_cost_blockade_260430.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777547487151_tdy_news_7a_nobles_iran_cost_blockade_260430.vtt",{"srt":"kc","webvtt":"kd"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/tdy_news_7a_nobles_iran_cost_blockade_260430/1/abs/index.m3u8",123.157,4272000,{"assetType":"gy","format":"gz","publicUrl":"kf","height":"h1","width":"h2","assetDuration":"kg","bitrate":"kh"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/1777547487151_tdy_news_7a_nobles_iran_cost_blockade_260430_6.mp4",4272590,{"assetType":"h6","format":"h7","publicUrl":"kj","height":"h1","width":"h2","assetDuration":"kg","bitrate":"kk"},["ki","kl"],{"type":"gb","id":"jq","mpxMetadata":"jt","primaryImage":"k0","url":"k3","duration":"k4","sentiment":"i5","videoType":"i6","headline":"k7","description":"k9","publisher":"ka","source":"kb","closedCaptioning":"ke","videoAssets":"km"},"mmvo262402629675","262402629675","nn_rno_nuclear_deal_260429",{"id":"kp","guid":"kq","externalAdvertiserId":"kq"},"vidimg2018930257",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_04/1777503261241_nn_rno_nuclear_deal_260429_S3_1920x1080-66w2kl.jpg",{"primary":"ku"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"ks","headline":"kt","caption":"eh","altText":"eh","url":"kv","encodingFormat":"eh","height":"eh","width":"eh","date":"kw","authors":"kx","source":"eh"},"https://www.nbcnews.com/nightly-news/video/trump-says-blockade-will-stay-until-iran-makes-nuclear-deal-262402629675","trump-says-blockade-will-stay-until-iran-makes-nuclear-deal-262402629675",{"canonical":"kz","primary":"kz","slug":"l0"},"PT1M39S","noAdsUpsettingContent","Trump says blockade will stay until Iran makes nuclear deal",{"primary":"l4","seo":"l4"},"President Trump said he would not drop his blockade of Iran’s ports designed to pressure Iran to make a nuclear deal. Plus, Democrats grilled Pentagon leaders over the war. NBC News’ Ryan Nobles reports.",{"primary":"l6"},{"name":"em"},"Nightly News",{"name":"l9"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777503261241_nn_rno_nuclear_deal_260429.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777503261241_nn_rno_nuclear_deal_260429.vtt",{"srt":"lb","webvtt":"lc"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nn_rno_nuclear_deal_260429/1/abs/index.m3u8",99.3,4134000,{"assetType":"gy","format":"gz","publicUrl":"le","height":"h1","width":"h2","assetDuration":"lf","bitrate":"lg"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/1777503261241_nn_rno_nuclear_deal_260429_6.mp4",4134038,{"assetType":"h6","format":"h7","publicUrl":"li","height":"h1","width":"h2","assetDuration":"lf","bitrate":"lj"},["lh","lk"],{"type":"gb","id":"ko","mpxMetadata":"kr","primaryImage":"ky","url":"l1","duration":"l2","sentiment":"l3","videoType":"i6","headline":"l5","description":"l7","publisher":"l8","source":"la","closedCaptioning":"ld","videoAssets":"ll"},"mmvo262337093717","262337093717","f_mo_la_trump_iran_260428",{"id":"lo","guid":"lp","externalAdvertiserId":"lp"},"vidimg1487243975",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_04/trump_dinner_260428-fys8am.jpg",{"primary":"lt"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"lr","headline":"ls","caption":"eh","altText":"eh","url":"lu","encodingFormat":"eh","height":"eh","width":"eh","date":"lv","authors":"lw","source":"eh"},"https://www.nbcnews.com/video/trump-speaks-on-iran-war-while-toasting-king-charles-262337093717","trump-speaks-on-iran-war-while-toasting-king-charles-262337093717",{"canonical":"ly","primary":"ly","slug":"lz"},"PT47S","Trump speaks on Iran war while toasting King Charles",{"primary":"m2","seo":"m2"},"In remarks during the state dinner with King Charles and Queen Camilla, Trump referred to the Iran war as “a little Middle East work” and said the two leaders agreed Iran would not have a nuclear weapon.",{"primary":"m4"},{"name":"em"},{"name":"fv"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/f_mo_la_trump_iran_260428_2245.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/f_mo_la_trump_iran_260428_2245.vtt",{"srt":"m8","webvtt":"m9"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/f_mo_la_trump_iran_260428/1/abs/index.m3u8",47,4509000,{"assetType":"gy","format":"gz","publicUrl":"mb","height":"h1","width":"h2","assetDuration":"mc","bitrate":"md"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/f_mo_la_trump_iran_260428_2245_4500.mp4",4509600,{"assetType":"h6","format":"h7","publicUrl":"mf","height":"h1","width":"h2","assetDuration":"mc","bitrate":"mg"},["me","mh"],{"type":"gb","id":"ln","mpxMetadata":"lq","primaryImage":"lx","url":"m0","duration":"m1","sentiment":"gk","videoType":"gl","headline":"m3","description":"m5","publisher":"m6","source":"m7","closedCaptioning":"ma","videoAssets":"mi"},["ir","jp","kn","lm","mj"],{"headline":"hp","videos":"mk"},{"id":"ga","type":"gb","duration":"gc","dateBroadcast":"gd","date":"gf","liveVideoStatus":"gg","playable":"e7","mpxMetadata":"gj","sentiment":"gk","videoType":"gl","contentRules":"gn","headline":"gp","description":"gr","url":"gu","closedCaptioning":"gx","videoAssets":"hb","primaryImage":"hi","teaseImage":"hn","associatedVideoPlaylist":"ml"},{"type":"g9","video":"mm"},"Smoke can be seen in the distance as explosions happen at Beirut-Rafic Hariri International Airport shortly after officials said Israel’s ground incursion into Lebanon had begun.",{"type":"eb","element":"ec","html":"mo"},["mn","mp"],["mo"],{"markupAndEmbeds":"mq","text":"mr"},"2024-10-01T04:08:09.539Z",{"createdAt":"mt","publishedAt":"mt","modifiedAt":"mt"},"Smoke can be seen in the distance as explosions happen at Beirut-Rafic Hariri International Airport shortly after officials said Israel’s ground incursion into",{"primary":"mv","seo":"mv"},"Video shows smoke and explosions in distance at Beirut airport ",{"primary":"mx","seo":"mx","social":"mx"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57580",{"primary":"n0"},[],{"markupAndEmbeds":"n2"},[],{"markupAndEmbeds":"n4"},[],{"markupAndEmbeds":"n6"},{"analysis":"n3","citations":"n5","verdict":"n7"},[],{"nativeAd":"e2","id":"fu","authors":"g8","isHeadlineHidden":"e7","content":"ms","date":"mu","description":"mw","headline":"my","presentation":"mz","primaryImage":"eh","teaseImage":"eh","url":"n1","reportingFrom":"eh","factCheckContent":"n8","replies":"n9"},"rcrd57593","I am a senior breaking news reporter for NBC News Digital, covering a range of news-of-the-day topics. My job is to report in a timely manner on crime, mass shootings, war coverage, domestic and international affairs, pop culture and more.",{"type":"eb","element":"ec","html":"nc"},["nd"],"Doha Madani is a senior breaking news reporter for NBC News. Pronouns: she/her.","ncpn915866","Doha.Madani@nbcuni.com","Senior Breaking News Reporter",["ni"],"Doha Madani",{"name":"em","subType":"eh","type":"en"},"@dohamadani",{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"nm","youtube":"eh"},"https://www.nbcnews.com/author/doha-madani-ncpn915866","doha-madani-ncpn915866",{"canonical":"no","primary":"no","slug":"np"},"I did my undergraduate studies in government and journalism at the University of Tampa before obtaining a master's degree in international reporting at the CUNY Graduate School of Journalism. My byline has appeared at the Tampa Tribune, Lebanon's The Daily Star, and HuffPost. While at NBC News I've had the privilege of covering some of our biggest stories including the pandemic, the Depp-Heard trial, the Supreme Court's Dobbs decision, and the Israel-Hamas war. ",{"type":"eb","element":"ec","html":"nr"},["ns"],[],[],{"bio":"ne","liveBlogShortBio":"eg","shortBio":"nf","id":"ng","email":"nh","jobTitle":"nj","name":"nk","primaryImage":"eh","publisher":"nl","socialMediaProfiles":"nn","subType":"eh","type":"eq","url":"nq","worksFor":"eh","experience":"nt","educationAndExpertise":"nu","awards":"nv"},["nw"],"Some critics have expressed skepticism about the description of Israel’s ground operation in Lebanon as “targeted,” recalling similar representations of Israel’s ground assault into Rafah in May. ",{"type":"eb","element":"ec","html":"ny"},"<a href=\"https://www.nbcnews.com/news/world/israel-stand-alone-netanyahu-biden-rafah-weapons-hamas-rcna151608\" target=\"_blank\">Biden had threatened to withhold arms</a> from Israel if there was a major ground offensive in Rafah but later said <a href=\"https://www.nbcnews.com/news/world/israel-rafah-strike-ground-assault-dont-cross-bidens-red-line-rcna154428\" target=\"_blank\">the offensive did not cross his administration's “red line”</a> because it was limited to a strategic area in order to fight Hamas.",{"type":"eb","element":"ec","html":"o0"},"In July, <a href=\"https://www.nbcnews.com/news/world/israel-hamas-war-rafah-destroyed-tunnels-idf-visit-cease-fire-talks-rcna160651\" target=\"_blank\">NBC News was able to visit the city</a> and documented a devastated ghost town. Buildings were completely leveled, and there was almost no one to be found, whereas just weeks before it was home to more than 1 million Palestinians.  ",{"type":"eb","element":"ec","html":"o2"},["nz","o1","o3"],"Biden had threatened to withhold arms from Israel if there was a major ground offensive in Rafah but later said the offensive did not cross his administration's “red line” because it was limited to a strategic area in order to fight Hamas.","In July, NBC News was able to visit the city and documented a devastated ghost town. Buildings were completely leveled, and there was almost no one to be found, whereas just weeks before it was home to more than 1 million Palestinians.  ",["ny","o5","o6"],{"markupAndEmbeds":"o4","text":"o7"},"2024-10-01T02:47:00.622Z","2024-10-01T03:19:21.812Z",{"createdAt":"o9","publishedAt":"o9","modifiedAt":"oa"},"Some critics have expressed skepticism about the description of Israel’s ground operation in Lebanon as “targeted,” recalling similar representations of Israel’",{"primary":"oc","seo":"oc"},"Critics question Israel's description of ground operation",{"primary":"oe","seo":"oe","social":"oe"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57593",{"primary":"oh"},[],{"markupAndEmbeds":"oj"},[],{"markupAndEmbeds":"ol"},[],{"markupAndEmbeds":"on"},{"analysis":"ok","citations":"om","verdict":"oo"},[],{"nativeAd":"e2","id":"nb","authors":"nx","isHeadlineHidden":"e2","content":"o8","date":"ob","description":"od","headline":"of","presentation":"og","primaryImage":"eh","teaseImage":"eh","url":"oi","reportingFrom":"eh","factCheckContent":"op","replies":"oq"},"rcrd57499","I am a reporter who covers domestic and international news, including war, crime and large-scale natural disasters to the latest celebrity scandal. I'm also passionate about reporting on race and religion, mainly the marginalization of minority communities in the U.S.",{"type":"eb","element":"ec","html":"ot"},["ou"],"Mirna Alsharif is a breaking news reporter for NBC News.","ncpn1297517","mirna.alsharif@nbcuni.com","Reporter, Breaking News",["oz"],"Mirna Alsharif","Mirna Alsharif.",1500,"https://media-cldnry.s-nbcnews.com/image/upload/newscms/2022_46/3581066/mirna-alsharif-byline-jm.jpg",{"primary":"p4"},{"altText":"p2","height":"p3","url":"p5","width":"p3"},{"name":"em","subType":"eh","type":"en"},"@mirna_alsharif",{"email":"eh","facebook":"eh","instagram":"p8","pinterest":"eh","snapchat":"eh","twitter":"p8","youtube":"eh"},"https://www.nbcnews.com/author/mirna-alsharif-ncpn1297517","mirna-alsharif-ncpn1297517",{"canonical":"pa","primary":"pa","slug":"pb"},"Prior to  NBC News, I wrote for CNN where I covered some of the biggest stories of the past five years, including the killing of George Floyd and the outset of the Covid-19 pandemic.",{"type":"eb","element":"ec","html":"pd"},["pe"],[],"I was a finalist for AMEJA's (Arab and Middle Eastern Journalists Association) Excellence in Reporting Awards in the category \"Best coverage of Arab and Middle Eastern heritage communities in North America.\"",{"type":"eb","element":"ec","html":"ph"},["pi"],{"bio":"ov","liveBlogShortBio":"eg","shortBio":"ow","id":"ox","email":"oy","jobTitle":"p0","name":"p1","primaryImage":"p6","publisher":"p7","socialMediaProfiles":"p9","subType":"eh","type":"eq","url":"pc","worksFor":"eh","experience":"pf","educationAndExpertise":"pg","awards":"pj"},["pk"],"British families of Israeli hostages had a message for Prime Minister Benjamin Netanyahu at a London news conference today: make a deal so their loved ones can come home.",{"type":"eb","element":"ec","html":"pm"},"“My message to him is to listen to the people of Israel and get that deal,” said Sharone Lifschitz, whose father, Oded, 84, remains in captivity in Gaza after he was captured on Oct. 7. Lifschitz's mother, Yocheved, was freed last year as part of an exchange for Palestinian prisoners.  ",{"type":"eb","element":"ec","html":"po"},"“I don't think that he should wait until after the election to reach a deal. There is the possibility of a deal now, and what is missing is the will of both sides,” she added. ",{"type":"eb","element":"ec","html":"pq"},"Stephen Brisley, whose brother-in-law Eli Sharabi, 52, remains in Gaza, called on Netanyahu to “become statesmanlike and do the right thing and secure a deal.” ",{"type":"eb","element":"ec","html":"ps"},"“Too long has passed with the deal in various iterations over the last six or eight months,\" Brisley said. \"It’s unfathomable to me that it’s been impossible to get one of those deals over the line.\"",{"type":"eb","element":"ec","html":"pu"},["pn","pp","pr","pt","pv"],["pm","po","pq","ps","pu"],{"markupAndEmbeds":"pw","text":"px"},"2024-10-01T01:24:32.856Z","2024-10-01T01:31:15.404Z",{"createdAt":"pz","publishedAt":"pz","modifiedAt":"q0"},"British families of Israeli hostages had a message for Prime Minister Benjamin Netanyahu at a London news conference today: make a deal so their loved ones can",{"primary":"q2","seo":"q2"},"British families of Israeli hostages tell Netanyahu to make a deal for their return",{"primary":"q4","seo":"q4","social":"q4"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57499",{"primary":"q7"},[],{"markupAndEmbeds":"q9"},[],{"markupAndEmbeds":"qb"},[],{"markupAndEmbeds":"qd"},{"analysis":"qa","citations":"qc","verdict":"qe"},[],{"nativeAd":"e2","id":"os","authors":"pl","isHeadlineHidden":"e2","content":"py","date":"q1","description":"q3","headline":"q5","presentation":"q6","primaryImage":"eh","teaseImage":"eh","url":"q8","reportingFrom":"eh","factCheckContent":"qf","replies":"qg"},"rcrd57506","Anthony Landahl ",{"type":"eb","element":"ec","html":"qj"},["qk"],"ncpn1310406",[],"Anthony Landahl",{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"eh","youtube":"eh"},[],[],[],{"bio":"ql","liveBlogShortBio":"eg","shortBio":"eh","id":"qm","email":"eh","jobTitle":"qn","name":"qo","primaryImage":"eh","publisher":"qp","socialMediaProfiles":"qq","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"qr","educationAndExpertise":"qs","awards":"qt"},["qu"],"Secretary of State Antony Blinken called Hezbollah leader Hassan Nasrallah a “brutal terrorist” today and said Lebanon, the Middle East and the world are safer without him.",{"type":"eb","element":"ec","html":"qw"},"Speaking at the D-ISIS Ministerial meeting at the State Department, Blinken also underscored that pursuing diplomacy was the only route to bring stability to the region.",{"type":"eb","element":"ec","html":"qy"},"mmvo220459589958","PT57S","Mon Sep 30 2024 18:11:07 GMT+0000 (UTC)","2024-09-30T17:37:57.000Z",{"publishedAt":"r3","createdAt":"r3"},"220459589958","f_mo_blinken_nasrallah_240930",{"id":"r5","guid":"r6","externalAdvertiserId":"r6"},"noAdsOtherReasons",[],{"contentClassifications":"r9"},"Blinken reacts to Hezbollah leaders death, says world is ‘safer without him’",{"primary":"rb","seo":"rb"},"Secretary of State Antony Blinken reacted to the death of Hezbollah leader Hassan Nasrallah by saying the Middle East was safer without him and that diplomacy would continue to stabilize the region.",{"primary":"rd"},"https://www.nbcnews.com/video/blinken-reacts-to-hezbollah-leaders-death-says-world-is-safer-without-him-220459589958","blinken-reacts-to-hezbollah-leaders-death-says-world-is-safer-without-him-220459589958",