"width":"eh","date":"tb","authors":"tc","source":"eh"},"https://www.nbcnews.com/nightly-news/video/two-jewish-men-stabbed-in-london-262406725855","two-jewish-men-stabbed-in-london-262406725855",{"canonical":"te","primary":"te","slug":"tf"},"PT1M41S","Two Jewish men stabbed in London","Two Jewish men stabbed in London ",{"primary":"ti","seo":"tj"},"A 45-year-old suspect has been arrested after stabbing two Jewish men in North London. New video shows the dramatic moment officers took the suspect down. NBC News’ Daniele Hamamdjian reports from the scene. ",{"primary":"tl"},{"name":"em"},{"name":"l9"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777505477575_nn_london_stabbing_terror_attack_260429.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777505477575_nn_london_stabbing_terror_attack_260429.vtt",{"srt":"tp","webvtt":"tq"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nn_london_stabbing_terror_attack_260429/1/abs/index.m3u8",101.035,4311000,{"assetType":"gy","format":"gz","publicUrl":"ts","height":"h1","width":"h2","assetDuration":"tt","bitrate":"tu"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/1777505477575_nn_london_stabbing_terror_attack_260429_6.mp4",4311232,{"assetType":"h6","format":"h7","publicUrl":"tw","height":"h1","width":"h2","assetDuration":"tt","bitrate":"tx"},["tv","ty"],{"type":"gb","id":"t3","mpxMetadata":"t6","primaryImage":"td","url":"tg","duration":"th","sentiment":"l3","videoType":"i6","headline":"tk","description":"tm","publisher":"tn","source":"to","closedCaptioning":"tr","videoAssets":"tz"},"mmvo262402629694","262402629694","nn_emc_king_charles_queen_camilla_new_york_city_260429",{"id":"u2","guid":"u3","externalAdvertiserId":"u3"},"vidimg1492528698",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_04/1777503377704_nn_emc_king_charles_queen_camilla_new_york_city_260429_S3_1920x1080-kepbyb.jpg",{"primary":"u7"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"u5","headline":"u6","caption":"eh","altText":"eh","url":"u8","encodingFormat":"eh","height":"eh","width":"eh","date":"u9","authors":"ua","source":"eh"},"https://www.nbcnews.com/nightly-news/video/king-charles-and-queen-camilla-in-new-york-city-262402629694","king-charles-and-queen-camilla-in-new-york-city-262402629694",{"canonical":"uc","primary":"uc","slug":"ud"},"PT1M9S","King Charles and Queen Camilla in New York City",{"primary":"ug","seo":"ug"},"King Charles and Queen Camilla spent the day in New York City visiting the 9/11 memorial, an urban farm, and a New York public library. The queen also spoke exclusively to the TODAY show's Jenna Bush Hager. NBC News’ Erin McLaughlin has the story.",{"primary":"ui"},{"name":"em"},{"name":"l9"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777503377704_nn_emc_king_charles_queen_camilla_new_york_city_260429.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777503377704_nn_emc_king_charles_queen_camilla_new_york_city_260429.vtt",{"srt":"um","webvtt":"un"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nn_emc_king_charles_queen_camilla_new_york_city_260429/1/abs/index.m3u8",69.169,4214000,{"assetType":"gy","format":"gz","publicUrl":"up","height":"h1","width":"h2","assetDuration":"uq","bitrate":"ur"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/1777503377704_nn_emc_king_charles_queen_camilla_new_york_city_260429_6.mp4",4214456,{"assetType":"h6","format":"h7","publicUrl":"ut","height":"h1","width":"h2","assetDuration":"uq","bitrate":"uu"},["us","uv"],{"type":"gb","id":"u1","mpxMetadata":"u4","primaryImage":"ub","url":"ue","duration":"uf","sentiment":"i5","videoType":"i6","headline":"uh","description":"uj","publisher":"uk","source":"ul","closedCaptioning":"uo","videoAssets":"uw"},{"id":"kp","guid":"kq","externalAdvertiserId":"kq"},{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},{"primary":"ku"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"ks","headline":"uz","caption":"eh","altText":"eh","url":"v0","encodingFormat":"eh","height":"eh","width":"eh","date":"v1","authors":"v2","source":"eh"},{"canonical":"kz","primary":"kz","slug":"l0"},{"primary":"l4","seo":"l4"},{"primary":"l6"},{"name":"em"},{"name":"l9"},{"srt":"lb","webvtt":"lc"},{"assetType":"gy","format":"gz","publicUrl":"le","height":"h1","width":"h2","assetDuration":"lf","bitrate":"lg"},{"assetType":"h6","format":"h7","publicUrl":"li","height":"h1","width":"h2","assetDuration":"lf","bitrate":"lj"},["va","vb"],{"type":"gb","id":"ko","mpxMetadata":"uy","primaryImage":"v3","url":"v4","duration":"l2","sentiment":"l3","videoType":"i6","headline":"v5","description":"v6","publisher":"v7","source":"v8","closedCaptioning":"v9","videoAssets":"vc"},"mmvo262373957847","262373957847","f_tov_lon_londonattack_260429",{"id":"vf","guid":"vg","externalAdvertiserId":"vg"},"vidimg407791110",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_04/f_tov_lon_londonattack_260429-pc8fgu.jpg",{"primary":"vk"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"vi","headline":"vj","caption":"eh","altText":"eh","url":"vl","encodingFormat":"eh","height":"eh","width":"eh","date":"vm","authors":"vn","source":"eh"},"https://www.nbcnews.com/video/knife-attack-wounds-two-jewish-men-in-london-police-declare-terrorist-incident-262373957847","knife-attack-wounds-two-jewish-men-in-london-police-declare-terrorist-incident-262373957847",{"canonical":"vp","primary":"vp","slug":"vq"},"PT1M31S","Two wounded as knife attacker targets London’s Jewish community","Knife attack wounds two Jewish men in London, police declare terrorist incident",{"primary":"vt","seo":"vu"},"U.K. police declared a stabbing attack that injured two Jewish people in London was a \"terrorist incident.\" A 45-year-old man with a history of mental health issues stabbed and seriously wounded two Jewish men in Golders Green, North London.",{"primary":"vw"},{"name":"em"},{"name":"fv"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/f_tov_lon_londonattack_260429_1341.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/f_tov_lon_londonattack_260429_1341.vtt",{"srt":"w0","webvtt":"w1"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/f_tov_lon_londonattack_260429/1/abs/index.m3u8",91,4514000,{"assetType":"gy","format":"gz","publicUrl":"w3","height":"h1","width":"h2","assetDuration":"w4","bitrate":"w5"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/f_tov_lon_londonattack_260429_1342_4500.mp4",4514273,{"assetType":"h6","format":"h7","publicUrl":"w7","height":"h1","width":"h2","assetDuration":"w4","bitrate":"w8"},["w6","w9"],{"type":"gb","id":"ve","mpxMetadata":"vh","primaryImage":"vo","url":"vr","duration":"vs","sentiment":"l3","videoType":"gl","headline":"vv","description":"vx","publisher":"vy","source":"vz","closedCaptioning":"w2","videoAssets":"wa"},["t2","u0","ux","vd","wb"],{"headline":"s6","videos":"wc"},{"id":"r0","type":"gb","duration":"r1","dateBroadcast":"r2","date":"r4","liveVideoStatus":"gg","playable":"e7","mpxMetadata":"r7","sentiment":"r8","videoType":"gl","contentRules":"ra","headline":"rc","description":"re","url":"rh","closedCaptioning":"rk","videoAssets":"rs","primaryImage":"rz","teaseImage":"s4","associatedVideoPlaylist":"wd"},{"type":"g9","video":"we"},["qx","qz","wf"],["qw","qy"],{"markupAndEmbeds":"wg","text":"wh"},"2024-10-01T00:18:31.034Z","2024-10-01T00:33:51.393Z",{"createdAt":"wj","publishedAt":"wj","modifiedAt":"wk"},"Secretary of State Antony Blinken called Hezbollah leader Hassan Nasrallah a “brutal terrorist” today and said Lebanon, the Middle East and the world are safer",{"primary":"wm","seo":"wm"},"World is 'safer' without Hezbollah leader, Blinken says",{"primary":"wo","seo":"wo","social":"wo"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57506",{"primary":"wr"},[],{"markupAndEmbeds":"wt"},[],{"markupAndEmbeds":"wv"},[],{"markupAndEmbeds":"wx"},{"analysis":"wu","citations":"ww","verdict":"wy"},[],{"nativeAd":"e2","id":"qi","authors":"qv","isHeadlineHidden":"e2","content":"wi","date":"wl","description":"wn","headline":"wp","presentation":"wq","primaryImage":"eh","teaseImage":"eh","url":"ws","reportingFrom":"eh","factCheckContent":"wz","replies":"x0"},"rcrd57551","I cover domestic and global breaking news as it happens, almost always remotely, from <a href=\"https://www.nbcnews.com/news/us-news/police-respond-active-shooter-texas-elementary-school-rcna30339\" target=\"_blank\">mass shootings</a> and natural disasters to pop culture stories. As a native San Diegan who learned reporting by watching some of the best working in Los Angeles, I specialized in crime and police, Hollywood diversity and cutting-edge music. The <a href=\"https://www.nbcnews.com/news/latino/chicano-renaissance-new-mexican-american-generation-embraces-term-n869846\" target=\"_blank\">reemergence of the Chicano identity in the Trump era</a>, the calls for social change after <a href=\"https://www.nbcnews.com/news/us-news/surfing-confronts-sport-s-racist-past-after-george-floyd-s-n1231379\" target=\"_blank\">George Floyd’s murder</a>, observing <a href=\"https://www.nbcnews.com/tech/tech-news/vintage-roller-coaster-fans-see-familiar-tech-elon-musk-s-n951311\" target=\"_blank\">Elon Musk's use of century old technology</a> to tout a vision of the future — it's all news to me. ",{"type":"eb","element":"ec","html":"x3"},["x4"],"Dennis Romero is a breaking news reporter for NBC News Digital.","ncpn856406","dennis.romero@nbcuni.com","Breaking News Reporter",["x9"],"Dennis Romero","Image: Dennis Romero","https://media-cldnry.s-nbcnews.com/image/upload/newscms/2020_03/3184066/dennis-romero-circle-byline-template.jpg",{"primary":"xd"},{"altText":"xc","height":"p3","url":"xe","width":"p3"},{"name":"em","subType":"eh","type":"en"},"instagram.com/drjournalist","@dennisjromero","YouTube.com/dennisjromero",{"email":"eh","facebook":"eh","instagram":"xh","pinterest":"eh","snapchat":"eh","twitter":"xi","youtube":"xj"},"https://www.nbcnews.com/author/dennis-romero-ncpn856406","dennis-romero-ncpn856406",{"canonical":"xl","primary":"xl","slug":"xm"},"The son of a newspaper reporter who covered the border and Mexico, and the grandson of a television journalist who announced news from a desk in Tijuana in the 1950s, I started early, covering police on a freelance basis for the border-area Star-News in Chula Vista, California, when I was in high school. I freelanced for The New York Times and the Los Angeles Times while earning a B.A. in political science at UCLA. I was a regular at Santa Monica and Beverly Hills City Council meetings for the L.A. Times and — after an arts beat internship there — I stuck around during my senior year and successfully begged to be deployed during the Los Angeles riots. I ended up as a minor part of the team that won a Pulitzer Prize for breaking news coverage. I went to The Philadelphia Inquirer after school and soon returned to the Times as a staff writer specializing in youth culture and pop music. I worked as a staff writer at two magazines before settling in at LA Weekly as a daily news reporter for eight years. My career at NBC News started in 2018.",{"type":"eb","element":"ec","html":"xo"},["xp"],[]," ",{"type":"eb","element":"ec","html":"xs"},"<span style=\"font-size: 11pt; font-family: Arial,sans-serif; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\">In 1992, I participated in the Los Angeles Times' team coverage of the L.A. riots, for which the publication won a Pulitzer Prize for breaking news. In 2006 I was recognized for investigative reporting by the nonprofit New America Media Awards for a story on Latinos vociferously opposed to those who come to the United States illegally. In the 2010s, I was a finalist multiple times for the title of online journalist of the year, bestowed by the Los Angeles Press Club. In 2016 I declined a journalism award from the group National Hispanic Media Coalition for my coverage of the effort to include more Latinos on NBC’s \"Saturday Night Live.\" I had worked with the organization on that coverage, which quoted its leader, and I felt that accepting the award would undermine the credibility of the coverage.</span>",{"type":"eb","element":"ec","html":"xu"},["xt","xv"],{"bio":"x5","liveBlogShortBio":"eg","shortBio":"x6","id":"x7","email":"x8","jobTitle":"xa","name":"xb","primaryImage":"xf","publisher":"xg","socialMediaProfiles":"xk","subType":"eh","type":"eq","url":"xn","worksFor":"eh","experience":"xq","educationAndExpertise":"xr","awards":"xw"},["xx"],"mmvo220489285790","PT2M6S","Mon Sep 30 2024 22:55:24 GMT+0000 (UTC)","2024-09-30T22:55:22.000Z","2024-09-30T22:55:21.000Z",{"publishedAt":"y2","createdAt":"y3"},"220489285790","nn_ren_Israel_Lebanon_240930",{"id":"y5","guid":"y6","externalAdvertiserId":"y6"},[],{"contentClassifications":"y8"},"Israel appears to have begun a limited ground incursion in Lebanon, U.S. officials say",{"primary":"ya","seo":"ya"},"Israel appears to have begun a limited ground incursion into Lebanon, according to two U.S. officials, with the aim of pushing Hezbollah forces farther away from the border with Israel. The move follows the killing of Hezbollah's leader and much of its top command. NBC News' Richard Engel reports",{"primary":"yc"},"https://www.nbcnews.com/nightly-news/video/israel-appears-to-have-begun-a-limited-ground-incursion-in-lebanon-u-s-officials-say-220489285790","israel-appears-to-have-begun-a-limited-ground-incursion-in-lebanon-u-s-officials-say-220489285790",{"canonical":"ye","primary":"ye","slug":"yf"},"https://nbcnewsdigital-static.nbcuni.com/media/captions/NBC_News_Digital/2024/09/1727738498162_nn_ren_Israel_Lebanon_240930.srt","https://nbcnewsdigital-static.nbcuni.com/media/captions/NBC_News_Digital/2024/09/1727738498162_nn_ren_Israel_Lebanon_240930.vtt",{"srt":"yh","webvtt":"yi"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nn_ren_Israel_Lebanon_240930/2/abs/index.m3u8",126.093,4398000,{"assetType":"gy","format":"gz","publicUrl":"yk","height":"h1","width":"h2","assetDuration":"yl","bitrate":"ym"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2024/09/1727738498162_nn_ren_Israel_Lebanon_240930_6.mp4",4398489,{"assetType":"h6","format":"h7","publicUrl":"yo","height":"h1","width":"h2","assetDuration":"yl","bitrate":"yp"},["yn","yq"],"vidimg2992798592",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2024_09/1727738498162_nn_ren_Israel_Lebanon_240930_1920x1080-jng383.jpg",{"primary":"yu"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"ys","headline":"yt","caption":"eh","altText":"eh","url":"yv","encodingFormat":"eh","height":"eh","width":"eh","date":"yw","authors":"yx","source":"eh"},{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},{"primary":"yu"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"ys","headline":"yz","caption":"eh","altText":"eh","url":"z0","encodingFormat":"eh","height":"eh","width":"eh","date":"z1","authors":"z2","source":"eh"},{"primary":"l9"},"mmvo262500421607","262500421607","nn_kod_AttemptedAssassinationImages_260430",{"id":"z6","guid":"z7","externalAdvertiserId":"z7"},"vidimg1381905178",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_05