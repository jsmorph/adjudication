fectively only for Palestinian prisoners.",{"primary":"19j"},{"name":"em"},{"name":"fv"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/f_tov_lon_deathpenalty_260401_1624.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/f_tov_lon_deathpenalty_260401_1624.vtt",{"srt":"19n","webvtt":"19o"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/f_tov_lon_deathpenalty_260401/1/abs/index.m3u8",87,{"assetType":"gy","format":"gz","publicUrl":"19q","height":"h1","width":"h2","assetDuration":"19r","bitrate":"w5"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/f_tov_lon_deathpenalty_260401_1624_4500.mp4",4514043,{"assetType":"h6","format":"h7","publicUrl":"19t","height":"h1","width":"h2","assetDuration":"19r","bitrate":"19u"},["19s","19v"],{"type":"gb","id":"192","mpxMetadata":"195","primaryImage":"19c","url":"19f","duration":"19g","sentiment":"gk","videoType":"gl","headline":"19i","description":"19k","publisher":"19l","source":"19m","closedCaptioning":"19p","videoAssets":"19w"},"mmvo259621957845","259621957845","now_hallie_million_displaced_260319",{"id":"19z","guid":"1a0","externalAdvertiserId":"1a0"},"vidimg3904235194",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_03/1773965431309_now_hallie_million_displaced_260319_S3_1920x1080-o92gm8.jpg",{"primary":"1a4"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"1a2","headline":"1a3","caption":"eh","altText":"eh","url":"1a5","encodingFormat":"eh","height":"eh","width":"eh","date":"1a6","authors":"1a7","source":"eh"},"https://www.nbcnews.com/video/over-a-million-people-displaced-in-lebanon-as-israel-expands-offensive-against-hezbollah-259621957845","over-a-million-people-displaced-in-lebanon-as-israel-expands-offensive-against-hezbollah-259621957845",{"canonical":"1a9","primary":"1a9","slug":"1aa"},"PT2M46S","Over a million people displaced in Lebanon as Israel expands offensive against Hezbollah",{"primary":"1ad","seo":"1ad"},"More than a million people have been displaced in Lebanon, according to the UN, as strikes between Israel and Hezbollah intensify. NBC News’ Raf Sanchez details the destruction. ",{"primary":"1af"},{"name":"em"},{"name":"17s"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/03/1773965431309_now_hallie_million_displaced_260319.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/03/1773965431309_now_hallie_million_displaced_260319.vtt",{"srt":"1aj","webvtt":"1ak"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/now_hallie_million_displaced_260319/1/abs/index.m3u8",166.04,4253000,{"assetType":"gy","format":"gz","publicUrl":"1am","height":"h1","width":"h2","assetDuration":"1an","bitrate":"1ao"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/03/1773965431309_now_hallie_million_displaced_260319_6.mp4",4253883,{"assetType":"h6","format":"h7","publicUrl":"1aq","height":"h1","width":"h2","assetDuration":"1an","bitrate":"1ar"},["1ap","1as"],{"type":"gb","id":"19y","mpxMetadata":"1a1","primaryImage":"1a8","url":"1ab","duration":"1ac","sentiment":"l3","videoType":"i6","headline":"1ae","description":"1ag","publisher":"1ah","source":"1ai","closedCaptioning":"1al","videoAssets":"1at"},"mmvo259187269773","259187269773","f_tov_lon_gaza_shortage_260312",{"id":"1aw","guid":"1ax","externalAdvertiserId":"1ax"},"vidimg3538252527",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_03/Khanyunis_No_Goods_Mar11.mp4.00_00_20_03.Still001-avcmw5.jpg",{"primary":"1b1"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"1az","headline":"1b0","caption":"eh","altText":"eh","url":"1b2","encodingFormat":"eh","height":"eh","width":"eh","date":"1b3","authors":"1b4","source":"eh"},"https://www.nbcnews.com/video/gaza-suffers-food-shortages-as-iran-war-escalates-259187269773","gaza-suffers-food-shortages-as-iran-war-escalates-259187269773",{"canonical":"1b6","primary":"1b6","slug":"1b7"},"PT2M18S","Gaza suffers food shortages as Iran war escalates",{"primary":"1ba","seo":"1ba"},"As the U.S. and Israel’s war with Iran intensifies, Palestinians say the situation in Gaza has worsened despite a ceasefire brokered by President Trump.",{"primary":"1bc"},{"name":"em"},{"name":"fv"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/03/f_tov_lon_gaza_shortage_260312_0908.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/03/f_tov_lon_gaza_shortage_260312_0908.vtt",{"srt":"1bg","webvtt":"1bh"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/f_tov_lon_gaza_shortage_260312/1/abs/index.m3u8",138,4515000,{"assetType":"gy","format":"gz","publicUrl":"1bj","height":"h1","width":"h2","assetDuration":"1bk","bitrate":"1bl"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/03/f_tov_lon_gaza_shortage_260312_0909_4500.mp4",4515955,{"assetType":"h6","format":"h7","publicUrl":"1bn","height":"h1","width":"h2","assetDuration":"1bk","bitrate":"1bo"},["1bm","1bp"],{"type":"gb","id":"1av","mpxMetadata":"1ay","primaryImage":"1b5","url":"1b8","duration":"1b9","sentiment":"l3","videoType":"gl","headline":"1bb","description":"1bd","publisher":"1be","source":"1bf","closedCaptioning":"1bi","videoAssets":"1bq"},["184","191","19x","1au","1br"],{"headline":"176","videos":"1bs"},{"id":"15z","type":"gb","duration":"160","dateBroadcast":"161","date":"164","liveVideoStatus":"gg","playable":"e7","mpxMetadata":"167","sentiment":"l3","videoType":"168","contentRules":"16a","headline":"16c","description":"16e","url":"16h","closedCaptioning":"16k","videoAssets":"16s","primaryImage":"16z","teaseImage":"174","associatedVideoPlaylist":"1bt"},{"type":"g9","video":"1bu"},"Israeli officials notified the U.S. that it planned to begin a ground incursion into Lebanon that would be limited in scope, scale and duration, and two U.S. officials told NBC News that the operation appears to have begun. ",{"type":"eb","element":"ec","html":"1bw"},"The officials said the U.S. does not have independent confirmation, but the timing tracks with what the Israelis notified the U.S. it had planned.   ",{"type":"eb","element":"ec","html":"1by"},"The officials said the U.S. has not seen any movement of assets or equipment in Iran to indicate that a response from Tehran is imminent, but Iran has been postured to move quickly if it decides to do so. ",{"type":"eb","element":"ec","html":"1c0"},"Iran has signaled to the U.S. that it still does not want a wider war, the officials said.",{"type":"eb","element":"ec","html":"1c2"},["1bv","1bx","1bz","1c1","1c3"],["1bw","1by","1c0","1c2"],{"markupAndEmbeds":"1c4","text":"1c5"},"2024-09-30T22:29:10.832Z","2024-10-01T00:08:43.530Z",{"createdAt":"1c7","publishedAt":"1c7","modifiedAt":"1c8"},"Israeli officials notified the U.S. that it planned to begin a ground incursion into Lebanon that would be limited in scope, scale and duration, and two U.S.",{"primary":"1ca","seo":"1ca"},"Israel's ground incursion into Lebanon appears to have begun, U.S. officials say ",{"primary":"1cc","seo":"1cc","social":"1cc"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57546",{"primary":"1cf"},[],{"markupAndEmbeds":"1ch"},[],{"markupAndEmbeds":"1cj"},[],{"markupAndEmbeds":"1cl"},{"analysis":"1ci","citations":"1ck","verdict":"1cm"},[],{"nativeAd":"e2","id":"14s","authors":"15y","isHeadlineHidden":"e2","content":"1c6","date":"1c9","description":"1cb","headline":"1cd","presentation":"1ce","primaryImage":"eh","teaseImage":"eh","url":"1cg","reportingFrom":"eh","factCheckContent":"1cn","replies":"1co"},"rcrd57540",{"type":"eb","element":"ec","html":"x3"},["1cr"],["x9"],{"primary":"xd"},{"altText":"xc","height":"p3","url":"1cu","width":"p3"},{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"xh","pinterest":"eh","snapchat":"eh","twitter":"xi","youtube":"xj"},{"canonical":"xl","primary":"xl","slug":"xm"},{"type":"eb","element":"ec","html":"xo"},["1cz"],[],{"type":"eb","element":"ec","html":"xs"},{"type":"eb","element":"ec","html":"xu"},["1d2","1d3"],{"bio":"1cs","liveBlogShortBio":"eg","shortBio":"x6","id":"x7","email":"x8","jobTitle":"1ct","name":"xb","primaryImage":"1cv","publisher":"1cw","socialMediaProfiles":"1cx","subType":"eh","type":"eq","url":"1cy","worksFor":"eh","experience":"1d0","educationAndExpertise":"1d1","awards":"1d4"},["1d5"],"The U.K. urged its citizens in Lebanon to leave amid Israel's attacks on Iran-backed Hezbollah forces there.",{"type":"eb","element":"ec","html":"1d7"},"\"The situation in Lebanon is volatile and has potential to deteriorate quickly,\" Foreign Secretary David Lammy said in a statement today. \"It is vital that you leave now, as further evacuation may not be guaranteed.” ",{"type":"eb","element":"ec","html":"1d9"},"The government has chartered a flight to help British nationals, partners and dependents who want to leave Lebanon, the U.K.’s Foreign, Commonwealth, and Development Office said.",{"type":"eb","element":"ec","html":"1db"},"The flight was scheduled to depart Beirut-Rafic Hariri International Airport on Wednesday, with more flights possible, the office said in a statement.",{"type":"eb","element":"ec","html":"1dd"},"The government earlier moved to increase capacity on commercial flights so citizens could leave amid the attacks.",{"type":"eb","element":"ec","html":"1df"},"The U.K. government, which has sent troops to the region, has called for a cease-fire, as has President Joe Biden.",{"type":"eb","element":"ec","html":"1dh"},"br",{"type":"eb","element":"1dj","html":"eh"},["1d8","1da","1dc","1de","1dg","1di","1dk"],["1d7","1d9","1db","1dd","1df","1dh"],{"markupAndEmbeds":"1dl","text":"1dm"},"2024-09-30T22:12:04.689Z","2024-10-01T00:09:37.419Z",{"createdAt":"1do","publishedAt":"1do","modifiedAt":"1dp"},"The U.K. urged its citizens in Lebanon to leave amid Israel's attacks on Iran-backed Hezbollah forces there. \"The situation in Lebanon is volatile and has",{"primary":"1dr","seo":"1dr"},"U.K. to citizens in Lebanon: It is vital that you leave now",{"primary":"1dt","seo":"1dt","social":"1dt"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57540",{"primary":"1dw"},[],{"markupAndEmbeds":"1dy"},[],{"markupAndEmbeds":"1e0"},[],{"markupAndEmbeds":"1e2"},{"analysis":"1dz","citations":"1e1","verdict":"1e3"},[],{"nativeAd":"e2","id":"1cq","authors":"1d6","isHeadlineHidden":"e2","content":"1dn","date":"1dq","description":"1ds","headline":"1du","presentation":"1dv","primaryImage":"eh","teaseImage":"eh","url":"1dx","reportingFrom":"eh","factCheckContent":"1e4","replies":"1e5"},"rcrd57536","Reuters",{"type":"eb","element":"ec","html":"1e8"},["1e9"],"ncpn6556",[],1000,"https://media-cldnry.s-nbcnews.com/image/upload/newscms/2024_21/3649017/reuters-live-blog-byline-image_1.png",{"primary":"1ee"},{"altText":"eh","height":"1ed","url":"1ef","width":"1ed"},{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"eh","youtube":"eh"},[],[],[],{"bio":"1ea","liveBlogShortBio":"eg","shortBio":"eh","id":"1eb","email":"eh","jobTitle":"1ec","name":"1e8","primaryImage":"1eg","publisher":"1eh","socialMediaProfiles":"1ei","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"1ej","educationAndExpertise":"1ek","awards":"1el"},["1em"],"At least 95 people were killed and 172 were wounded in Israeli strikes on Lebanon’s southern regions, the eastern Bekaa Valley and Beirut in the past 24 hours, Lebanon’s health ministry said just after midnight in Lebanon. ",{"type":"eb","element":"ec","html":"1eo"},"The vast majority were killed in the south, with 23 killed in the east and four in Beirut.",{"type":"eb","element":"ec","html":"1eq"},"According to Lebanese government daily figures, 1,745 people have been killed and 8,767 have been wounded since cross-border fighting began nearly a year ago.",{"type":"eb","element":"ec","html":"1es"},["1ep","1er","1et"],["1eo","1eq","1es"],{"markupAndEmbeds":"1eu","text":"1ev"},"2024-09-30T21:39:44.052Z","2024-10-01T00:10:07.459Z",{"createdAt":"1ex","publishedAt":"1ex","modifiedAt":"1ey"},"At least 95 people were killed and 172 were wounded in Israeli strikes on Lebanon’s southern regions, the eastern Bekaa Valley and Beirut in the past 24 hours,",{"primary":"1f0","seo":"1f0"},"Nearly 100 killed in strikes in Lebanon in 24 hours, health officials say",{"primary":"1f2","seo":"1f2","social":"1f2"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57536",{"primary":"1f5"},[],{"markupAndEmbeds":"1f7"},[],{"markupAndEmbeds":"1f9"},[],{"markupAndEmbeds":"1fb"},{"analysis":"1f8","citations":"1fa","verdict":"1fc"},[],{"nativeAd":"e2","id":"1e7","authors":"1en","isHeadlineHidden":"e2","content":"1ew","date":"1ez","description":"1f1","headline":"1f3","presentation":"1f4","primaryImage":"eh","teaseImage":"eh","url":"1f6","reportingFrom":"eh","factCheckContent":"1fd","replies":"1fe"},"rcrd57538",{"type":"eb","element":"ec","html":"1e8"},["1fh"],[],{"primary":"1ee"},{"altText":"eh","height":"1ed","url":"1fk","width":"1ed"},{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"eh","youtube":"eh"},[],[],[],{"bio":"1fi","liveBlogShortBio":"eg","shortBio":"eh","id":"1eb","email":"eh","jobTitle":"1fj","name":"1e8","primaryImage":"1fl","publisher":"1fm","socialMediaProfiles":"1fn","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"1fo","educationAndExpertise":"1fp","awards":"1fq"},["1fr"],"Huge consecutive blasts were heard across the Lebanese capital just after midnight local time, Reuters witnesses said, as the Israeli military carried out strikes on the city’s southern suburbs.",{"type":"eb","element":"ec","html":"1ft"},"A massive smoke cloud could be seen in a Reuters live broadcast.",{"type":"eb","element":"ec","html":"1fv"},"The Israeli military had warned an hour earlier that it would strike specific buildings in the typically densely populated southern suburbs, saying Hezbollah was using them and telling residents to leave.",{"type":"eb","element":"ec","html":"1fx"},"Many residents had fled in recent days after a spike in Israeli strikes but ended up sleeping in the streets of the city as shelters were full.",{"type":"eb","element":"ec","html":"1fz"},"Families told Reuters they had struggled to find taxis to get them out of the district fast enough.",{"type":"eb","element":"ec","html":"1g1"},["1fu","1fw","1fy","1g0","1g2"],["1ft","1fv","1fx","1fz","1g1"],{"markupAndEmbeds":"1g3","text":"1g4"},"2024-09-30T21:32:29.919Z","2024-10-01T00:10:36.985Z",{"createdAt":"1g6","publishedAt":"1g6","modifiedAt":"1g7"},"Huge consecutive blasts were heard across the Lebanese capital just after midnight local time, Reuters witnesses said, as the Israeli military carried out",{"primary":"1g9","seo":"1g9"},"Large blasts sound in southern Beirut from Israeli strike  ",{"primary":"1gb","seo":"1gb","social":"1gb"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57538",{"primary":"1ge"},[],{"markupAndEmbeds":"1gg"},[],{"markupAndEmbeds":"1gi"},[],{"markupAndEmbeds":"1gk"},{"analysis":"1gh","citations":"1gj","verdict":"1gl"},[],{"nativeAd":"e2","id":"1fg","authors":"1fs","isHeadlineHidden":"e2","content":"1g5","date":"1g8","description":"1ga","headline":"1gc","presentation":"1gd","primaryImage":"eh","teaseImage":"eh","url":"1gf","reportingFrom":"eh","factCheckContent":"1gm","replies":"1gn"},"rcrd57527","Matt Nighswander is a Senior Photo Editor at NBC News Digital.",{"type":"eb","element":"ec","html":"1gq"},["1gr"],"ncpn674616",[],"Matt Nighswander","Image: Matt Nighswander","https://media-cldnry.s-nbcnews.com/image/upload/newscms/2019_28/2925631/190619-matt_nighswander-byline2590.jpg",{"primary":"1gx"},{"altText":"1gw","height":"p3","url":"1gy","width":"p3"},{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"eh","youtube":"eh"},[],[],[],{"bio":"1gs","liveBlogShortBio":"eg","shortBio":"eh","id":"1gt","email":"eh","jobTitle":"1gu","name":"1gv","primaryImage":"1gz","publisher":"1h0","socialMediaProfiles":"1h1","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"1h2","educationAndExpertise":"1h3","awards":"1h4"},["1h5"],"embeddedImage","rcim317247",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"Families sleep on Beirut's corniche after fleeing the Israeli airstrikes in Beirut's southern suburbs on Sept. 30, 2024.","https://media-cldnry.s-nbcnews.com/image/upload/rockcms/2024-09/240931-lebanon-beirut-mn-1620-17ea22.jpg",{"primary":"1hb"},"image/jpeg",1667,2500,"2024-09-30T20:20:58.841Z",{"publishedAt":"1hg","createdAt":"1hg","modifiedAt":"1hg"},"Hassan Ammar",{"name":"1hi"},["1hj"],"AP",{"name":"1hl"},{"id":"1h8","headline":"1h9","caption":"eg","altText":"1ha","url":"1hc","encodingFormat":"1hd","height":"1he","width":"1hf","date":"1hh","authors":"1hk","source":"1hm"},{"type":"1h7","image":"1hn"},"Families sleep on Beirut's corniche, a seaside promenade, after fleeing the Israeli airstrikes in the city's southern suburbs.",{"type":"eb","element":"ec","html":"1hp"},["1ho","1hq"],["1hp"],{"markupAndEmbeds":"1hr","text":"1hs"},"2024-09-30T20:53:39.016Z","2024-09-30T20:57:51.458Z",{"createdAt":"1hu","publishedAt":"1hu","modifiedAt":"1hv"},{"primary":"1hp","seo":"1hp"},"Families take shelter by seaside in Beirut",{"primary":"1hy","seo":"1hy","social":"1hy"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57527",{"primary":"1i1"},[],{"markupAndEmbeds":"1i3"},[],{"markupAndEmbeds":"1i5"},[],{"markupAndEmbeds":"1i7"},{"analysis":"1i4","citations":"1i6","verdict":"1i8"},[],{"nativeAd":"e2","id":"1gp","authors":"1h6","isHeadlineHidden":"e2","content":"1ht","date":"1hw","description":"1hx","headline":"1hz","presentation":"1i0","primaryImage":"eh","teaseImage":"eh","url":"1i2","reportingFrom":"eh","factCheckContent":"1i9","replies":"1ia"},"rcrd57526",{"type":"eb","element":"ec","html":"fv"},["1id"],[],{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"g1","instagram":"em","pinterest":"eh","snapchat":"eh","twitter":"g2","youtube":"eh"},[],[],[],{"bio":"1ie","liveBlogShortBio":"eg","shortBio":"eh","id":"fy","email":"eh","jobTitle":"1if","name":"fv","primaryImage":"eh","publisher":"1ig","socialMediaProfiles":"1ih","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"1ii","educationAndExpertise":"1ij","awards":"1ik"},["1il"],"The Israel Defense Forces ordered the immediate evacuations of civilians from their homes in parts of southern Beirut.",{"type":"eb","element":"ec","html":"1in"},"The military shared pictures indicating particular buildings in the suburbs of Laylaki, Haret Hreik and Burj Al-Barajneh and ordered residents to leave.",{"type":"eb","element":"ec","html":"1ip"},"embeddedWidget","ncwd999999","widget","IFRAMELY_EXTERNAL_EMBED","https://x.com/AvichayAdraee/status/1840842963481440618","#عاجل ‼️ انذار عاجل إلى سكان الضاحية الجنوبية في بيروت إلى جميع المتواجدين في المباني المحددة في الخرائط المحددة والمباني المجاورة لها في الأحياء التالية: ⭕️الليلكي ⭕️حارة حريك ⭕️برج البراجنة أنتم متواجدون بالقرب من مصالح ومنشآت تابعة لحزب الله الإرهابي ولذلك سوف يعمل جيش… pic.twitter.com/N60UKlRxmV— افيخاي ادرعي (@AvichayAdraee) September 30, 2024\n\n\n","افيخاي ادرعي on Twitter / X","<amp-iframe src=\"https://iframe.nbcnews.com/9bW3lVF?_showcaption=true&amp=1\" width=\"400\" height=\"400\" frameborder=\"0\" allowfullscreen layout=\"responsive\" resizable sandbox=\"allow-scripts allow-same-origin allow-popups allow-forms allow-top-navigation-by-user-activation\"><amp-img layout=\"fill\" src=\"https://iframe.nbcnews.com/amp169/thumbnail\" placeholder></amp-img><button overflow>Read more</button></amp-iframe>","<div class=\"iframely-twitter iframely-app iframely-embed\" style=\"max-width: 550px;\"><div class=\"iframely-responsive\" style=\"padding-bottom: 100%;\"><iframe src=\"//iframe.nbcnews.com/9bW3lVF?_showcaption=true&app=1\" allowfullscreen></iframe></div></div>","9bW3lVF","Twitter","CENTER","MEDIUM",{"canonical-url":"1iv","description":"1iw","headline":"1ix","iframely-embed-amp-html":"1iy","iframely-embed-html":"1iz","iframely-embed-id":"1j0","iframely-embed-site":"1j1","presentation-alignment":"1j2","presentation-size":"1j3"},{"name":"em"},{"id":"1is","type":"1it","name":"1iu","properties":"1j4","publisher":"1j5"},{"type":"1ir","widget":"1j6"},"\"You are located near interests and facilities belonging to the terrorist Hezbollah, and therefore the IDF will act against them forcefully,\" IDF spokesperson Avichay Adraee said on X. \"For your safety and the safety of your family, you must evacuate the buildings immediately, starting at a distance of no less than 500 meters.\"",{"type":"eb","element":"ec","html":"1j8"},["1io","1iq","1j7","1j9"],["1in","1ip","1j8"],{"markupAndEmbeds":"1ja","text":"1jb"},"2024-09-30T20:25:47.880Z",{"createdAt":"1jd","publishedAt":"1jd","modifiedAt":"1jd"},{"primary":"1in","seo":"1in"},"IDF orders immediate evacuations of civilians in southern Beirut",{"primary":"1jg","seo":"1jg","social":"1jg"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57526",{"primary":"1jj"},[],{"markupAndEmbeds":"1jl"},[],{"markupAndEmbeds":"1jn"},[],{"markupAndEmbeds":"1jp"},{"analysis":"1jm","citations":"1jo","verdict":"1jq"},[],{"nativeAd":"e2","id":"1ic","authors":"1im","isHeadlineHidden":"e2","content":"1jc","date":"1je","description":"1jf","headline":"1jh","presentation":"1ji","primaryImage":"eh","teaseImage":"eh","url":"1jk","reportingFrom":"eh","factCheckContent":"1jr","replies":"1js"},"rcrd57517","Camille Behnke is duty producer for NBC News based in London.",{"type":"eb","element":"ec","html":"1jv"},["1jw"],"ncpn1306920",[],"Camille Behnke",1307,"https://media-cldnry.s-nbcnews.com/image/upload/newscms/2026_05/3718042/250128_1x1_nbc_headshots_cammie_behnke_5722.jpg",{"primary":"1k2"},{"altText":"eh","height":"1k1","url":"1k3","width":"1k1"},{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"eh","youtube":"eh"},[],[],[],{"bio":"1jx","liveBlogShortBio":"eg","shortBio":"eh","id":"1jy","email":"eh","jobTitle":"1jz","name":"1k0","primaryImage":"1k4","publisher":"1k5","socialMediaProfiles":"1k6","subType":"eh","type":"eq","url":"eh","worksFor":"eh","experience":"1k7","educationAndExpertise":"1k8","awards":"1k9"},{"type":"eb","element":"ec","html":"ot"},["1kb"],["oz"],{"primary":"p4"},{"altText":"p2","height":"p3","url":"1ke","width":"p3"},{"name":"em","subType":"eh","type":"en"},{"email":"eh","facebook":"eh","instagram":"p8","pinterest":"eh","snapchat":"eh","twitter":"p8","youtube":"eh"},{"canonical":"pa","primary":"pa","slug":"pb"},{"type":"eb","element":"ec","html":"pd"},["1kj"],[],{"type":"eb","element":"ec","html":"ph"},["1km"],{"bio":"1kc","liveBlogShortBio":"eg","shortBio":"ow","id":"ox","email":"oy","jobTitle":"1kd","name":"p1","primaryImage":"1kf","publisher":"1kg","socialMediaProfiles":"1kh","subType":"eh","type":"eq","url":"1ki","worksFor":"eh","experience":"1kk","educationAndExpertise":"1kl","awards":"1kn"},["1ka","1ko"],"Lebanese civilians fleeing Israeli airstrikes in southern Lebanon took refuge in a parking lot in the coastal town of Sidon.",{"type":"eb","element":"ec","html":"1kq"},"mmvo220457029566","PT43S","Mon Sep 30 2024 18:44:59 GMT+0000 (UTC)","2024-09-30T17:27:28.000Z","2024-09-30T17:27:27.000Z",{"publishedAt":"1kv","createdAt":"1kw"},"220457029566","f_tov_lon_sidon_displaced_240930",{"id":"1ky","guid":"1kz","externalAdvertiserId":"1kz"},[],{"contentClassifications":"1l1"},"Displaced people fleeing southern Lebanon take shelter in parking lot",{"primary":"eg","seo":"1l3"},"Displaced people fleeing Israeli airstrikes in southern Lebanon have taken refuge in a parking lot in the coastal town of Sidon. Lebanon's prime minister said as many as one million people have been displaced by escalating tensions between Israel and Hezbollah.",{"primary":"1l5"},"https://www.nbcnews.com/video/displaced-people-fleeing-southern-lebanon-take-shelter-in-parking-lot-220457029566","displaced-people-fleeing-southern-lebanon-take-shelter-in-parking-lot-220457029566",{"canonical":"1l7","primary":"1l7","slug":"1l8"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2024/09/f_tov_lon_sidon_displaced_240930_0129.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2024/09/f_tov_lon_sidon_displaced_240930_0129.vtt",{"srt":"1la","webvtt":"1lb"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/f_tov_lon_sidon_displaced_240930/1/abs/index.m3u8",43,{"assetType":"gy","format":"gz","publicUrl":"1ld","height":"h1","width":"h2","assetDuration":"1le","bitrate":"md"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2024/09/f_tov_lon_sidon_displaced_240930_0130_4500.mp4",4509429,{"assetType":"h6","format":"h7","publicUrl":"1lg","height":"h1","width":"h2","assetDuration":"1le","bitrate":"1lh"},["1lf","1li"],"vidimg3327619923",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2024_09/