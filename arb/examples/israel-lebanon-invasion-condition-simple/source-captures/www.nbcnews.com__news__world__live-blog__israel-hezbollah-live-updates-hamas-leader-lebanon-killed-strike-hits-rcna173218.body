bel="Share via Email" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-C0GiLlW_.js#s_KE0wDxvLlrA" q:id="3n"><!--qv q:id=3o q:key=dJkd:GH_11--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="3p"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#email" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li></ul></div></div><!--qv q:key=GH_13--><button aria-label="play video" class="_clickToPlayButton_1calw_254 flex-center" on:click="q--_M_9sWK.js#s_fXS03dk2qiE[0 1 2 3 4 5]" q:id="3q"><div class="_playIconContainer_1calw_20 flex-center"><!--qv q:id=3r q:key=dJkd:GH_12--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" q:key="YD_0" q:id="3s"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#play" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></div></button><!--/qv--><!--qv q:id=3t q:key=HvIT:GH_15--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 _posterFrame_1calw_282 mb-0" q:key="hI_2"><picture class="block" q:id="3u"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_630/mpx/2704722219/2024_09/blinken-nldcnl.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_315/mpx/2704722219/2024_09/blinken-nldcnl.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_878/mpx/2704722219/2024_09/blinken-nldcnl.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_439/mpx/2704722219/2024_09/blinken-nldcnl.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_780,h_439/mpx/2704722219/2024_09/blinken-nldcnl.jpg" width="780" height="439" loading="lazy" fetchPriority="low" alt="Blinken reacts to Hezbollah leaders death, says world is ‘safer without him’" class="block" q:id="3v"></picture></figure><!--/qv--></div><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=2v q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57551--><!--qv q:id=3w q:key=5MJu:card-rcrd57551--><!--qv q:key=r0_14--><div id="rcrd57551" data-pubat="2024-09-30T23:06:49.163Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="3x"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 7:06 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=3y-->Israel says it has begun &#39;limited, localized and targeted&#39; ground incursion<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=3z q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/dennis-romero-ncpn856406" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="40"><!--qv q:s q:sref=3z q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=3w q:key=--><!--qv q:id=41 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=42 q:key=5auE:mmvo220489285790--><!--qv q:id=43 q:key=q9JX:Rz_2--><!--qv q:id=45 q:key=C4ZI:Bn_0--><div data-testid="jwplayer-with-overlay" class="_jwPlayerWithOverlayContainer_1calw_2 grid-stack-container jwplayerEmbed mb-10 mt-4 feedBody" on-document:qinit="q-B6-FC0L-.js#_hW[0]" on-document:auth-update="q-B6-FC0L-.js#s_4eLncuS6TBY[1]" on-document:qidle="q--_M_9sWK.js#_hW[2]" q:key="GH_17" q:id="46"><div class="_overlay_1calw_48"><div class="_overlayBackgroundGradient_1calw_217 _fadeOutWithControls_1calw_224"></div><div class="_overlayMeta_1calw_104"><div class="_title_1calw_114 _fadeOutWithControls_1calw_224" q:key="GH_5"><!--qv q:id=47 q:key=7CbQ:GH_4--><a href="https://www.nbcnews.com/nightly-news/video/israel-appears-to-have-begun-a-limited-ground-incursion-in-lebanon-u-s-officials-say-220489285790" target="_self" data-testid="link-if" class="_titleLink_1calw_115" q:id="48"><!--qv q:s q:sref=47 q:key=--><!--t=49-->Israel appears to have begun a limited ground incursion in Lebanon, U.S. officials say<!----><!--/qv--></a><!--/qv--></div><div class="_timestamp_1calw_135 _fadeOutWithControls_1calw_224" q:key="GH_6"><!--t=4a-->02:06<!----></div></div><div class="_shareContainer_1calw_140 _fadeOutWithControls_1calw_224"><button id="jwplayer-l5biiz-C4ZIm9X4sDY-44-share-options-button" aria-controls="jwplayer-l5biiz-C4ZIm9X4sDY-44-share-options" aria-expanded="false" aria-label="More options" aria-haspopup="menu" class="_threeDotsButton_1calw_145" on:click="q--_M_9sWK.js#s_Et0810rY3jo[0 1]" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="4b"><div class="_threeDotsIcon_1calw_159" q:key="GH_7"></div></button><ul id="jwplayer-l5biiz-C4ZIm9X4sDY-44-share-options" aria-labelledby="jwplayer-l5biiz-C4ZIm9X4sDY-44-share-options-button" role="menu" aria-hidden="true" class="_shareButtons_1calw_182" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="4c"><li role="none"><a href="https://www.facebook.com/sharer/sharer.php?u=https://www.nbcnews.com/nightly-news/video/israel-appears-to-have-begun-a-limited-ground-incursion-in-lebanon-u-s-officials-say-220489285790" role="menuitem" aria-label="Share on Facebook" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-CL3qfk7x.js#s_0C0xTPxyHBQ" q:id="4d"><!--qv q:id=4e q:key=dJkd:GH_9--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="4f"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#facebook" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="https://x.com/intent/post?text=Israel%20appears%20to%20have%20begun%20a%20limited%20ground%20incursion%20in%20Lebanon%2C%20U.S.%20officials%20say&amp;url=https://www.nbcnews.com/nightly-news/video/israel-appears-to-have-begun-a-limited-ground-incursion-in-lebanon-u-s-officials-say-220489285790&amp;original_referer=https://www.nbcnews.com/nightly-news/video/israel-appears-to-have-begun-a-limited-ground-incursion-in-lebanon-u-s-officials-say-220489285790" role="menuitem" aria-label="Share on X (Twitter)" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-JtsO08fV.js#s_h6hvWqYCELA" q:id="4g"><!--qv q:id=4h q:key=dJkd:GH_10--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="4i"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#x" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="mailto:?subject=Israel appears to have begun a limited ground incursion in Lebanon, U.S. officials say&amp;body=https://www.nbcnews.com/nightly-news/video/israel-appears-to-have-begun-a-limited-ground-incursion-in-lebanon-u-s-officials-say-220489285790" role="menuitem" aria-label="Share via Email" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-C0GiLlW_.js#s_KE0wDxvLlrA" q:id="4j"><!--qv q:id=4k q:key=dJkd:GH_11--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="4l"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#email" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li></ul></div></div><!--qv q:key=GH_13--><button aria-label="play video" class="_clickToPlayButton_1calw_254 flex-center" on:click="q--_M_9sWK.js#s_fXS03dk2qiE[0 1 2 3 4 5]" q:id="4m"><div class="_playIconContainer_1calw_20 flex-center"><!--qv q:id=4n q:key=dJkd:GH_12--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" q:key="YD_0" q:id="4o"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#play" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></div></button><!--/qv--><!--qv q:id=4p q:key=HvIT:GH_15--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 _posterFrame_1calw_282 mb-0" q:key="hI_2"><picture class="block" q:id="4q"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_630/mpx/2704722219/2024_09/1727738498162_nn_ren_Israel_Lebanon_240930_1920x1080-jng383.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_315/mpx/2704722219/2024_09/1727738498162_nn_ren_Israel_Lebanon_240930_1920x1080-jng383.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_878/mpx/2704722219/2024_09/1727738498162_nn_ren_Israel_Lebanon_240930_1920x1080-jng383.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_439/mpx/2704722219/2024_09/1727738498162_nn_ren_Israel_Lebanon_240930_1920x1080-jng383.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_780,h_439/mpx/2704722219/2024_09/1727738498162_nn_ren_Israel_Lebanon_240930_1920x1080-jng383.jpg" width="780" height="439" loading="lazy" fetchPriority="low" alt="Israel appears to have begun a limited ground incursion in Lebanon, U.S. officials say" class="block" q:id="4r"></picture></figure><!--/qv--></div><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=4s q:key=5auE:Israe1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=4s q:key=--><!--/qv--><!--qv q:id=4t q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="4u">Israel Defense Forces troops have begun a ground incursion into Lebanon, Israel said, adding that the operation will be limited in scope.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=4v q:key=5auE:"Afew2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=4v q:key=--><!--/qv--><!--qv q:id=4w q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="4x">"A few hours ago, the IDF began limited, localized, and targeted ground raids based on precise intelligence against Hezbollah terrorist targets and infrastructure in southern Lebanon," the IDF said in a statement.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=4y q:key=5auE:Thede3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=4y q:key=--><!--/qv--><!--qv q:id=4z q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="50">The declaration of a limited mission comes amid fear of a full-on regional war. Hezbollah militants, who energized their attacks on Israel after Hamas militants' Oct. 7 terrorist attack on the country, are backed by Iran.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=51 q:key=5auE:TheID4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=51 q:key=--><!--/qv--><!--qv q:id=52 q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="53">The IDF said the incursion is meant to protect Israeli citizens who live along the border with Lebanon.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=54 q:key=5auE:<ahre5--><!--qv q:key=Rz_1--><!--qv q:s q:sref=54 q:key=--><!--/qv--><!--qv q:id=55 q:key=JbNX:markupp5--><p class="feedBody" q:key="Il_0" q:id="56"><a href="https://www.nbcnews.com/news/world/israel-lebanon-ground-invasion-rcna172913" target="_blank"><strong><em>Read the full story here. </em></strong></a></p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=3w q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57546--><!--qv q:id=57 q:key=5MJu:card-rcrd57546--><!--qv q:key=r0_14--><div id="rcrd57546" data-pubat="2024-09-30T22:29:10.832Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="58"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 6:29 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=59-->Israel&#39;s ground incursion into Lebanon appears to have begun, U.S. officials say <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=5a q:key=7CbQ:r0_7--><!--qv q:s q:sref=5a q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=57 q:key=--><!--qv q:id=5b q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=5c q:key=5auE:mmvo220485701804--><!--qv q:id=5d q:key=q9JX:Rz_2--><!--qv q:id=5f q:key=C4ZI:Bn_0--><div data-testid="jwplayer-with-overlay" class="_jwPlayerWithOverlayContainer_1calw_2 grid-stack-container jwplayerEmbed mb-10 mt-4 feedBody" on-document:qinit="q-B6-FC0L-.js#_hW[0]" on-document:auth-update="q-B6-FC0L-.js#s_4eLncuS6TBY[1]" on-document:qidle="q--_M_9sWK.js#_hW[2]" q:key="GH_17" q:id="5g"><div class="_overlay_1calw_48"><div class="_overlayBackgroundGradient_1calw_217 _fadeOutWithControls_1calw_224"></div><div class="_overlayMeta_1calw_104"><div class="_timestamp_1calw_135 _fadeOutWithControls_1calw_224" q:key="GH_6"><!--t=5h-->02:29<!----></div></div><div class="_shareContainer_1calw_140 _fadeOutWithControls_1calw_224"><button id="jwplayer-l5biiz-C4ZIm9X4sDY-5e-share-options-button" aria-controls="jwplayer-l5biiz-C4ZIm9X4sDY-5e-share-options" aria-expanded="false" aria-label="More options" aria-haspopup="menu" class="_threeDotsButton_1calw_145" on:click="q--_M_9sWK.js#s_Et0810rY3jo[0 1]" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="5i"><div class="_threeDotsIcon_1calw_159" q:key="GH_7"></div></button><ul id="jwplayer-l5biiz-C4ZIm9X4sDY-5e-share-options" aria-labelledby="jwplayer-l5biiz-C4ZIm9X4sDY-5e-share-options-button" role="menu" aria-hidden="true" class="_shareButtons_1calw_182" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="5j"><li role="none"><a href="https://www.facebook.com/sharer/sharer.php?u=https://www.nbcnews.com/now/video/israel-incursion-in-lebanon-has-begun-officials-say-220485701804" role="menuitem" aria-label="Share on Facebook" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-CL3qfk7x.js#s_0C0xTPxyHBQ" q:id="5k"><!--qv q:id=5l q:key=dJkd:GH_9--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="5m"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#facebook" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="https://x.com/intent/post?text=&amp;url=https://www.nbcnews.com/now/video/israel-incursion-in-lebanon-has-begun-officials-say-220485701804&amp;original_referer=https://www.nbcnews.com/now/video/israel-incursion-in-lebanon-has-begun-officials-say-220485701804" role="menuitem" aria-label="Share on X (Twitter)" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-JtsO08fV.js#s_h6hvWqYCELA" q:id="5n"><!--qv q:id=5o q:key=dJkd:GH_10--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="5p"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#x" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="mailto:?subject=&amp;body=https://www.nbcnews.com/now/video/israel-incursion-in-lebanon-has-begun-officials-say-220485701804" role="menuitem" aria-label="Share via Email" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-C0GiLlW_.js#s_KE0wDxvLlrA" q:id="5q"><!--qv q:id=5r q:key=dJkd:GH_11--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="5s"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#email" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li></ul></div></div><!--qv q:key=GH_13--><button aria-label="play video" class="_clickToPlayButton_1calw_254 flex-center" on:click="q--_M_9sWK.js#s_fXS03dk2qiE[0 1 2 3 4 5]" q:id="5t"><div class="_playIconContainer_1calw_20 flex-center"><!--qv q:id=5u q:key=dJkd:GH_12--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" q:key="YD_0" q:id="5v"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#play" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></div></button><!--/qv--><!--qv q:id=5w q:key=HvIT:GH_15--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 _posterFrame_1calw_282 mb-0" q:key="hI_2"><picture class="block" q:id="5x"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_630/mpx/2704722219/2024_09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930_1920x1080-d9o77m.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_315/mpx/2704722219/2024_09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930_1920x1080-d9o77m.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_878/mpx/2704722219/2024_09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930_1920x1080-d9o77m.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_439/mpx/2704722219/2024_09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930_1920x1080-d9o77m.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_780,h_439/mpx/2704722219/2024_09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930_1920x1080-d9o77m.jpg" width="780" height="439" loading="lazy" fetchPriority="low" alt="" class="block" q:id="5y"></picture></figure><!--/qv--></div><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=5z q:key=5auE:Israe1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=5z q:key=--><!--/qv--><!--qv q:id=60 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="61">Israeli officials notified the U.S. that it planned to begin a ground incursion into Lebanon that would be limited in scope, scale and duration, and two U.S. officials told NBC News that the operation appears to have begun. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=62 q:key=5auE:Theof2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=62 q:key=--><!--/qv--><!--qv q:id=63 q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="64">The officials said the U.S. does not have independent confirmation, but the timing tracks with what the Israelis notified the U.S. it had planned.   </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=65 q:key=5auE:Theof3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=65 q:key=--><!--/qv--><!--qv q:id=66 q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="67">The officials said the U.S. has not seen any movement of assets or equipment in Iran to indicate that a response from Tehran is imminent, but Iran has been postured to move quickly if it decides to do so. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=68 q:key=5auE:Iranh4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=68 q:key=--><!--/qv--><!--qv q:id=69 q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="6a">Iran has signaled to the U.S. that it still does not want a wider war, the officials said.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=57 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57540--><!--qv q:id=6b q:key=5MJu:card-rcrd57540--><!--qv q:key=r0_14--><div id="rcrd57540" data-pubat="2024-09-30T22:12:04.689Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="6c"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 6:12 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=6d-->U.K. to citizens in Lebanon: It is vital that you leave now<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=6e q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/dennis-romero-ncpn856406" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="6f"><!--qv q:s q:sref=6e q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=6b q:key=--><!--qv q:id=6g q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=6h q:key=5auE:TheU.0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=6h q:key=--><!--/qv--><!--qv q:id=6i q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="6j">The U.K. urged its citizens in Lebanon to leave amid Israel's attacks on Iran-backed Hezbollah forces there.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=6k q:key=5auE:"Thes1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=6k q:key=--><!--/qv--><!--qv q:id=6l q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="6m">"The situation in Lebanon is volatile and has potential to deteriorate quickly," Foreign Secretary David Lammy said in a statement today. "It is vital that you leave now, as further evacuation may not be guaranteed.” </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=6n q:key=5auE:Thego2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=6n q:key=--><!--/qv--><!--qv q:id=6o q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="6p">The government has chartered a flight to help British nationals, partners and dependents who want to leave Lebanon, the U.K.’s Foreign, Commonwealth, and Development Office said.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=6q q:key=5auE:Thefl3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=6q q:key=--><!--/qv--><!--qv q:id=6r q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="6s">The flight was scheduled to depart Beirut-Rafic Hariri International Airport on Wednesday, with more flights possible, the office said in a statement.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=6t q:key=5auE:Thego4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=6t q:key=--><!--/qv--><!--qv q:id=6u q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="6v">The government earlier moved to increase capacity on commercial flights so citizens could leave amid the attacks.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=6w q:key=5auE:TheU.5--><!--qv q:key=Rz_1--><!--qv q:s q:sref=6w q:key=--><!--/qv--><!--qv q:id=6x q:key=JbNX:markupp5--><p class="feedBody" q:key="Il_0" q:id="6y">The U.K. government, which has sent troops to the region, has called for a cease-fire, as has President Joe Biden.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=6z q:key=5auE:fallback-id-6--><!--qv q:key=Rz_1--><!--qv q:s q:sref=6z q:key=--><!--/qv--><!--qv q:id=70 q:key=JbNX:markupbr6--><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=6b q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57536--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57536"><!--qv q:id=71 q:key=00Of:feed-ad-rcrd57536--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="72"><div id="div-libra-feed-ad-rcrd57536" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=73 q:key=5MJu:card-rcrd57536--><!--qv q:key=r0_14--><div id="rcrd57536" data-pubat="2024-09-30T21:39:44.052Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="74"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 5:39 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=75-->Nearly 100 killed in strikes in Lebanon in 24 hours, health officials say<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=76 q:key=7CbQ:r0_7--><!--qv q:s q:sref=76 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=73 q:key=--><!--qv q:id=77 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=78 q:key=5auE:Atlea0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=78 q:key=--><!--/qv--><!--qv q:id=79 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="7a">At least 95 people were killed and 172 were wounded in Israeli strikes on Lebanon’s southern regions, the eastern Bekaa Valley and Beirut in the past 24 hours, Lebanon’s health ministry said just after midnight in Lebanon. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=7b q:key=5auE:Theva1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=7b q:key=--><!--/qv--><!--qv q:id=7c q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="7d">The vast majority were killed in the south, with 23 killed in the east and four in Beirut.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=7e q:key=5auE:Accor2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=7e q:key=--><!--/qv--><!--qv q:id=7f q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="7g">According to Lebanese government daily figures, 1,745 people have been killed and 8,767 have been wounded since cross-border fighting began nearly a year ago.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=73 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57538--><!--qv q:id=7h q:key=5MJu:card-rcrd57538--><!--qv q:key=r0_14--><div id="rcrd57538" data-pubat="2024-09-30T21:32:29.919Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="7i"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 5:32 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=7j-->Large blasts sound in southern Beirut from Israeli strike  <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=7k q:key=7CbQ:r0_7--><!--qv q:s q:sref=7k q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=7h q:key=--><!--qv q:id=7l q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=7m q:key=5auE:Hugec0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=7m q:key=--><!--/qv--><!--qv q:id=7n q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="7o">Huge consecutive blasts were heard across the Lebanese capital just after midnight local time, Reuters witnesses said, as the Israeli military carried out strikes on the city’s southern suburbs.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=7p q:key=5auE:Amass1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=7p q:key=--><!--/qv--><!--qv q:id=7q q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="7r">A massive smoke cloud could be seen in a Reuters live broadcast.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=7s q:key=5auE:TheIs2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=7s q:key=--><!--/qv--><!--qv q:id=7t q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="7u">The Israeli military had warned an hour earlier that it would strike specific buildings in the typically densely populated southern suburbs, saying Hezbollah was using them and telling residents to leave.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=7v q:key=5auE:Manyr3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=7v q:key=--><!--/qv--><!--qv q:id=7w q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="7x">Many residents had fled in recent days after a spike in Israeli strikes but ended up sleeping in the streets of the city as shelters were full.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=7y q:key=5auE:Famil4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=7y q:key=--><!--/qv--><!--qv q:id=7z q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="80">Families told Reuters they had struggled to find taxis to get them out of the district fast enough.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=7h q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57527--><!--qv q:id=81 q:key=5MJu:card-rcrd57527--><!--qv q:key=r0_14--><div id="rcrd57527" data-pubat="2024-09-30T20:53:39.016Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="82"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 4:53 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=83-->Families take shelter by seaside in Beirut<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=84 q:key=7CbQ:r0_7--><!--qv q:s q:sref=84 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=81 q:key=--><!--qv q:id=85 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=86 q:key=5auE:rcim317247--><!--qv q:id=87 q:key=HvIT:rcim317247--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block" q:id="88"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240931-lebanon-beirut-mn-1620-17ea22.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240931-lebanon-beirut-mn-1620-17ea22.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240931-lebanon-beirut-mn-1620-17ea22.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240931-lebanon-beirut-mn-1620-17ea22.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1667/rockcms/2024-09/240931-lebanon-beirut-mn-1620-17ea22.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="Families sleep on Beirut&#39;s corniche after fleeing the Israeli airstrikes in Beirut&#39;s southern suburbs on Sept. 30, 2024." class="block" q:id="89"></picture><!--qv q:id=8a q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=8b-->Hassan Ammar / AP<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><!--qv q:id=8c q:key=5auE:Famil1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=8c q:key=--><!--/qv--><!--qv q:id=8d q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="8e">Families sleep on Beirut's corniche, a seaside promenade, after fleeing the Israeli airstrikes in the city's southern suburbs.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=81 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57526--><!--qv q:id=8f q:key=5MJu:card-rcrd57526--><!--qv q:key=r0_14--><div id="rcrd57526" data-pubat="2024-09-30T20:25:47.880Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="8g"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 4:25 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=8h-->IDF orders immediate evacuations of civilians in southern Beirut<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=8i q:key=7CbQ:r0_7--><!--qv q:s q:sref=8i q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=8f q:key=--><!--qv q:id=8j q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=8k q:key=5auE:TheIs0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=8k q:key=--><!--/qv--><!--qv q:id=8l q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="8m">The Israel Defense Forces ordered the immediate evacuations of civilians from their homes in parts of southern Beirut.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=8n q:key=5auE:Themi1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=8n q:key=--><!--/qv--><!--qv q:id=8o q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="8p">The military shared pictures indicating particular buildings in the suburbs of Laylaki, Haret Hreik and Burj Al-Barajneh and ordered residents to leave.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=8q q:key=5auE:ncwd999999--><!--qv q:id=8r q:key=57R8:9bW3lVF--><div data-testid="iframely-embed" class="overflow-hidden mb-4 mx-auto w-full twitter feedBody" on:qvisible="q-B4mwBO5V.js#_hW[0]" q:key="uH_0" q:id="8s"><div class="iframely-twitter iframely-embed" q:id="8t"><div class="iframely-responsive"><iframe src="about:blank" data-testid="iframely-iframe" q:id="8u"></iframe></div></div></div><!--/qv--><!--/qv--><!--qv q:id=8v q:key=5auE:"Youa3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=8v q:key=--><!--/qv--><!--qv q:id=8w q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="8x">"You are located near interests and facilities belonging to the terrorist Hezbollah, and therefore the IDF will act against them forcefully," IDF spokesperson Avichay Adraee said on X. "For your safety and the safety of your family, you must evacuate the buildings immediately, starting at a distance of no less than 500 meters."</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=8f q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57517--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57517"><!--qv q:id=8y q:key=00Of:feed-ad-rcrd57517--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="8z"><div id="div-libra-feed-ad-rcrd57517" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=90 q:key=5MJu:card-rcrd57517--><!--qv q:key=r0_14--><div id="rcrd57517" data-pubat="2024-09-30T20:14:44.870Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="91"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 4:14 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=92-->Displaced people fleeing southern Lebanon take shelter in parking lot <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=93 q:key=7CbQ:r0_7--><!--qv q:s q:sref=93 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=90 q:key=--><!--qv q:id=94 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=95 q:key=5auE:Leban0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=95 q:key=--><!--/qv--><!--qv q:id=96 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="97">Lebanese civilians fleeing Israeli airstrikes in southern Lebanon took refuge in a parking lot in the coastal town of Sidon.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=98 q:key=5auE:mmvo220457029566--><!--qv q:id=99 q:key=q9JX:Rz_2--><!--qv q:id=9b q:key=C4ZI:Bn_0--><div data-testid="jwplayer-with-overlay" class="_jwPlayerWithOverlayContainer_1calw_2 grid-stack-container jwplayerEmbed mb-10 mt-4 feedBody" on-document:qinit="q-B6-FC0L-.js#_hW[0]" on-document:auth-update="q-B6-FC0L-.js#s_4eLncuS6TBY[1]" on-document:qidle="q--_M_9sWK.js#_hW[2]" q:key="GH_17" q:id="9c"><div class="_overlay_1calw_48"><div class="_overlayBackgroundGradient_1calw_217 _fadeOutWithControls_1calw_224"></div><div class="_overlayMeta_1calw_104"><div class="_timestamp_1calw_135 _fadeOutWithControls_1calw_224" q:key="GH_6"><!--t=9d-->00:43<!----></div></div><div class="_shareContainer_1calw_140 _fadeOutWithControls_1calw_224"><button id="jwplayer-l5biiz-C4ZIm9X4sDY-9a-share-options-button" aria-controls="jwplayer-l5biiz-C4ZIm9X4sDY-9a-share-options" aria-expanded="false" aria-label="More options" aria-haspopup="menu" class="_threeDotsButton_1calw_145" on:click="q--_M_9sWK.js#s_Et0810rY3jo[0 1]" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="9e"><div class="_threeDotsIcon_1calw_159" q:key="GH_7"></div></button><ul id="jwplayer-l5biiz-C4ZIm9X4sDY-9a-share-options" aria-labelledby="jwplayer-l5biiz-C4ZIm9X4sDY-9a-share-options-button" role="menu" aria-hidden="true" class="_shareButtons_1calw_182" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="9f"><li role="none"><a href="https://www.facebook.com/sharer/sharer.php?u=https://www.nbcnews.com/video/displaced-people-fleeing-southern-lebanon-take-shelter-in-parking-lot-220457029566" role="menuitem" aria-label="Share on Facebook" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-CL3qfk7x.js#s_0C0xTPxyHBQ" q:id="9g"><!--qv q:id=9h q:key=dJkd:GH_9--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="9i"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#facebook" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="https://x.com/intent/post?text=&amp;url=https://www.nbcnews.com/video/displaced-people-fleeing-southern-lebanon-take-shelter-in-parking-lot-220457029566&amp;original_referer=https://www.nbcnews.com/video/displaced-people-fleeing-southern-lebanon-take-shelter-in-parking-lot-220457029566" role="menuitem" aria-label="Share on X (Twitter)" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-JtsO08fV.js#s_h6hvWqYCELA" q:id="9j"><!--qv q:id=9k q:key=dJkd:GH_10--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="9l"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#x" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="mailto:?subject=&amp;body=https://www.nbcnews.com/video/displaced-people-fleeing-southern-lebanon-take-shelter-in-parking-lot-220457029566" role="menuitem" aria-label="Share via Email" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-C0GiLlW_.js#s_KE0wDxvLlrA" q:id="9m"><!--qv q:id=9n q:key=dJkd:GH_11--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="9o"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#email" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li></ul></div></div><!--qv q:key=GH_13--><button aria-label="play video" class="_clickToPlayButton_1calw_254 flex-center" on:click="q--_M_9sWK.js#s_fXS03dk2qiE[0 1 2 3 4 5]" q:id="9p"><div class="_playIconContainer_1calw_20 flex-center"><!--qv q:id=9q q:key=dJkd:GH_12--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" q:key="YD_0" q:id="9r"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#play" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></div></button><!--/qv--><!--qv q:id=9s q:key=HvIT:GH_15--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 _posterFrame_1calw_282 mb-0" q:key="hI_2"><picture class="block" q:id="9t"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_630/mpx/2704722219/2024_09/f_tov_lon_sidon_displaced_240930-m6oz2m.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_315/mpx/2704722219/2024_09/f_tov_lon_sidon_displaced_240930-m6oz2m.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_878/mpx/2704722219/2024_09/f_tov_lon_sidon_displaced_240930-m6oz2m.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_439/mpx/2704722219/2024_09/f_tov_lon_sidon_displaced_240930-m6oz2m.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_780,h_439/mpx/2704722219/2024_09/f_tov_lon_sidon_displaced_240930-m6oz2m.jpg" width="780" height="439" loading="lazy" fetchPriority="low" alt="" class="block" q:id="9u"></picture></figure><!--/qv--></div><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=9v q:key=5auE:Score2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=9v q:key=--><!--/qv--><!--qv q:id=9w q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="9x">Scores of families could be seen sitting on the floor, with bedding nearby. Drying laundry hung on a fence surrounding the parking lot. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=9y q:key=5auE:"Weha3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=9y q:key=--><!--/qv--><!--qv q:id=9z q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="a0">"We have many needs," a man carrying an infant told an NBC News crew. "The most important one is shelter for the children."</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=a1 q:key=5auE:About4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=a1 q:key=--><!--/qv--><!--qv q:id=a2 q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="a3">About 1 million people have been displaced in Lebanon as a result of the escalating conflict between Israel and Hezbollah, according to Prime Minister Najib Mikati.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=90 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57515--><!--qv q:id=a4 q:key=5MJu:card-rcrd57515--><!--qv q:key=r0_14--><div id="rcrd57515" data-pubat="2024-09-30T19:45:10.266Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="a5"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 3:45 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=a6-->IDF designates &#39;closed military area&#39; in northern Israel ahead of ground operation in Lebanon<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=a7 q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/mirna-alsharif-ncpn1297517" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="a8"><!--qv q:s q:sref=a7 q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=a4 q:key=--><!--qv q:id=a9 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=aa q:key=5auE:TheIs0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=aa q:key=--><!--/qv--><!--qv q:id=ab q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ac">The Israel Defense Forces announced the designation of "a closed military area" in northern Israel ahead of a possible ground operation in Lebanon.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ad q:key=5auE:Thear1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ad q:key=--><!--/qv--><!--qv q:id=ae q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="af">The area consists of the town of Metula and two kibbutzim, Meshgav Am and Kfar Giladi, <a href="https://x.com/idfonline/status/1840808915816022375?s=48&t=tVc4Vo-omv6F2hrEpddh9g" target="_blank">the IDF said on X</a>, adding that entering the area is prohibited.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ag q:key=5auE:Alimi2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ag q:key=--><!--/qv--><!--qv q:id=ah q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="ai">A limited ground operation into Lebanon could begin as early as today, according to a U.S. official, a Biden administration official and a source familiar with the planning.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=aj q:key=5auE:rcim317202--><!--qv q:id=ak q:key=HvIT:rcim317202--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="al"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240930-israel-lebanon-border-tanks-se-311p-7455b2.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-israel-lebanon-border-tanks-se-311p-7455b2.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240930-israel-lebanon-border-tanks-se-311p-7455b2.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240930-israel-lebanon-border-tanks-se-311p-7455b2.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1667/rockcms/2024-09/240930-israel-lebanon-border-tanks-se-311p-7455b2.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="Israeli tanks and APC&#39;s gathered at the border" class="block" q:id="am"></picture><!--qv q:id=an q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=ao-->Israeli tanks by the Israeli-Lebanese border today.<!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=ap-->Erik Marmor / Getty Images<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=a4 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57501--><!--qv q:id=aq q:key=5MJu:card-rcrd57501--><!--qv q:key=r0_14--><div id="rcrd57501" data-pubat="2024-09-30T19:32:42.349Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="ar"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 3:32 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=as-->Lebanese refugees cross into Iraq<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=at q:key=7CbQ:r0_7--><!--qv q:s q:sref=at q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=aq q:key=--><!--qv q:id=au q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=av q:key=5auE:Seven0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=av q:key=--><!--/qv--><!--qv q:id=aw q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ax">Seventeen Lebanese refugees crossed into Iraq via the Al-Qaim border between Syria and Iraq, the Iraqi Red Crescent said today. Among them was a wounded person, it added.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ay q:key=5auE:"TheR1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ay q:key=--><!--/qv--><!--qv q:id=az q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="b0">"The Red Crescent teams received the displaced and provided food services and first aid, especially to the wounded," it said in a statement. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=b1 q:key=5auE:Todat2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=b1 q:key=--><!--/qv--><!--qv q:id=b2 q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="b3">To date, 144 Lebanese refugees have crossed into Iraq through the Al-Qaim border, the statement said. </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=aq q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57480--><!--qv q:id=b4 q:key=5MJu:card-rcrd57480--><!--qv q:key=r0_14--><div id="rcrd57480" data-pubat="2024-09-30T18:50:54.865Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="b5"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 2:50 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=b6-->Lebanese health system overstretched, WHO warns <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=b7 q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/henry-austin-ncpn4346" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="b8"><!--qv q:s q:sref=b7 q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=b4 q:key=--><!--qv q:id=b9 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ba q:key=5auE:Leban0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ba q:key=--><!--/qv--><!--qv q:id=bb q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="bc">Lebanon’s health system remains impacted and overstretched by a new escalation of violence in the country, the World Health Organization said today  in a situation report. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=bd q:key=5auE:Warni1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=bd q:key=--><!--/qv--><!--qv q:id=be q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="bf">Warning that displaced people were at increased risk of diseases, the United Nations agency said that around 118,466 new displacements took place between Sept. 23 and 27.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=bg q:key=5auE:Israe2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=bg q:key=--><!--/qv--><!--qv q:id=bh q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="bi">Israel continues to carry out airstrikes on targets in Beirut and elsewhere in Lebanon.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=b4 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57503--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57503"><!--qv q:id=bj q:key=00Of:feed-ad-rcrd57503--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="bk"><div id="div-libra-feed-ad-rcrd57503" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=bl q:key=5MJu:card-rcrd57503--><!--qv q:key=r0_14--><div id="rcrd57503" data-pubat="2024-09-30T18:25:13.024Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="bm"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 2:25 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=bn-->Israeli ground operation into southern Lebanon could begin today, officials say<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=bo q:key=7CbQ:r0_7--><!--qv q:s q:sref=bo q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=bl q:key=--><!--qv q:id=bp q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=bq q:key=5auE:Israe0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=bq q:key=--><!--/qv--><!--qv q:id=br q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="bs">Israel is planning a limited ground operation into Lebanon that could begin imminently, according to a U.S. official, a Biden administration official and a source familiar with the planning.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=bt q:key=5auE:Israe1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=bt q:key=--><!--/qv--><!--qv q:id=bu q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="bv">Israel informed the U.S. that the incursion into southern Lebanon could begin as early as today and that the intent is to push Hezbollah forces further away from the Israeli border and target their infrastructure, including stockpiles and weapons, the officials explained.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=bw q:key=5auE:Theof2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=bw q:key=--><!--/qv--><!--qv q:id=bx q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="by">The offensive will be limited in duration and scope, possibly beginning as early as tonight and lasting for days, not weeks, they said, adding that the geographical reach will be limited.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=bz q:key=5auE:Israe3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=bz q:key=--><!--/qv--><!--qv q:id=c0 q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="c1">Israel has begun probing operations already, the U.S. official said, including small-scale ground missions with their Special Forces. They have also deployed combat engineers and other troops for missions like breaching. The IDF currently has about five brigades forward deployed but not all of those are expected to move across the border, the official said.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=0Z_2--><div class="showMoreBtnWrapper _showMoreBtnWrapper_hxea4_27 flex relative" q:key="0Z_1"><div data-testid="showmore-fade" class="_showMoreFade_hxea4_30"></div><button type="button" aria-controls="rcrd57503-overflow-content" aria-label="Show more of post Israeli ground operation into southern Lebanon could begin today, officials say" class="_showMoreBtn_hxea4_8 btn relative uppercase block mb-2 ghost-button" on:click="q-BkudQL_O.js#s_J08Rfg6pYLQ[0]" q:id="c2">Show more</button></div><div id="rcrd57503-overflow-content" data-testid="markupembeds-overflow" class="_afterShowMore_hxea4_40" q:id="c3"><!--qv q:id=c4 q:key=5auE:Theof0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=c4 q:key=--><!--/qv--><!--qv q:id=c5 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="c6">The official stressed that the operation is intended to be limited in duration and scope, targeting Hezbollah stockpiles and weapons, including underground facilities.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=c7 q:key=5auE:Israe1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=c7 q:key=--><!--/qv--><!--qv q:id=c8 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="c9">Israel was planning for a larger invasion but after U.S. officials urged them to reconsider during extensive conversations over the weekend, they have decided to scale back, the administration and U.S. officials said.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ca q:key=5auE:Butth2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ca q:key=--><!--/qv--><!--qv q:id=cb q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="cc">But the Biden administration remains concerned the mission could expand, the administration official said, adding that President Joe Biden is still pushing for a cease-fire.</p><!--/qv--><!--/qv--><!--/qv--></div><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=bl q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57486--><!--qv q:id=cd q:key=5MJu:card-rcrd57486--><!--qv q:key=r0_14--><div id="rcrd57486" data-pubat="2024-09-30T18:18:21.411Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="ce"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 2:18 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=cf-->Houthis will respond to port strike &#39;by escalating military operations&#39;<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=cg q:key=7CbQ:r0_7--><!--qv q:s q:sref=cg q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=cd q:key=--><!--qv q:id=ch q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ci q:key=5auE:TheIs0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ci q:key=--><!--/qv--><!--qv q:id=cj q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ck">The Israeli attack on Al Hudaydah “will not deter the Yemeni people and their armed forces from performing their religious, humanitarian and moral duty towards the Palestinian and Lebanese peoples,” the statement said. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=cl q:key=5auE:TheID1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=cl q:key=--><!--/qv--><!--qv q:id=cm q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="cn">The IDF said it was targeting Houthi infrastructure to prevent the group’s ability to obtain supplies from Iran.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=cd q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57491--><!--qv q:id=co q:key=5MJu:card-rcrd57491--><!--qv q:key=r0_14--><div id="rcrd57491" data-pubat="2024-09-30T18:00:56.869Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="cp"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 2:00 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=cq-->Displaced families crowd Beirut streets as fears of Israeli invasion grow <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=cr q:key=7CbQ:r0_7--><!--qv q:s q:sref=cr q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=co q:key=--><!--qv q:id=cs q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ct q:key=5auE:Famil0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ct q:key=--><!--/qv--><!--qv q:id=cu q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="cv">Families fleeing Israeli airstrikes in southern Lebanon and other areas that have been attacked are flocking to Martyr’s Square in Beirut. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=cw q:key=5auE:NBCNe1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=cw q:key=--><!--/qv--><!--qv q:id=cx q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="cy">NBC News’ chief foreign correspondent Richard Engel reports that many there fear what happened in Gaza will happen to them as well.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=cz q:key=5auE:mmvo220453957512--><!--qv q:id=d0 q:key=q9JX:Rz_2--><!--qv q:id=d2 q:key=C4ZI:Bn_0--><div data-testid="jwplayer-with-overlay" class="_jwPlayerWithOverlayContainer_1calw_2 grid-stack-container jwplayerEmbed mb-10 mt-4 feedBody" on-document:qinit="q-B6-FC0L-.js#_hW[0]" on-document:auth-update="q-B6-FC0L-.js#s_4eLncuS6TBY[1]" on-document:qidle="q--_M_9sWK.js#_hW[2]" q:key="GH_17" q:id="d3"><div class="_overlay_1calw_48"><div class="_overlayBackgroundGradient_1calw_217 _fadeOutWithControls_1calw_224"></div><div class="_overlayMeta_1calw_104"><div class="_timestamp_1calw_135 _fadeOutWithControls_1calw_224" q:key="GH_6"><!--t=d4-->04:38<!----></div></div><div class="_shareContainer_1calw_140 _fadeOutWithControls_1calw_224"><button id="jwplayer-l5biiz-C4ZIm9X4sDY-d1-share-options-button" aria-controls="jwplayer-l5biiz-C4ZIm9X4sDY-d1-share-options" aria-expanded="false" aria-label="More options" aria-haspopup="menu" class="_threeDotsButton_1calw_145" on:click="q--_M_9sWK.js#s_Et0810rY3jo[0 1]" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="d5"><div class="_threeDotsIcon_1calw_159" q:key="GH_7"></div></button><ul id="jwplayer-l5biiz-C4ZIm9X4sDY-d1-share-options" aria-labelledby="jwplayer-l5biiz-C4ZIm9X4sDY-d1-share-options-button" role="menu" aria-hidden="true" class="_shareButtons_1calw_182" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="d6"><li role="none"><a href="https://www.facebook.com/sharer/sharer.php?u=https://www.msnbc.com/andrea-mitchell-reports/watch/displaced-families-crowd-beirut-streets-as-fears-of-israeli-invasion-grow-220453957512" role="menuitem" aria-label="Share on Facebook" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-CL3qfk7x.js#s_0C0xTPxyHBQ" q:id="d7"><!--qv q:id=d8 q:key=dJkd:GH_9--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="d9"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#facebook" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="https://x.com/intent/post?text=&amp;url=https://www.msnbc.com/andrea-mitchell-reports/watch/displaced-families-crowd-beirut-streets-as-fears-of-israeli-invasion-grow-220453957512&amp;original_referer=https://www.msnbc.com/andrea-mitchell-reports/watch/displaced-families-crowd-beirut-streets-as-fears-of-israeli-invasion-grow-220453957512" role="menuitem" aria-label="Share on X (Twitter)" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-JtsO08fV.js#s_h6hvWqYCELA" q:id="da"><!--qv q:id=db q:key=dJkd:GH_10--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="dc"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#x" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="mailto:?subject=&amp;body=https://www.msnbc.com/andrea-mitchell-reports/watch/displaced-families-crowd-beirut-streets-as-fears-of-israeli-invasion-grow-220453957512" role="menuitem" aria-label="Share via Email" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-C0GiLlW_.js#s_KE0wDxvLlrA" q:id="dd"><!--qv q:id=de q:key=dJkd:GH_11--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="df"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#email" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li></ul></div></div><!--qv q:key=GH_13--><button aria-label="play video" class="_clickToPlayButton_1calw_254 flex-center" on:click="q--_M_9sWK.js#s_fXS03dk2qiE[0 1 2 3 4 5]" q:id="dg"><div class="_playIconContainer_1calw_20 flex-center"><!--qv q:id=dh q:key=dJkd:GH_12--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" q:key="YD_0" q:id="di"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#play" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></div></button><!--/qv--><!--qv q:id=dj q:key=HvIT:GH_15--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 _posterFrame_1calw_282 mb-0" q:key="hI_2"><picture class="block" q:id="dk"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_630/mpx/2704722219/2024_09/1727714225547_n_mitchell_brk_lebanon_invasion_fears_240930_1920x1080-q55sqq.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_315/mpx/2704722219/2024_09/1727714225547_n_mitchell_brk_lebanon_invasion_fears_240930_1920x1080-q55sqq.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_878/mpx/2704722219/2024_09/1727714225547_n_mitchell_brk_lebanon_invasion_fears_240930_1920x1080-q55sqq.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_439/mpx/2704722219/2024_09/1727714225547_n_mitchell_brk_lebanon_invasion_fears_240930_1920x1080-q55sqq.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_780,h_439/mpx/2704722219/2024_09/1727714225547_n_mitchell_brk_lebanon_invasion_fears_240930_1920x1080-q55sqq.jpg" width="780" height="439" loading="lazy" fetchPriority="low" alt="" class="block" q:id="dl"></picture></figure><!--/qv--></div><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=co q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57494--><!--qv q:id=dm q:key=5MJu:card-rcrd57494--><!--qv q:key=r0_14--><div id="rcrd57494" data-pubat="2024-09-30T17:52:40.623Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="dn"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 1:52 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=do-->Israel informed U.S. of plans for limited operations in Lebanon, State Department says<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=dp q:key=7CbQ:r0_7--><!--qv q:s q:sref=dp q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=dm q:key=--><!--qv q:id=dq q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=dr q:key=5auE:Israe0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=dr q:key=--><!--/qv--><!--qv q:id=ds q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="dt">Israel has informed the U.S. of their plans for limited ground operations in Lebanon focusing on infrastructure belonging to the Hezbollah militant group,  State Department spokesperson Matthew Miller said today.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=du q:key=5auE:“They1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=du q:key=--><!--/qv--><!--qv q:id=dv q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="dw">“They have at this time, told us that those are limited operations focused on Hezbollah, infrastructure, near the border but we’re in continuous conversations,” Miller told reporters at a briefing.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=dx q:key=5auE:Israe2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=dx q:key=--><!--/qv--><!--qv q:id=dy q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="dz">Israel and Hezbollah have been trading fire across Lebanon's southern border since Oct. 8, the day after Hamas launched its cross-border terror attacks on Israel.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=e0 q:key=5auE:Earli3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=e0 q:key=--><!--/qv--><!--qv q:id=e1 q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="e2">Earlier in the day, Israel's defense minister said "the next phase in the war against Hezbollah will begin soon,” adding that the goal was to return residents of north Israel to their homes. However, Yoav Gallant did not elaborate on what this new phase would entail. </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=dm q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57493--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57493"><!--qv q:id=e3 q:key=00Of:feed-ad-rcrd57493--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="e4"><div id="div-libra-feed-ad-rcrd57493" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=e5 q:key=5MJu:card-rcrd57493--><!--qv q:key=r0_14--><div id="rcrd57493" data-pubat="2024-09-30T17:25:14.303Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="e6"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 1:25 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=e7-->Israel&#39;s security cabinet to meet as ground offensive looms<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=e8 q:key=7CbQ:r0_7--><!--qv q:s q:sref=e8 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=e5 q:key=--><!--qv q:id=e9 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ea q:key=5auE:Israe0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ea q:key=--><!--/qv--><!--qv q:id=eb q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ec">Israel's security cabinet will meet at 9 p.m. local time (2 p.m. ET) amid growing indications an Israeli ground offensive into southern Lebanon may be imminent, an Israeli official told NBC News today.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=e5 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57489--><!--qv q:id=ed q:key=5MJu:card-rcrd57489--><!--qv q:key=r0_14--><div id="rcrd57489" data-pubat="2024-09-30T17:16:56.879Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="ee"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 1:16 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=ef-->E.U. foreign ministers hold emergency meeting on Lebanon escalation <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=eg q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/mirna-alsharif-ncpn1297517" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="eh"><!--qv q:s q:sref=eg q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=ed q:key=--><!--qv q:id=ei q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ej q:key=5auE:Forei0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ej q:key=--><!--/qv--><!--qv q:id=ek q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="el">Foreign ministers from the European Union held an emergency meeting on Lebanon today, according to Peter Stano, lead spokesperson for the external affairs of the E.U.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=em q:key=5auE:Thehi1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=em q:key=--><!--/qv--><!--qv q:id=en q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="eo">The high representative of the union will give a statement shortly, Stano said. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ep q:key=5auE:Thega2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ep q:key=--><!--/qv--><!--qv q:id=eq q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="er">The gathering comes days after the E.U. said that it would provide 10 million euros ($11.1 million) in aid for people in Lebanon affected by the “ongoing escalation of hostilities” between Israel and Hezbollah.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=es q:key=5auE:“This3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=es q:key=--><!--/qv--><!--qv q:id=et q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="eu">“This emergency funding aims to tackle the most urgent needs such as protection, food assistance, shelter and health care,” a statement from the E.U. said Saturday. “The E.U. stands ready to provide further support by mobilising all the available emergency response tools, including via use of the Civil Protection Mechanism.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=0Z_2--><div class="showMoreBtnWrapper _showMoreBtnWrapper_hxea4_27 flex relative" q:key="0Z_1"><div data-testid="showmore-fade" class="_showMoreFade_hxea4_30"></div><button type="button" aria-controls="rcrd57489-overflow-content" aria-label="Show more of post E.U. foreign ministers hold emergency meeting on Lebanon escalation " class="_showMoreBtn_hxea4_8 btn relative uppercase block mb-2 ghost-button" on:click="q-BkudQL_O.js#s_J08Rfg6pYLQ[0]" q:id="ev">Show more</button></div><div id="rcrd57489-overflow-content" data-testid="markupembeds-overflow" class="_afterShowMore_hxea4_40" q:id="ew"><!--qv q:id=ex q:key=5auE:“Peop0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ex q:key=--><!--/qv--><!--qv q:id=ey q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ez">“People in Lebanon, including refugees, were already experiencing high levels of poverty and food insecurity while having limited access to services,” the E.U. added. “Nearly 2 million Lebanese and Syrian refugees are estimated to be food insecure. This number is expected to rise further.”</p><!--/qv--><!--/qv--><!--/qv--></div><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=ed q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57485--><!--qv q:id=f0 q:key=5MJu:card-rcrd57485--><!--qv q:key=r0_14--><div id="rcrd57485" data-pubat="2024-09-30T16:53:17.672Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="f1"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 12:53 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=f2-->Israeli defense minister says &#39;next phase in the war against Hezbollah will begin soon&#39;<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=f3 q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/mirna-alsharif-ncpn1297517" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="f4"><!--qv q:s q:sref=f3 q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=f0 q:key=--><!--qv q:id=f5 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=f6 q:key=5auE:The“n0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=f6 q:key=--><!--/qv--><!--qv q:id=f7 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="f8">The “next phase in the war against Hezbollah will begin soon,” Israel's defense minister said in a post on X today. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=f9 q:key=5auE:YoavG1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=f9 q:key=--><!--/qv--><!--qv q:id=fa q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="fb">Yoav Gallant said the phase "will be a significant factor in achieving the goal of the war — returning the residents of the north to their homes."</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=fc q:key=5auE:Hedid2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=fc q:key=--><!--/qv--><!--qv q:id=fd q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="fe">He did not say what this phase would entail. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ff q:key=5auE:rcim317069--><!--qv q:id=fg q:key=HvIT:rcim317069--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="fh"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240930-northern-israel-mn-1300-2d7142.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-northern-israel-mn-1300-2d7142.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1040/rockcms/2024-09/240930-northern-israel-mn-1300-2d7142.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_520/rockcms/2024-09/240930-northern-israel-mn-1300-2d7142.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2000,h_1333/rockcms/2024-09/240930-northern-israel-mn-1300-2d7142.jpg" width="780" height="520" loading="lazy" fetchPriority="low" alt="Israeli soldiers work on tanks and armored personnel carriers in northern Israel, Monday, Sept. 30, 2024. " class="block" q:id="fi"></picture><!--qv q:id=fj q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=fk-->Soldiers work on tanks and armored personnel carriers in northern Israel today.<!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=fl-->Leo Correa / AP<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=f0 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57483--><!--qv q:id=fm q:key=5MJu:card-rcrd57483--><!--qv q:key=r0_14--><div id="rcrd57483" data-pubat="2024-09-30T16:45:46.250Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="fn"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 12:45 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=fo-->IDF soldier &#39;severely injured&#39; during combat in southern Gaza<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=fp q:key=7CbQ:r0_7--><!--qv q:s q:sref=fp q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=fm q:key=--><!--qv q:id=fq q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=fr q:key=5auE:AnIsr0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=fr q:key=--><!--/qv--><!--qv q:id=fs q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ft">An Israel Defense Forces soldier was “severely injured” during combat in southern Gaza, the military said in a statement today. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=fu q:key=5auE:Theso1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=fu q:key=--><!--/qv--><!--qv q:id=fv q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="fw">The soldier is from the 8108th battalion of the 679th brigade, the IDF said. The soldier was not named and the extent of the injuries are not known. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=fx q:key=5auE:“Thes2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=fx q:key=--><!--/qv--><!--qv q:id=fy q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="fz">“The soldier was evacuated to a hospital for further treatment, his family was notified,” the statement added.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=fm q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57446--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57446"><!--qv q:id=g0 q:key=00Of:feed-ad-rcrd57446--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="g1"><div id="div-libra-feed-ad-rcrd57446" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=g2 q:key=5MJu:card-rcrd57446--><!--qv q:key=r0_14--><div id="rcrd57446" data-pubat="2024-09-30T16:35:08.261Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="g3"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 12:35 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=g4-->Lebanese PM ready to send army south of Litani River<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=g5 q:key=7CbQ:r0_7--><!--qv q:s q:sref=g5 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=g2 q:key=--><!--qv q:id=g6 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=g7 q:key=5auE:Leban0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=g7 q:key=--><!--/qv--><!--qv q:id=g8 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="g9">Lebanon is ready to send its army south of the Litani river, the nation’s Prime Minister Najib Mikati told reporters today.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ga q:key=5auE:Mikat1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ga q:key=--><!--/qv--><!--qv q:id=gb q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="gc">Mikati said his government was “ready to implement the 1701 agreement,” referencing a 2006 U.N. resolution that aimed to end Hezbollah’s armed presence in the south as part of an agreement to end a 34-day war with Israel.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=gd q:key=5auE:There2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=gd q:key=--><!--/qv--><!--qv q:id=ge q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="gf">The resolution also called for a full Israeli withdrawal from southern Lebanon. The Litani river lies about 20 miles from Lebanon’s southern border.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=gg q:key=5auE:“Weco3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=gg q:key=--><!--/qv--><!--qv q:id=gh q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="gi">“We confirm our agreement and pledge to implement the ceasefire immediately to discuss the implementation of U.N. Resolution 1701,” said Mikati. </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=g2 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57477--><!--qv q:id=gj q:key=5MJu:card-rcrd57477--><!--qv q:key=r0_14--><div id="rcrd57477" data-pubat="2024-09-30T16:03:33.872Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="gk"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 12:03 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=gl-->UNRWA chief denies knowledge that suspended employee was Hamas leader in Lebanon  <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=gm q:key=7CbQ:r0_7--><!--qv q:s q:sref=gm q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=gj q:key=--><!--qv q:id=gn q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=go q:key=5auE:TheU.0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=go q:key=--><!--/qv--><!--qv q:id=gp q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="gq">The U.N. Palestinian refugee agency (UNRWA) chief today denied knowing that its employee Fateh Sherif Abu el-Amin was a Hamas commander in Lebanon and called on states to push back against Israeli attacks on the agency.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=gr q:key=5auE:Thehe1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=gr q:key=--><!--/qv--><!--qv q:id=gs q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="gt">The head of Hamas’ Lebanon branch, Abu el-Amin was killed along with family members in an Israeli strike in southern Lebanon, the group said today. He was suspended from his job at UNRWA in March following allegations concerning his politics, Philippe Lazzarini told reporters in Geneva.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=gu q:key=5auE:“Inev2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=gu q:key=--><!--/qv--><!--qv q:id=gv q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="gw">“I never heard the word commander before,” he said. “What’s obvious for you today, was not obvious yesterday.” </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=gj q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57470--><!--qv q:id=gx q:key=5MJu:card-rcrd57470--><!--qv q:key=r0_14--><div id="rcrd57470" data-pubat="2024-09-30T16:00:29.981Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="gy"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 12:00 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=gz-->&#39;We should have a cease-fire right now,&#39; Biden says<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=h0 q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/sarah-dean-ncpn1281478" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="h1"><!--qv q:s q:sref=h0 q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=gx q:key=--><!--qv q:id=h2 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=h3 q:key=5auE:There0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=h3 q:key=--><!--/qv--><!--qv q:id=h4 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="h5">There should be a cease-fire “right now,” President Joe Biden said today when asked whether he was comfortable with Israel’s plan to invade Lebanon in its fight against Hezbollah.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=h6 q:key=5auE:“I’mm1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=h6 q:key=--><!--/qv--><!--qv q:id=h7 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="h8">“I’m more aware than you might know and I’m comfortable with them stopping,” he told reporters at the White House. “We should have a cease-fire right now.”</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=h9 q:key=5auE:rcim317087--><!--qv q:id=ha q:key=HvIT:rcim317087--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="hb"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_748/rockcms/2024-09/240930-lebanon-mn-1300-770dcb.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-lebanon-mn-1300-770dcb.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240930-lebanon-mn-1300-770dcb.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240930-lebanon-mn-1300-770dcb.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_1800,h_1201/rockcms/2024-09/240930-lebanon-mn-1300-770dcb.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="Mourners gather for the funeral " class="block" q:id="hc"></picture><!--qv q:id=hd q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=he-->Mourners gather today for the funeral of commanders of the Popular Front For the Liberation of Palestine who were killed by an overnight Israeli airstrike in Beirut, at a camp camp for Palestinian refugees near Tripoli, Lebanon.<!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=hf-->Fathi Al-Masri / AFP - Getty Images<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=gx q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57475--><!--qv q:id=hg q:key=5MJu:card-rcrd57475--><!--qv q:key=r0_14--><div id="rcrd57475" data-pubat="2024-09-30T15:52:05.783Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="hh"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 11:52 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=hi-->Hezbollah fires Nour missile into northern Israel <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=hj q:key=7CbQ:r0_7--><!--qv q:s q:sref=hj q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=hg q:key=--><!--qv q:id=hk q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=hl q:key=5auE:Hezbo0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=hl q:key=--><!--/qv--><!--qv q:id=hm q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="hn">Hezbollah said in a statement that it fired a Nour missile at Israel, which sources familiar with the Lebanese militant group told Reuters is a ballistic missile. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ho q:key=5auE:Themi1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ho q:key=--><!--/qv--><!--qv q:id=hp q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="hq">The missile hit the village of Kafr Giladi in northern Israel, the statement said, adding that it had fired it in response to “Israeli violations of cities, villages, and civilians.” </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=hr q:key=5auE:Itwas2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=hr q:key=--><!--/qv--><!--qv q:id=hs q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="ht"> It was the first time they have used the missile, the statement said. </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=hg q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57471--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57471"><!--qv q:id=hu q:key=00Of:feed-ad-rcrd57471--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="hv"><div id="div-libra-feed-ad-rcrd57471" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=hw q:key=5MJu:card-rcrd57471--><!--qv q:key=r0_14--><div id="rcrd57471" data-pubat="2024-09-30T15:41:12.888Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="hx"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 11:41 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=hy-->Iran has &#39;no good options&#39; to retaliate against Israel, leading analyst concludes<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=hz q:key=7CbQ:r0_7--><!--qv q:s q:sref=hz q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=hw q:key=--><!--qv q:id=i0 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=i1 q:key=5auE:Iranf0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=i1 q:key=--><!--/qv--><!--qv q:id=i2 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="i3">Iran faces “no good options in retaliting against Israel,” following the assassination of Hezbollah leader Hassan Nasrallah, according to a senior research fellow at the Royal United Services Institute, a London based think tank. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=i4 q:key=5auE:Burcu1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=i4 q:key=--><!--/qv--><!--qv q:id=i5 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="i6">Burcu Ozcelik said in a commentary that Iran could “mobilize militia in Iraq and Syria against Israeli, U.S. and U.K. targets, but refrain from direct confrontation.” </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=i7 q:key=5auE:Shead2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=i7 q:key=--><!--/qv--><!--qv q:id=i8 q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="i9">She added that Iran could mobilize attacks from the Yemen-based Houthi militia “against sensitive targets inside Israel."</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ia q:key=5auE:“With3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ia q:key=--><!--/qv--><!--qv q:id=ib q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="ic">“With Hezbollah now in crisis, the Houthis may gain more operational significance. An escalation in Houthi-led harassment and attacks on commercial shipping in the Red Sea may be expected,” she said. Tehran also backs the Houthis. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=0Z_2--><div class="showMoreBtnWrapper _showMoreBtnWrapper_hxea4_27 flex relative" q:key="0Z_1"><div data-testid="showmore-fade" class="_showMoreFade_hxea4_30"></div><button type="button" aria-controls="rcrd57471-overflow-content" aria-label="Show more of post Iran has &#39;no good options&#39; to retaliate against Israel, leading analyst concludes" class="_showMoreBtn_hxea4_8 btn relative uppercase block mb-2 ghost-button" on:click="q-BkudQL_O.js#s_J08Rfg6pYLQ[0]" q:id="id">Show more</button></div><div id="rcrd57471-overflow-content" data-testid="markupembeds-overflow" class="_afterShowMore_hxea4_40" q:id="ie"><!--qv q:id=if q:key=5auE:Third0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=if q:key=--><!--/qv--><!--qv q:id=ig q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ih">Third, she said, Iran could attack Israel directly which “may salvage Iran’s credibility with its core base” inside the country but could erode the country’s “projection of military strength and cause a legitimacy crisis inside Iran.”   </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ii q:key=5auE:“Ifan1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ii q:key=--><!--/qv--><!--qv q:id=ij q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="ik">“If a negotiated ceasefire in Gaza was not enough of a priority before, it is even more important now. It may now be the crucial lever needed to initiate a process of de-escalation," she said. </p><!--/qv--><!--/qv--><!--/qv--></div><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=hw q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57460--><!--qv q:id=il q:key=5MJu:card-rcrd57460--><!--qv q:key=r0_14--><div id="rcrd57460" data-pubat="2024-09-30T14:59:25.364Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="im"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 10:59 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=in-->Islamic Resistance in Iraq claims two strikes on Haifa<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=io q:key=7CbQ:r0_7--><!--qv q:s q:sref=io q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=il q:key=--><!--qv q:id=ip q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=iq q:key=5auE:TheIs0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=iq q:key=--><!--/qv--><!--qv q:id=ir q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="is">The Islamic Resistance in Iraq said in a statement today that it attacked four Israeli targets in response to Israel's attacks on Lebanon and Gaza.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=it q:key=5auE:Itsai1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=it q:key=--><!--/qv--><!--qv q:id=iu q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="iv">It said that it attacked two “vital” targets in the Israeli port city of Haifa using drones, as well as two other unspecified targets.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=iw q:key=5auE:NBCNe2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=iw q:key=--><!--/qv--><!--qv q:id=ix q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="iy">NBC News has reached out to the IDF for comment. </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=il q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57463--><!--qv q:id=iz q:key=5MJu:card-rcrd57463--><!--qv q:key=r0_14--><div id="rcrd57463" data-pubat="2024-09-30T14:45:07.997Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="j0"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 10:45 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=j1-->Germany flies embassy employee families and non-essential embassy personnel out of the region<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=j2 q:key=7CbQ:r0_7--><!--qv q:s q:sref=j2 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=iz q:key=--><!--qv q:id=j3 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=j4 q:key=5auE:Germa0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=j4 q:key=--><!--/qv--><!--qv q:id=j5 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="j6">Germany has started to fly non-essential personnel and the family members of embassy employees out of Israel, Lebanon and the occupied West Bank, the country's foreign office said in a statement today.   </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=j7 q:key=5auE:"Invi1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=j7 q:key=--><!--/qv--><!--qv q:id=j8 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="j9">"In view of the situation, the Federal Foreign Office raised the crisis level for the foreign missions in Beirut, Ramallah and Tel Aviv again at the weekend and initiated a diplomatic pick-up," the statement said. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ja q:key=5auE:"This2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ja q:key=--><!--/qv--><!--qv q:id=jb q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="jc">"This means that the embassies remain operational, but family members of the posted employees and of German intermediary organizations as well as non-essential personnel are flying out," it added. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=jd q:key=5auE:“Thee3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=jd q:key=--><!--/qv--><!--qv q:id=je q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="jf">“The embassy continues to support the remaining Germans in Lebanon in their departure via commercial flights and other means,” it said.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=iz q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57465--><!--qv q:id=jg q:key=5MJu:card-rcrd57465--><!--qv q:key=r0_14--><div id="rcrd57465" data-pubat="2024-09-30T14:38:15.321Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="jh"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 10:38 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=ji-->Netanyahu says nowhere in Middle East out of Israel’s reach<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=jj q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/f-brinley-bruton-ncpn721" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="jk"><!--qv q:s q:sref=jj q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=jg q:key=--><!--qv q:id=jl q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=jm q:key=5auE:There0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=jm q:key=--><!--/qv--><!--qv q:id=jn q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="jo">There is nowhere in the Middle East that Israel cannot reach, Israeli Prime Minister Benjamin Netanyahu warned today in comments directed at Iran, two days after Israel killed the leader of Tehran-backed Lebanese militant group Hezbollah.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=jp q:key=5auE:Speak1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=jp q:key=--><!--/qv--><!--qv q:id=jq q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="jr">Speaking in English in a three-minute video clip released by his office, Netanyahu said he was addressing “the people of Iran.”</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=js q:key=5auE:“Ther2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=js q:key=--><!--/qv--><!--qv q:id=jt q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="ju">“There is nowhere in the Middle East Israel cannot reach.  There is nowhere we will not go to protect our people and protect our country,” Netanyahu said. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=jv q:key=5auE:“Don’3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=jv q:key=--><!--/qv--><!--qv q:id=jw q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="jx">“Don’t let a small group of fanatic theocrats crush your hopes and your dreams,” he added. “You deserve better.”</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=jy q:key=5auE:ncwd999999--><!--qv q:id=jz q:key=57R8:LTG1csa--><div data-testid="iframely-embed" class="overflow-hidden mb-4 mx-auto w-full twitter feedBody" on:qvisible="q-B4mwBO5V.js#_hW[0]" q:key="uH_0" q:id="k0"><div class="iframely-twitter iframely-embed" q:id="k1"><div class="iframely-responsive"><iframe src="about:blank" data-testid="iframely-iframe" q:id="k2"></iframe></div></div></div><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=jg q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57457--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57457"><!--qv q:id=k3 q:key=00Of:feed-ad-rcrd57457--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="k4"><div id="div-libra-feed-ad-rcrd57457" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=k5 q:key=5MJu:card-rcrd57457--><!--qv q:key=r0_14--><div id="rcrd57457" data-pubat="2024-09-30T14:24:55.312Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="k6"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 10:24 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=k7-->Bahrain’s king urges preservation of Lebanon&#39;s sovereignty <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=k8 q:key=7CbQ:r0_7--><!--qv q:s q:sref=k8 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=k5 q:key=--><!--qv q:id=k9 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ka q:key=5auE:Bahra0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ka q:key=--><!--/qv--><!--qv q:id=kb q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="kc">Bahrain’s King Hamad bin Isa Al Khalifa said today that it was important to preserve Lebanon’s sovereignty and revive efforts to reach a cease-fire in Gaza.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=kd q:key=5auE:Bahra1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=kd q:key=--><!--/qv--><!--qv q:id=ke q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="kf">Bahrain is home to the U.S. Navy 5th Fleet and has close ties to the U.S. It has long blamed Iran, a Muslim Shia nation, for stirring up its own majority Shia population against its Sunni monarchy. </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=k5 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57454--><!--qv q:id=kg q:key=5MJu:card-rcrd57454--><!--qv q:key=r0_14--><div id="rcrd57454" data-pubat="2024-09-30T13:51:41.214Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="kh"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 9:51 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=ki-->U.S. Embassy working with airlines in Lebanon<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=kj q:key=7CbQ:r0_7--><!--qv q:s q:sref=kj q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=kg q:key=--><!--qv q:id=kk q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=kl q:key=5auE:TheU.0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=kl q:key=--><!--/qv--><!--qv q:id=km q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="kn">The U.S. Embassy in Beirut said it is working with airlines to help citizens depart Lebanon by providing additional flights. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ko q:key=5auE:Manya1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ko q:key=--><!--/qv--><!--qv q:id=kp q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="kq">Many airlines have stopped flying to Lebanon since Israel intensified its offensive in the past fortnight.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=kr q:key=5auE:ncwd999999--><!--qv q:id=ks q:key=57R8:vNcejYj--><div data-testid="iframely-embed" class="overflow-hidden mb-4 mx-auto w-full twitter feedBody" on:qvisible="q-B4mwBO5V.js#_hW[0]" q:key="uH_0" q:id="kt"><div class="iframely-twitter iframely-embed" q:id="ku"><div class="iframely-responsive"><iframe src="about:blank" data-testid="iframely-iframe" q:id="kv"></iframe></div></div></div><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=kg q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57443--><!--qv q:id=kw q:key=5MJu:card-rcrd57443--><!--qv q:key=r0_14--><div id="rcrd57443" data-pubat="2024-09-30T13:40:20.011Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="kx"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 9:40 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=ky-->Russia warns of &#39;very high&#39; risk of regional war <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=kz q:key=7CbQ:r0_7--><!--qv q:s q:sref=kz q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=kw q:key=--><!--qv q:id=l0 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=l1 q:key=5auE:Theri0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=l1 q:key=--><!--/qv--><!--qv q:id=l2 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="l3">The risk of a major war in the Middle East is “very high,” following the death of Hezbollah leader Hassan Nasrallah, Kremlin spokesman Dmitry Peskov told reporters today. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=l4 q:key=5auE:Conde1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=l4 q:key=--><!--/qv--><!--qv q:id=l5 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="l6">Condemning Nasrallah’s death, Peskov said Russia believed it had “significantly destabilized the situation in the region.”</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=l7 q:key=5auE:“Such2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=l7 q:key=--><!--/qv--><!--qv q:id=l8 q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="l9">“Such indiscriminate bombings of residential areas in Lebanon lead to a huge amount of victims and will inevitably result in a humanitarian disaster, the same as we see in Gaza,” he said. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=la q:key=5auE:“Weca3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=la q:key=--><!--/qv--><!--qv q:id=lb q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="lc">“We cannot ignore such consequences and we cannot help being deeply concerned over them,” he added.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=kw q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57419--><!--qv q:id=ld q:key=5MJu:card-rcrd57419--><!--qv q:key=r0_14--><div id="rcrd57419" data-pubat="2024-09-30T13:20:06.944Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="le"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 9:20 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=lf-->Satellite images show craters left by Israeli airstrike on Nasrallah&#39;s bunker<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=lg q:key=7CbQ:r0_7--><!--qv q:s q:sref=lg q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=ld q:key=--><!--qv q:id=lh q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=li q:key=5auE:Satel0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=li q:key=--><!--/qv--><!--qv q:id=lj q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="lk">Satellite images taken Aug. 25 and yesterday show the area of southern Beirut where Hezbollah leader Hassan Nasrallah was killed by an Israeli airstrike.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ll q:key=5auE:rcim316804--><!--qv q:id=lm q:key=HvIT:rcim316804--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block" q:id="ln"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_840/rockcms/2024-09/240930-beirut-before-after-wc-0922-f5e0cd.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_420/rockcms/2024-09/240930-beirut-before-after-wc-0922-f5e0cd.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1170/rockcms/2024-09/240930-beirut-before-after-wc-0922-f5e0cd.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_585/rockcms/2024-09/240930-beirut-before-after-wc-0922-f5e0cd.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1875/rockcms/2024-09/240930-beirut-before-after-wc-0922-f5e0cd.jpg" width="780" height="585" loading="lazy" fetchPriority="low" alt="" class="block" q:id="lo"></picture><!--qv q:id=lp q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=lq-->  Planet Labs<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=ld q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57440--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57440"><!--qv q:id=lr q:key=00Of:feed-ad-rcrd57440--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="ls"><div id="div-libra-feed-ad-rcrd57440" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=lt q:key=5MJu:card-rcrd57440--><!--qv q:key=r0_14--><div id="rcrd57440" data-pubat="2024-09-30T13:00:26.305Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="lu"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 9:00 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=lv-->Goal is safe return of northern communities, Israeli defense minister says<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=lw q:key=7CbQ:r0_7--><!--qv q:s q:sref=lw q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=lt q:key=--><!--qv q:id=lx q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ly q:key=5auE:Israe0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ly q:key=--><!--/qv--><!--qv q:id=lz q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="m0">Israel is prepared to “make every effort necessary” in order to ensure the return of its northern communities, the country's defense minister said today on a visit to the border with Lebanon.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=m1 q:key=5auE:“Ourg1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=m1 q:key=--><!--/qv--><!--qv q:id=m2 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="m3">“Our goal is to ensure the [safe] return of Israel’s northern communities to their homes,” Yoav Gallant was quoted as saying in a statement. “We will use all the means that may be required — your forces, other forces, from the air, from the sea, and on land.”</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=m4 q:key=5auE:Thest2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=m4 q:key=--><!--/qv--><!--qv q:id=m5 q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="m6">The statement said Gallant was briefed about the readiness of troops for the possibility of expanding activities in the north.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=lt q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57449--><!--qv q:id=m7 q:key=5MJu:card-rcrd57449--><!--qv q:key=r0_14--><div id="rcrd57449" data-pubat="2024-09-30T12:38:44.458Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="m8"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 8:38 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=m9-->Soldier killed by Israeli drone, Lebanese army says <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=ma q:key=7CbQ:r0_7--><!--qv q:s q:sref=ma q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=m7 q:key=--><!--qv q:id=mb q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=mc q:key=5auE:ALeba0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=mc q:key=--><!--/qv--><!--qv q:id=md q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="me">A Lebanese soldier was killed by an Israeli drone, the country's army said today in a post on X. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=mf q:key=5auE:Thedr1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=mf q:key=--><!--/qv--><!--qv q:id=mg q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="mh">The drone targeted a motorcycle while it was passing through an army checkpoint, the post said. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=mi q:key=5auE:ncwd999999--><!--qv q:id=mj q:key=57R8:2IezrHR--><div data-testid="iframely-embed" class="overflow-hidden mb-4 mx-auto w-full twitter feedBody" on:qvisible="q-B4mwBO5V.js#_hW[0]" q:key="uH_0" q:id="mk"><div class="iframely-twitter iframely-embed" q:id="ml"><div class="iframely-responsive"><iframe src="about:blank" data-testid="iframely-iframe" q:id="mm"></iframe></div></div></div><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=m7 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57422--><!--qv q:id=mn q:key=5MJu:card-rcrd57422--><!--qv q:key=r0_14--><div id="rcrd57422" data-pubat="2024-09-30T12:33:45.851Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="mo"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 8:33 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=mp-->100,000 have fled Lebanon for Syria, U.N. says <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=mq q:key=7CbQ:r0_7--><!--qv q:s q:sref=mq q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=mn q:key=--><!--qv q:id=mr q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ms q:key=5auE:Moret0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ms q:key=--><!--/qv--><!--qv q:id=mt q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="mu">More than 100,000 Lebanese nationals and Syrians living in Lebanon have crossed into Syria as they flee Israeli airstrikes, the United Nations High Commissioner for Refugees said today. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=mv q:key=5auE:Filip1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=mv q:key=--><!--/qv--><!--qv q:id=mw q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="mx">Filippo Grandi said in a post on X that the U.N. Relief and Works Agency is present at four crossing points alongside local authorities and the Syrian Red Crescent to support new arrivals.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=my q:key=5auE:Separ2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=my q:key=--><!--/qv--><!--qv q:id=mz q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="n0">Separately, the U.N. Relief and Works Agency, known as UNRWA, said 1,424 people, almost <a href="https://mailchi.mp/unrwa/unrwa-situation-report-2-on-the-lebanon-emergency-response-12711753?e=a400be43e6" target="_blank">half of them children</a>, are registered at its emergency shelters in Lebanon.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=n1 q:key=5auE:ncwd999999--><!--qv q:id=n2 q:key=57R8:o85y4Ea--><div data-testid="iframely-embed" class="overflow-hidden mb-4 mx-auto w-full twitter feedBody" on:qvisible="q-B4mwBO5V.js#_hW[0]" q:key="uH_0" q:id="n3"><div class="iframely-twitter iframely-embed" q:id="n4"><div class="iframely-responsive"><iframe src="about:blank" data-testid="iframely-iframe" q:id="n5"></iframe></div></div></div><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=mn q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57423--><!--qv q:id=n6 q:key=5MJu:card-rcrd57423--><!--qv q:key=r0_14--><div id="rcrd57423" data-pubat="2024-09-30T12:00:54.315Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="n7"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 8:00 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=n8-->Beirut strike shows &#39;no safe place&#39; in Lebanon, aid worker says <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=n9 q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/chantal-da-silva-ncpn1269216" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="na"><!--qv q:s q:sref=n9 q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=n6 q:key=--><!--qv q:id=nb q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=nc q:key=5auE:Fears0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=nc q:key=--><!--/qv--><!--qv q:id=nd q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ne">Fears are growing that “no one is safe” in Lebanon after Israel’s airstrike in central Beirut, according to the executive director of a humanitarian nongovernmental organization working to support families displaced by the bombing campaign. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=nf q:key=5auE:Human1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=nf q:key=--><!--/qv--><!--qv q:id=ng q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="nh">Humanitarian workers were “shocked” by the strike in Beirut’s Cola district, Jihan Kaisi, the Executive Director of the Union of Relief and Development Associations, or URDA, told NBC News.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ni q:key=5auE:“This2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ni q:key=--><!--/qv--><!--qv q:id=nj q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="nk">“This Cola area is crowded with families, with displaced families, who came to this area thinking it’s safe,” she said. “It’s a very crowded area.” And the strike targeting the area, just a couple of miles from downtown Beirut and the city’s Zaitunay Bay, she said, showed there was “no safe place guaranteed in Lebanon.” </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=nl q:key=5auE:Shead3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=nl q:key=--><!--/qv--><!--qv q:id=nm q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="nn">She added that a deadly strike in the Sidon or Saida area in southern Lebanon on Sunday, had also heightened fears in that part of the country.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=0Z_2--><div class="showMoreBtnWrapper _showMoreBtnWrapper_hxea4_27 flex relative" q:key="0Z_1"><div data-testid="showmore-fade" class="_showMoreFade_hxea4_30"></div><button type="button" aria-controls="rcrd57423-overflow-content" aria-label="Show more of post Beirut strike shows &#39;no safe place&#39; in Lebanon, aid worker says " class="_showMoreBtn_hxea4_8 btn relative uppercase block mb-2 ghost-button" on:click="q-BkudQL_O.js#s_J08Rfg6pYLQ[0]" q:id="no">Show more</button></div><div id="rcrd57423-overflow-content" data-testid="markupembeds-overflow" class="_afterShowMore_hxea4_40" q:id="np"><!--qv q:id=nq q:key=5auE:Thous0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=nq q:key=--><!--/qv--><!--qv q:id=nr q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ns">Thousands of families have been sheltering there under the belief that the heavily populated area would be safe and now they don’t know where else to go, she said.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=nt q:key=5auE:Somef1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=nt q:key=--><!--/qv--><!--qv q:id=nu q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="nv">Some families have been forced to sleep on the streets, in playgrounds and in parking lots after makeshift shelters set up in schools became too overcrowded, she added. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=nw q:key=5auE:“It’s2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=nw q:key=--><!--/qv--><!--qv q:id=nx q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="ny">“It’s getting cold at night,” she said. “Imagine, children without any blanket at night. Imagine what is happening... what they will go through.” </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=nz q:key=5auE:Shesa3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=nz q:key=--><!--/qv--><!--qv q:id=o0 q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="o1">She said many people had expressed fears that Lebanon could soon become like Gaza. “There’s talk that Lebanon might face the same situation,” she said. “So, yes they are talking about that. Families are scared.”</p><!--/qv--><!--/qv--><!--/qv--></div><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=n6 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57416--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57416"><!--qv q:id=o2 q:key=00Of:feed-ad-rcrd57416--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="o3"><div id="div-libra-feed-ad-rcrd57416" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=o4 q:key=5MJu:card-rcrd57416--><!--qv q:key=r0_14--><div id="rcrd57416" data-pubat="2024-09-30T11:46:13.713Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="o5"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 7:46 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=o6-->&#39;Stay alert, Stay ready,&#39; IDF warns people in northern Israel<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=o7 q:key=7CbQ:r0_7--><!--qv q:s q:sref=o7 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=o4 q:key=--><!--qv q:id=o8 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=o9 q:key=5auE:Peopl0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=o9 q:key=--><!--/qv--><!--qv q:id=oa q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="ob">People should be ready to seek shelter because Israel’s air defense is “not impenetrable,” according to the Commanding Officer of the Home Front Command in Northern Israel.   </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=oc q:key=5auE:“When1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=oc q:key=--><!--/qv--><!--qv q:id=od q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="oe">“When you hear an alert, immediately enter a sheltered space,” Rafi Milo said on a visit to the region last night. “If you don’t have access to a sheltered space, choose the safest space available and enter it — this saves lives. Stay alert, stay ready, and follow the instructions.”</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=o4 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57415--><!--qv q:id=of q:key=5MJu:card-rcrd57415--><!--qv q:key=r0_14--><div id="rcrd57415" data-pubat="2024-09-30T11:31:17.799Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="og"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 7:31 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=oh-->French foreign minister travels to Beirut after two nationals killed<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=oi q:key=7CbQ:r0_7--><!--qv q:s q:sref=oi q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=of q:key=--><!--qv q:id=oj q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=ok q:key=5auE:Frenc0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ok q:key=--><!--/qv--><!--qv q:id=ol q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="om">French Foreign Minister Jean-Noel Barrot called for an “immediate” end to Israeli airstrikes after he arrived in Lebanon yesterday with a delivery of humanitarian aid.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=on q:key=5auE:“Wewi1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=on q:key=--><!--/qv--><!--qv q:id=oo q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="op">“We will always stand by the civilians,” he said in a post on X, adding that he had brought 12 tons of medical equipment to be used to treat 1,000 seriously injured people.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=oq q:key=5auE:AsBar2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=oq q:key=--><!--/qv--><!--qv q:id=or q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="os">As Barrot arrived, his ministry announced that a second French person had been killed in Lebanon. It did not provide further details. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ot q:key=5auE:Lastw3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ot q:key=--><!--/qv--><!--qv q:id=ou q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="ov">Last week, an 87-year-old Frenchwoman was killed after “a strong explosion” in the south of the country.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=ow q:key=5auE:ncwd999999--><!--qv q:id=ox q:key=57R8:0Q3cxgs--><div data-testid="iframely-embed" class="overflow-hidden mb-4 mx-auto w-full twitter feedBody" on:qvisible="q-B4mwBO5V.js#_hW[0]" q:key="uH_0" q:id="oy"><div class="iframely-twitter iframely-embed" q:id="oz"><div class="iframely-responsive"><iframe src="about:blank" data-testid="iframely-iframe" q:id="p0"></iframe></div></div></div><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=of q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57427--><!--qv q:id=p1 q:key=5MJu:card-rcrd57427--><!--qv q:key=r0_14--><div id="rcrd57427" data-pubat="2024-09-30T11:16:50.514Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="p2"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 7:16 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=p3-->Nasrallah killing was Israeli self-defense, Germany says<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=p4 q:key=7CbQ:r0_7--><!--qv q:s q:sref=p4 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=p1 q:key=--><!--qv q:id=p5 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=p6 q:key=5auE:Israe0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=p6 q:key=--><!--/qv--><!--qv q:id=p7 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="p8">Israel’s killing of Hezbollah leader Sayyed Hassan Nasrallah in a powerful airstrike in Beirut constituted a use of its right to defend itself, a German foreign ministry spokesperson said today.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=p9 q:key=5auE:“Hezb1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=p9 q:key=--><!--/qv--><!--qv q:id=pa q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="pb">“Hezbollah is of course a terrorist organization and it was obviously a meeting of the top leadership of Hezbollah, from which one can assume, even from a distance, that they were planning their further operations,” the spokesperson said.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=pc q:key=5auE:“Soin2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=pc q:key=--><!--/qv--><!--qv q:id=pd q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="pe">“So in this respect, there are also reasons to believe that the right to self-defense was exercised here,” he added.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=pf q:key=5auE:Asked3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=pf q:key=--><!--/qv--><!--qv q:id=pg q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="ph">Asked about the civilian deaths in the incident, the spokesperson said “every civilian victim is one civilian victim too many.”</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=p1 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57432--><!--qv q:id=pi q:key=5MJu:card-rcrd57432--><!--qv q:key=r0_14--><div id="rcrd57432" data-pubat="2024-09-30T10:55:16.639Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="pj"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 6:55 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=pk-->Israeli special forces teams carrying out operations in Lebanon <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=pl q:key=7CbQ:r0_7--><!--qv q:s q:sref=pl q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=pi q:key=--><!--qv q:id=pm q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=pn q:key=5auE:Israe0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=pn q:key=--><!--/qv--><!--qv q:id=po q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="pp">Israel has been launching small special forces operations into southern Lebanon ahead of a potential ground offensive, an Israeli official told NBC News. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=pq q:key=5auE:Theop1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=pq q:key=--><!--/qv--><!--qv q:id=pr q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="ps">The operations are designed to gather intelligence and probe Hezbollah’s positions. The official cautioned that such operations have been going on for months and do not necessarily signal the imminent start of a ground assault</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=pi q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57424--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57424"><!--qv q:id=pt q:key=00Of:feed-ad-rcrd57424--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="pu"><div id="div-libra-feed-ad-rcrd57424" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=pv q:key=5MJu:card-rcrd57424--><!--qv q:key=r0_14--><div id="rcrd57424" data-pubat="2024-09-30T10:53:29.006Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="pw"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 6:53 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=px-->Hezbollah says it is ready for &#39;ground encounter&#39;  <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=py q:key=7CbQ:r0_7--><!--qv q:s q:sref=py q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=pv q:key=--><!--qv q:id=pz q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=q0 q:key=5auE:Thede0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=q0 q:key=--><!--/qv--><!--qv q:id=q1 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="q2">The deputy secretary general of Hezbollah, Naim Qassem, said the militant group is "ready for the enemy to enter by land" during a pre-recorded message televised today.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=q3 q:key=5auE:Qasse1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=q3 q:key=--><!--/qv--><!--qv q:id=q4 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="q5">Qassem said that Hezbollah would "not budge an inch" in supporting Gaza and Palestine, and that the group would emerge victorious "just as we did in 2006," recalling the 34-day conflict between Israel and Hezbollah. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=q6 q:key=5auE:rcim316814--><!--qv q:id=q7 q:key=HvIT:rcim316814--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="q8"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240930-hezbollah-address-wc-1142-153641.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-hezbollah-address-wc-1142-153641.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240930-hezbollah-address-wc-1142-153641.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240930-hezbollah-address-wc-1142-153641.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1667/rockcms/2024-09/240930-hezbollah-address-wc-1142-153641.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="In a televised address on September 30, the Iran-backed group&#39;s deputy chief Naim Qassem said a new chief to replace Nasrallah would be selected &quot;at the earliest opportunity&quot;. " class="block" q:id="q9"></picture><!--qv q:id=qa q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=qb-->People watch a televised speech by Hezbollah&#39;s deputy chief Naim Qassem in a cafe in Beirut&#39;s southern suburbs.<!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=qc-->Ibrahim Amro / AFP - Getty Images<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><!--qv q:id=qd q:key=5auE:It’st3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=qd q:key=--><!--/qv--><!--qv q:id=qe q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="qf">It’s the first major public comment from Hezbollah since its leader Hassan Nasrallah was killed by an Israeli airstrike in Beirut last week. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=qg q:key=5auE:Qasse4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=qg q:key=--><!--/qv--><!--qv q:id=qh q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="qi">Qassem said the group will choose Nasrallah's replacement "as soon as possible."</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=pv q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57425--><!--qv q:id=qj q:key=5MJu:card-rcrd57425--><!--qv q:key=r0_14--><div id="rcrd57425" data-pubat="2024-09-30T10:27:48.404Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="qk"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 6:27 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=ql-->Israel confirms it killed Hamas leader in Lebanon<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=qm q:key=7CbQ:r0_7--><!--qv q:s q:sref=qm q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=qj q:key=--><!--qv q:id=qn q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=qo q:key=5auE:TheID0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=qo q:key=--><!--/qv--><!--qv q:id=qp q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="qq">The IDF and Israel Security Agency issued a joint statement today saying they had killed Hamas' leader in Lebanon, Fateh Sherif Abu Al-Amin.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=qr q:key=5auE:Thest1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=qr q:key=--><!--/qv--><!--qv q:id=qs q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="qt">The statement said the Israeli air forces struck Al-Amin overnight.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=qu q:key=5auE:Earli2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=qu q:key=--><!--/qv--><!--qv q:id=qv q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="qw">Earlier, Hamas said the leader and his family were killed in an Israeli airstrike at their home in southern Lebanon.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=qj q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57413--><!--qv q:id=qx q:key=5MJu:card-rcrd57413--><!--qv q:key=r0_14--><div id="rcrd57413" data-pubat="2024-09-30T10:21:00.911Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="qy"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 6:21 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=qz-->Photos show aftermath of Israeli airstrike in Beirut&#39;s southern suburbs<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=r0 q:key=7CbQ:r0_7--><!--qv q:s q:sref=r0 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=qx q:key=--><!--qv q:id=r1 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=r2 q:key=5auE:Photo0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=r2 q:key=--><!--/qv--><!--qv q:id=r3 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="r4">Photos show the damage to an apartment building in Beirut's southern suburb of Ghobeiry after an overnight Israeli airstrike targeted the area today.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=r5 q:key=5auE:rcim316800--><!--qv q:id=r6 q:key=HvIT:rcim316800--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="r7"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240930-lebanon-strike-ghobeiry-wc-0837-edb70d.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-lebanon-strike-ghobeiry-wc-0837-edb70d.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240930-lebanon-strike-ghobeiry-wc-0837-edb70d.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240930-lebanon-strike-ghobeiry-wc-0837-edb70d.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1667/rockcms/2024-09/240930-lebanon-strike-ghobeiry-wc-0837-edb70d.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="Image: LEBANON-ISRAEL-PALESTINIAN-CONFLICT" class="block" q:id="r8"></picture><!--qv q:id=r9 q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=ra-->A view of the damage at the site of an Israeli strike on Beirut&#39;s southern suburb of Ghobeiry.<!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=rb-->  AFP - Getty Images<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><!--qv q:id=rc q:key=5auE:rcim316802--><!--qv q:id=rd q:key=HvIT:rcim316802--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="re"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240930-ghobeiry-airstrike-damage-wc-0840-abd680.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-ghobeiry-airstrike-damage-wc-0840-abd680.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240930-ghobeiry-airstrike-damage-wc-0840-abd680.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240930-ghobeiry-airstrike-damage-wc-0840-abd680.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1667/rockcms/2024-09/240930-ghobeiry-airstrike-damage-wc-0840-abd680.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="Image: LEBANON-ISRAEL-PALESTINIAN-CONFLICT" class="block" q:id="rf"></picture><!--qv q:id=rg q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=rh-->A man inspects the damage in Ghobeiry.<!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=ri-->  AFP - Getty Images<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><!--qv q:id=rj q:key=5auE:rcim316801--><!--qv q:id=rk q:key=HvIT:rcim316801--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="rl"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240930-ghobeiry-strike-wc-0838-2ef278.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-ghobeiry-strike-wc-0838-2ef278.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240930-ghobeiry-strike-wc-0838-2ef278.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240930-ghobeiry-strike-wc-0838-2ef278.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1667/rockcms/2024-09/240930-ghobeiry-strike-wc-0838-2ef278.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="Image: LEBANON-ISRAEL-PALESTINIAN-CONFLICT" class="block" q:id="rm"></picture><!--qv q:id=rn q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=ro-->People survey the damage after the Israeli strike.<!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=rp-->  AFP - Getty Images<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><!--qv q:id=rq q:key=5auE:fallback-id-4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=rq q:key=--><!--/qv--><!--qv q:id=rr q:key=JbNX:markupbr4--><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=qx q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57421--><!--qv q:id=rs q:key=5MJu:card-rcrd57421--><!--qv q:key=r0_14--><div id="rcrd57421" data-pubat="2024-09-30T09:04:14.812Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="rt"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 5:04 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=ru-->Iran will not leave Israel’s ‘criminal acts’ unanswered, says foreign ministry <!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=rv q:key=7CbQ:r0_7--><!--qv q:s q:sref=rv q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=rs q:key=--><!--qv q:id=rw q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=rx q:key=5auE:Iranw0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=rx q:key=--><!--/qv--><!--qv q:id=ry q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="rz">Iran will not leave any of “the criminal acts” of Israel unanswered, Iranian Foreign Ministry spokesperson Nasser Kanaani said this morning, after the killing of Hezbollah’s chief and an Iranian Revolutionary Guard deputy commander in Lebanon.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=s0 q:key=5auE:Briga1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=s0 q:key=--><!--/qv--><!--qv q:id=s1 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="s2">Brigadier General Abbas Nilforoushan was also killed in <a href="https://www.reuters.com/world/middle-east/irans-parliament-speaker-says-militant-groups-will-go-confronting-israel-2024-09-29/" target="_blank">Israeli strikes on Beirut</a> on Friday.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=s3 q:key=5auE:“West2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=s3 q:key=--><!--/qv--><!--qv q:id=s4 q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="s5">“We stand strongly and we will act in a way that is regretful [for the enemy],” Kanaani told a weekly news conference, adding that Iran does not seek war but is not afraid of it.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=rs q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57418--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57418"><!--qv q:id=s6 q:key=00Of:feed-ad-rcrd57418--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="s7"><div id="div-libra-feed-ad-rcrd57418" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=s8 q:key=5MJu:card-rcrd57418--><!--qv q:key=r0_14--><div id="rcrd57418" data-pubat="2024-09-30T08:38:13.532Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="s9"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 4:38 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=sa-->Senior Hezbollah official to give first speech since Nasrallah killing<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=sb q:key=7CbQ:r0_7--><!--qv q:s q:sref=sb q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=s8 q:key=--><!--qv q:id=sc q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=sd q:key=5auE:Thede0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=sd q:key=--><!--/qv--><!--qv q:id=se q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="sf">The deputy secretary general of Hezbollah, Naem Qassem, is set to make a speech shortly.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=sg q:key=5auE:It'st1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=sg q:key=--><!--/qv--><!--qv q:id=sh q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="si">It's the first major public comment from the militant group since the killing of former longtime leader Hassan Nasrallah in an Israeli attack. The Iran-backed group has yet to announce his replacement. </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=s8 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57411--><!--qv q:id=sj q:key=5MJu:card-rcrd57411--><!--qv q:key=r0_14--><div id="rcrd57411" data-pubat="2024-09-30T08:21:00.473Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="sk"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 4:21 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=sl-->PFLP says three leaders killed in Israeli strike<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=sm q:key=7CbQ:r0_7--><!--qv q:s q:sref=sm q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=sj q:key=--><!--qv q:id=sn q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=so q:key=5auE:ThePo0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=so q:key=--><!--/qv--><!--qv q:id=sp q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="sq">The Popular Front for the Liberation of Palestine has said that three of its leaders were killed in an Israeli airstrike on central Beirut's Cola district.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=sr q:key=5auE:Itlis1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=sr q:key=--><!--/qv--><!--qv q:id=ss q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="st">It listed Mohammed Abdel Aal, Emad Odeh, and Abdel Rahman Abdel Aal among the deceased.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=su q:key=5auE:Thele2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=su q:key=--><!--/qv--><!--qv q:id=sv q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="sw">The leftist PFLP is designated a terrorist group by the U.S., but it is also a member of the Palestine Liberation Organization, a coalition recognized by the United Nations as the official representative of the Palestinians.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=sx q:key=5auE:Israe3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=sx q:key=--><!--/qv--><!--qv q:id=sy q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="sz">Israeli officials are yet to comment on the strike on the Cola district.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=sj q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57409--><!--qv q:id=t0 q:key=5MJu:card-rcrd57409--><!--qv q:key=r0_14--><div id="rcrd57409" data-pubat="2024-09-30T08:12:18.200Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="t1"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 4:12 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=t2-->Apparent Israeli strike hits central Beirut for first time<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=t3 q:key=7CbQ:r0_7--><!--qv q:s q:sref=t3 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=t0 q:key=--><!--qv q:id=t4 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=t5 q:key=5auE:Anapp0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=t5 q:key=--><!--/qv--><!--qv q:id=t6 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="t7">An apparent Israeli airstrike struck a building in the central Beirut neighborhood of Cola last night, according to videos posted to social media.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=t8 q:key=5auE:Thevi1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=t8 q:key=--><!--/qv--><!--qv q:id=t9 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="ta">The videos, geolocated by NBC News, show damage to the multistory building as debris is seen on the ground below. People are also seen gathering around the structure as multiple ambulances converge on the area.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=tb q:key=5auE:rcim316797--><!--qv q:id=tc q:key=HvIT:rcim316797--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 mb-2 feedBody" q:key="hI_2"><picture class="block mb-1" q:id="td"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_747/rockcms/2024-09/240930-beirut-strike-wc-0822-c3593c.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_374/rockcms/2024-09/240930-beirut-strike-wc-0822-c3593c.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_1041/rockcms/2024-09/240930-beirut-strike-wc-0822-c3593c.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_521/rockcms/2024-09/240930-beirut-strike-wc-0822-c3593c.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_2500,h_1667/rockcms/2024-09/240930-beirut-strike-wc-0822-c3593c.jpg" width="780" height="521" loading="lazy" fetchPriority="low" alt="Israel hit a Beirut apartment block on September 30, killing three members of a Palestinian armed group in its first strike on the city centre since the outbreak of the Gaza war last year. " class="block" q:id="te"></picture><!--qv q:id=tf q:key=tEul:hI_1--><p class="caption mb-0 _caption_1r9t6_8" q:key="Gg_6"><span data-testid="caption-decoration" class="decoration _decoration_1r9t6_51" q:key="Gg_0"></span><span data-testid="caption-body" class="body _body_1r9t6_62" q:key="Gg_3"><!--t=tg--> <!----></span><span data-testid="caption-suffix-space" class="space _space_1r9t6_66" q:key="Gg_4"> </span><span class="suffix inline-block tracking-tight _suffix_1r9t6_69" q:key="Gg_5"><!--t=th-->  AFP - Getty Images<!----></span></p><!--/qv--></figure><!--/qv--><!--/qv--><!--qv q:id=ti q:key=5auE:Itwas3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=ti q:key=--><!--/qv--><!--qv q:id=tj q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="tk">It was not immediately clear whether there were deaths or injuries related to the reported strike, nor was it clear that the strike was intentionally aimed at Cola.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=tl q:key=5auE:Cola,4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=tl q:key=--><!--/qv--><!--qv q:id=tm q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="tn">Cola, a stone’s throw from downtown Beirut, is known as a busy neighborhood and is the location of a bus station. This would be the first Israeli strike on the heart of the Lebanese capital during this round of conflict.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=t0 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57414--><!--qv q:id=to q:key=5MJu:card-rcrd57414--><!--qv q:key=r0_14--><div id="rcrd57414" data-pubat="2024-09-30T08:12:16.771Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="tp"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 4:12 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=tq-->Catch up with our latest coverage<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=tr q:key=7CbQ:r0_7--><!--qv q:s q:sref=tr q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=to q:key=--><!--qv q:id=ts q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=tt q:key=5auE:<li><0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=tt q:key=--><!--/qv--><!--qv q:id=tu q:key=JbNX:markupul0--><ul class="feedBody" q:key="Il_0" q:id="tv"><li><a href="https://www.nbcnews.com/meet-the-press/video/sen-mark-kelly-says-he-s-not-ready-to-condition-aid-to-israel-220389445984" target="_blank"><strong>Sen. Mark Kelly says he’s not ready to condition U.S. aid to Israel</strong></a></li><li><a href="https://www.nbcnews.com/news/world/netanyahu-not-biden-setting-agenda-middle-east-rcna173149" target="_blank"><strong>Netanyahu, not Biden, is setting the agenda in the Middle East</strong></a></li></ul><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=to q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57408--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57408"><!--qv q:id=tw q:key=00Of:feed-ad-rcrd57408--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="tx"><div id="div-libra-feed-ad-rcrd57408" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=ty q:key=5MJu:card-rcrd57408--><!--qv q:key=r0_14--><div id="rcrd57408" data-pubat="2024-09-30T07:48:21.322Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="tz"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 3:48 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=u0-->Hamas says its leader in Lebanon killed in strike<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=u1 q:key=7CbQ:r0_7--><!--qv q:s q:sref=u1 q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=ty q:key=--><!--qv q:id=u2 q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=u3 q:key=5auE:Hamas0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=u3 q:key=--><!--/qv--><!--qv q:id=u4 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="u5">Hamas says Fateh Sherif Abu Al-Amin, the group’s leader in Lebanon, has been killed in an Israeli airstrike in the country's south.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=u6 q:key=5auE:Inast1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=u6 q:key=--><!--/qv--><!--qv q:id=u7 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="u8">In a statement posted on Telegram, the Palestinian militant group said Al-Amin was killed alongside his wife and children "in their home in the (Al-Bas) camp."</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=u9 q:key=5auE:While2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=u9 q:key=--><!--/qv--><!--qv q:id=ua q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="ub">While Hamas is based in Gaza, it has long had a presence in Lebanon.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=ty q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=uc q:key=t1gj:FF_5--><div data-testid="load-more-posts-b