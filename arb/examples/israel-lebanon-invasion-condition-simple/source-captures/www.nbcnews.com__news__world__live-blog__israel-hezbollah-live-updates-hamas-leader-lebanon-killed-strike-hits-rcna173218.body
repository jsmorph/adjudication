hs after ceasefire ","Gaza Strip faces continued violence and destruction months after ceasefire",{"primary":"76","seo":"77"},"Gaza’s Health Ministry said that more than 600 Palestinians have been killed since the October ceasefire. NBC News’ Richard Engel went into the Gaza Strip with the IDF to report on the continued violence and destruction. ",{"primary":"79"},{"name":"2k"},{"name":"2m"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/02/1772068950494_now_hallie_gaza_violence_260225.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/02/1772068950494_now_hallie_gaza_violence_260225.vtt",{"srt":"7d","webvtt":"7e"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/now_hallie_gaza_violence_260225/1/abs/index.m3u8",330.066,4169000,{"assetType":"15","format":"16","publicUrl":"7g","height":"18","width":"19","assetDuration":"7h","bitrate":"7i"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/02/1772068950494_now_hallie_gaza_violence_260225_6.mp4",4169621,{"assetType":"1d","format":"1e","publicUrl":"7k","height":"18","width":"19","assetDuration":"7h","bitrate":"7l"},["7j","7m"],{"type":"g","id":"6r","mpxMetadata":"6u","primaryImage":"71","url":"74","duration":"75","sentiment":"r","videoType":"2e","headline":"78","description":"7a","publisher":"7b","source":"7c","closedCaptioning":"7f","videoAssets":"7n"},"mmvo258249285915","258249285915","nbc_sotu_wars_negotiate_260224",{"id":"7q","guid":"7r","externalAdvertiserId":"7r"},"vidimg1451021570",{"primary":"1k","tease":"1k","seo":"1k","social":"1k"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_02/1771991304243_nbc_sotu_wars_negotiate_260224_1920x1080-qqj7qj.jpg",{"primary":"7v"},{"publishedAt":"1o","createdAt":"1o","modifiedAt":"1o"},[],{"id":"7t","headline":"7u","caption":"1k","altText":"1k","url":"7w","encodingFormat":"1k","height":"1k","width":"1k","date":"7x","authors":"7y","source":"1k"},"