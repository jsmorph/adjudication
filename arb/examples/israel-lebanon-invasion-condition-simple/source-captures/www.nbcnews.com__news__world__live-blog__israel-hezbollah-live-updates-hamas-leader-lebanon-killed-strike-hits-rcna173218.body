t="_blank" class="_inlineCta_es1ez_8 flex items-center uppercase" q:key="eJ_2" q:id="1"><span class="_ctaIcon_es1ez_32 inline-flex"><!--qv q:s q:sref=0 q:key=icon--><span style="display: contents" q:slot="icon" q:key="3i9lm4707m8b"><!--cq--><div style="display: contents" q:container="paused" q:version="1.15.0" q:render="ssr" q:base="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/" q:manifest-hash="eimodf" q:instance="efklm2567jd" class="qc📦"><link rel="modulepreload" href="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/q-DrewtzGc.js"><!--qv q:id=0 q:key=dJkd:--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" q:key="YD_0" q:id="1"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#add-to" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><q:template q:slot hidden aria-hidden="true"></q:template><!--/qv--><script type="qwik/json">{"refs":{},"ctx":{},"objs":[],"subs":[]}</script></div><!--/cq--></span><!--/qv--></span><span class="_ctaTxt_es1ez_27"><!--qv q:s q:sref=0 q:key=--><span style="display: contents" q:key="163n9pn6691g">  Add NBC News to Google</span><!--/qv--></span></a><!--/qv--><script type="qwik/json">{"refs":{},"ctx":{},"objs":[],"subs":[]}</script></div><!--/cq--> </div> </div> <div class="byline mb-2 " data-astro-cid-6llnna2y style=""> <div class="updated timestamp tracking-tight" data-astro-cid-6llnna2y style=""> Updated <!--cq--><div style="display: contents" q:container="paused" q:version="1.15.0" q:render="ssr" q:base="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/" q:manifest-hash="eimodf" q:instance="ku1o8d4ji4" class="qc📦"><link rel="modulepreload" href="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/q-DrewtzGc.js"><!--qv q:id=0 q:key=IdqT:--><time dateTime="2024-10-01T05:07:43.539Z" on-document:-l-i-b-r-a_-l-a-t-e-s-t_-c-a-r-d-s_-u-p-d-a-t-e-d_-e-v-e-n-t="q-9v1TM2fS.js#s_7ahy7323P2M[0 1]" q:key="iA_0" q:id="1">October 01, 2024, 1:07 AM EDT</time><q:template q:slot hidden aria-hidden="true"></q:template><!--/qv--><script type="qwik/json">{"refs":{"1":"0! 1"},"ctx":{"0":{"h":"5 0!","s":"1"}},"objs":[{"initLatestCardDate":"2","data-astro-cid-6llnna2y":"3"},"\u00122","2024-10-01T05:07:43.539Z",true,"\u00111 @0","\u0002q-9v1TM2fS.js#s_IdqT1xRhffk"],"subs":[["0 #0 initLatestCardDate"],["0 #0","1 #1 4 #0 dateTime"]]}</script><script q:func="qwik/json">document["qFuncs_ku1o8d4ji4"]=[(p0,)=>(p0.value)]</script><script>(window.qwikevents||(window.qwikevents=[])).push("LIBRA_LATEST_CARDS_UPDATED_EVENT")</script></div><!--/cq-->  </div>  <div class="names" data-astro-cid-6llnna2y style=""> By  NBC News </div> </div>  <!--cq--><div style="display: contents" q:container="paused" q:version="1.15.0" q:render="ssr" q:base="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/" q:manifest-hash="eimodf" q:instance="yscoac7sm7h" class="qc📦"><link rel="modulepreload" href="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/q-DrewtzGc.js"><!--qv q:id=0 q:key=jP3B:--><!--qv q:key=0Z_3--><!--qv q:id=1 q:key=5auE:<stro0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=1 q:key=--><!--/qv--><!--qv q:id=2 q:key=JbNX:markupp0--><p class="mainBody" q:key="Il_0" q:id="3"><strong><em>Coverage on this live blog has ended. </em></strong><a href="https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-idf-ground-operation-lebanon-rcna173389" target="_blank"><strong><em>Follow live updates here.</em></strong></a></p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=4 q:key=5auE:fallback-id-1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=4 q:key=--><!--/qv--><!--qv q:id=5 q:key=JbNX:markupbr1--><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=6 q:key=5auE:ncwd000999--><!--qv q:id=7 q:key=ut0k:ncwd000999--><section data-testid="summary-box-qwik" class="summary _summary_l3zna_8 mainBody" q:key="jS_2"><div class="relative _inner_l3zna_81"><h2 class="mb-1 relative _headline_l3zna_88" q:key="jS_0"><!--t=8-->What we know<!----></h2><ul class="mb-0 text-lg" q:key="jS_1"><!--qv q:id=9 q:key=JbNX:Israe0--><li class="mb-2" q:key="Il_0" q:id="a">Israeli soldiers have started <a href="https://www.nbcnews.com/news/world/israel-lebanon-ground-invasion-rcna172913" target="_blank">&quot;targeted&quot; ground operations inside Lebanon</a>, the IDF said. Israeli officials notified the U.S. that the incursion would be limited in scope, scale and duration. The operation would aim to push Hezbollah forces farther away from the Israeli border. </li><!--/qv--><!--qv q:id=b q:key=JbNX:Israe1--><li class="mb-2" q:key="Il_0" q:id="c">Israel has expanded its attacks on Iran-backed militant groups across the region after <a href="https://www.nbcnews.com/news/world/live-blog/lebanon-live-updates-rcna173122" target="_blank">the killing of the powerful Hezbollah leader Hassan Nasrallah</a>. </li><!--/qv--><!--qv q:id=d q:key=JbNX:Israe2--><li class="mb-2" q:key="Il_0" q:id="e">Israel has also launched small special forces operations into southern Lebanon ahead of a potential ground offensive, an Israeli official told NBC News. Yoav Gallant, Israel&#x27;s defense minister, said the “next phase in the war against Hezbollah will begin soon.” </li><!--/qv--><!--qv q:id=f q:key=JbNX:Elsew3--><li class="mb-2" q:key="Il_0" q:id="g">Elsewhere, Prime Minister Benjamin Netanyahu warned in comments directed at Iran that nowhere in the Middle East was beyond Israel’s reach two days after Israel killed Nasrallah.</li><!--/qv--><!--qv q:id=h q:key=JbNX:Thehe4--><li class="mb-2" q:key="Il_0" q:id="i">The head of the U.N. Palestinian refugee agency, UNRWA, denied knowing that its employee Fateh Sherif Abu el-Amin was a Hamas commander in Lebanon. The head of Hamas’ Lebanon branch was killed along with family members in an Israeli strike, the group said earlier. </li><!--/qv--><!--qv q:id=j q:key=JbNX:Presi5--><li class="mb-2" q:key="Il_0" q:id="k">President <a href="https://www.nbcnews.com/news/world/netanyahu-not-biden-setting-agenda-middle-east-rcna173149" target="_blank">Joe Biden</a> called for a cease-fire “right now” when he was asked whether he was comfortable with Israeli plans to invade Lebanon. “I’m more aware than you might know, and I’m comfortable with them stopping,” he told reporters at the White House. </li><!--/qv--></ul></div></section><!--/qv--><!--/qv--><!--qv q:id=l q:key=5auE:fallback-id-3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=l q:key=--><!--/qv--><!--qv q:id=m q:key=JbNX:markupbr3--><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=n q:key=5auE:rctx11409--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><q:template q:slot hidden aria-hidden="true"></q:template><!--/qv--><script type="qwik/json">{"refs":{},"ctx":{},"objs":[],"subs":[]}</script></div><!--/cq-->  <!--cq--><div style="display: contents" q:container="paused" q:version="1.15.0" q:render="ssr" q:base="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/" q:manifest-hash="eimodf" q:instance="k8r0uxfh1tb" class="qc📦"><link rel="modulepreload" href="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/q-CkwO6Ccz.js"><link rel="preload" href="https://nodeassets.nbcnews.com/libra/assets/DuQooE5o-bundle-graph.json" as="fetch" crossorigin="anonymous"><script type="module" async>let b=fetch("https://nodeassets.nbcnews.com/libra/assets/DuQooE5o-bundle-graph.json");import("https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/q-CkwO6Ccz.js").then(({l})=>l("https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/",b));</script><link rel="modulepreload" href="https://nodeassets.nbcnews.com/libra/libra-assets/qwik-assets/q-DrewtzGc.js"><!--qv q:id=0 q:key=93kk:--><!--qv q:key=FF_6--><div data-testid="feed-qwik" class="_feed_1ykwf_8 mainFeed relative" on:qvisible="q-CV7VKWvn.js#_hW[0]" on-document:qidle="q-CV7VKWvn.js#_hW[1]" q:id="1"><!--qv q:id=2 q:key=0exa:FF_2--><div class="feedControls grid sticky content-center _feedControls_lpwtq_8" q:key="GR_1"><!--qv q:s q:sref=2 q:key=--><!--qv q:id=3 q:key=JTpd:FF_0--><button type="button" data-testid="pill" aria-label="See new posts" class="flex items-center justify-center _pill_11wus_8 _feedButton_1ykwf_29 _feedButtonHidden_1ykwf_45" on:click="q-CV7VKWvn.js#s_ZPs4Q7K0piQ[0 1 2 3 4 5 6]" on:animationend="q-CV7VKWvn.js#s_93XH6vp8CPo[7]" q:key="3i_1" q:id="4"><!--qv q:id=5 q:key=dJkd:3i_0--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_icon_11wus_43" q:key="YD_0" q:id="6"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#back-to-top" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--><span class="lh-title _countLabel_11wus_37"> NEW UPDATES</span></button><!--/qv--><!--qv q:id=7 q:key=YWgF:FF_1--><button type="button" data-testid="back-to-top-button" title="Back to Top" class="flex justify-center items-center p-0 _backToTop_1npvn_8 _feedButton_1ykwf_29 _hidden_1npvn_43" on:click="q-Bg28M04_.js#s_LlrVFLEgFI0[0]" on:qvisible="q-Bg28M04_.js#_hW[1]" q:key="p3_1" q:id="8"><!--qv q:id=9 q:key=dJkd:p3_0--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="34" height="34" class="backToTopIcon" q:key="YD_0" q:id="a"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#back-to-top" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></button><!--/qv--><!--/qv--></div><!--/qv--><div class="cardList _cardList_1ykwf_19" q:id="b"><!--qv q:key=feed-item-rcrd57634--><!--qv q:id=c q:key=5MJu:card-rcrd57634--><!--qv q:key=r0_14--><div id="rcrd57634" data-pubat="2024-10-01T05:07:43.539Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="d"><div class="timestamp _timestamp_ghmuq_70 flex items-center">577d ago / 1:07 AM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=e-->Japan has &#39;grave concern&#39; over Israel&#39;s incursion<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=f q:key=7CbQ:r0_7--><!--qv q:s q:sref=f q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=c q:key=--><!--qv q:id=g q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=h q:key=5auE:Japan0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=h q:key=--><!--/qv--><!--qv q:id=i q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="j">Japan would much rather see a cease-fire between Israel and foes to its west and north than the limited ground incursion targeting Hezbollah fighters in Lebanon, Japan’s chief cabinet secretary said at his daily news briefing.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=k q:key=5auE:“Amid1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=k q:key=--><!--/qv--><!--qv q:id=l q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="m">“Amidst calls by the international community for restraint for all parties concerned ... Israel conducted a ground operation in Lebanon,” Yoshimasa Hayashi said. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=n q:key=5auE:“Japa2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=n q:key=--><!--/qv--><!--qv q:id=o q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="p">“Japan expresses its grave concern,” he added.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=q q:key=5auE:Yoshi3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=q q:key=--><!--/qv--><!--qv q:id=r q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="s">Yoshimasa called for Israel and its enemies to lay down their arms and perform the following: do earnest work on a diplomatic solution, show restraint on the battlefield, implement measures to prevent civilian casualties, comply with international humanitarian laws and implement a United Nations resolution, known as 1701, that calls on peacekeeping forces and Lebanese soldiers to maintain a zone between Israel and Hezbollah fighters.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=t q:key=5auE:About4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=t q:key=--><!--/qv--><!--qv q:id=u q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="v">About 50 Japanese citizens are in Lebanon, Hayashi said. The country is prepared to do whatever is needed to get them out, he said, including using Self-Defense Force aircraft for evacuations.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=c q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57580--><!--qv q:id=w q:key=5MJu:card-rcrd57580--><!--qv q:key=r0_14--><div id="rcrd57580" data-pubat="2024-10-01T04:08:09.539Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="x"><div class="timestamp _timestamp_ghmuq_70 flex items-center">577d ago / 12:08 AM EDT</div><div class="_authorsContainer_ghmuq_133"><!--qv q:id=y q:key=7CbQ:r0_7--><!--qv q:s q:sref=y q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=w q:key=--><!--qv q:id=z q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=10 q:key=5auE:mmvo220498501747--><!--qv q:id=11 q:key=q9JX:Rz_2--><!--qv q:id=13 q:key=C4ZI:Bn_0--><div data-testid="jwplayer-with-overlay" class="_jwPlayerWithOverlayContainer_1calw_2 grid-stack-container jwplayerEmbed mb-10 mt-4 feedBody" on-document:qinit="q-B6-FC0L-.js#_hW[0]" on-document:auth-update="q-B6-FC0L-.js#s_4eLncuS6TBY[1]" on-document:qidle="q--_M_9sWK.js#_hW[2]" q:key="GH_17" q:id="14"><div class="_overlay_1calw_48"><div class="_overlayBackgroundGradient_1calw_217 _fadeOutWithControls_1calw_224"></div><div class="_overlayMeta_1calw_104"><div class="_title_1calw_114 _fadeOutWithControls_1calw_224" q:key="GH_5"><!--qv q:id=15 q:key=7CbQ:GH_4--><a href="https://www.nbcnews.com/video/video-shows-smoke-and-explosions-in-distance-at-beirut-airport-220498501747" target="_self" data-testid="link-if" class="_titleLink_1calw_115" q:id="16"><!--qv q:s q:sref=15 q:key=--><!--t=17-->Video shows smoke and explosions in distance at Beirut airport<!----><!--/qv--></a><!--/qv--></div><div class="_timestamp_1calw_135 _fadeOutWithControls_1calw_224" q:key="GH_6"><!--t=18-->01:11<!----></div></div><div class="_shareContainer_1calw_140 _fadeOutWithControls_1calw_224"><button id="jwplayer-l5biiz-C4ZIm9X4sDY-12-share-options-button" aria-controls="jwplayer-l5biiz-C4ZIm9X4sDY-12-share-options" aria-expanded="false" aria-label="More options" aria-haspopup="menu" class="_threeDotsButton_1calw_145" on:click="q--_M_9sWK.js#s_Et0810rY3jo[0 1]" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="19"><div class="_threeDotsIcon_1calw_159" q:key="GH_7"></div></button><ul id="jwplayer-l5biiz-C4ZIm9X4sDY-12-share-options" aria-labelledby="jwplayer-l5biiz-C4ZIm9X4sDY-12-share-options-button" role="menu" aria-hidden="true" class="_shareButtons_1calw_182" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="1a"><li role="none"><a href="https://www.facebook.com/sharer/sharer.php?u=https://www.nbcnews.com/video/video-shows-smoke-and-explosions-in-distance-at-beirut-airport-220498501747" role="menuitem" aria-label="Share on Facebook" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-CL3qfk7x.js#s_0C0xTPxyHBQ" q:id="1b"><!--qv q:id=1c q:key=dJkd:GH_9--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="1d"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#facebook" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="https://x.com/intent/post?text=Video%20shows%20smoke%20and%20explosions%20in%20distance%20at%20Beirut%20airport&amp;url=https://www.nbcnews.com/video/video-shows-smoke-and-explosions-in-distance-at-beirut-airport-220498501747&amp;original_referer=https://www.nbcnews.com/video/video-shows-smoke-and-explosions-in-distance-at-beirut-airport-220498501747" role="menuitem" aria-label="Share on X (Twitter)" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-JtsO08fV.js#s_h6hvWqYCELA" q:id="1e"><!--qv q:id=1f q:key=dJkd:GH_10--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="1g"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#x" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li><li role="none"><a href="mailto:?subject=Video shows smoke and explosions in distance at Beirut airport&amp;body=https://www.nbcnews.com/video/video-shows-smoke-and-explosions-in-distance-at-beirut-airport-220498501747" role="menuitem" aria-label="Share via Email" tabIndex="-1" class="_shareLink_1calw_199" on:click="q-C0GiLlW_.js#s_KE0wDxvLlrA" q:id="1h"><!--qv q:id=1i q:key=dJkd:GH_11--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" class="_shareLinkIcon_1calw_209" q:key="YD_0" q:id="1j"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#email" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></a></li></ul></div></div><!--qv q:key=GH_13--><button aria-label="play video" class="_clickToPlayButton_1calw_254 flex-center" on:click="q--_M_9sWK.js#s_fXS03dk2qiE[0 1 2 3 4 5]" q:id="1k"><div class="_playIconContainer_1calw_20 flex-center"><!--qv q:id=1l q:key=dJkd:GH_12--><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor" focusable="false" width="20" height="20" q:key="YD_0" q:id="1m"><use href="/libra-assets/astro-assets/sprite.7a8eb198.svg#play" xmlns:xlink="http://www.w3.org/1999/xlink"></use></svg><!--/qv--></div></button><!--/qv--><!--qv q:id=1n q:key=HvIT:GH_15--><figure data-testid="figure-component" class="figure _figure_1wrxx_8 _posterFrame_1calw_282 mb-0" q:key="hI_2"><picture class="block" q:id="1o"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1120,h_630/mpx/2704722219/2024_10/f_mo_beirut_airport_explosions_240930.00_00_08_25.Still001-ughiuv.avif" media="(width &gt;= 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_560,h_315/mpx/2704722219/2024_10/f_mo_beirut_airport_explosions_240930.00_00_08_25.Still001-ughiuv.avif" media="(width &gt;= 1000px) and (resolution &lt; 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_1560,h_878/mpx/2704722219/2024_10/f_mo_beirut_airport_explosions_240930.00_00_08_25.Still001-ughiuv.avif" media="(width &lt; 1000px) and (min-resolution: 2dppx)"><source srcset="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,q_auto:eco,w_780,h_439/mpx/2704722219/2024_10/f_mo_beirut_airport_explosions_240930.00_00_08_25.Still001-ughiuv.avif" media="(width &lt; 1000px) and (resolution &lt; 2dppx)"><img src="https://media-cldnry.s-nbcnews.com/image/upload/c_fill,g_auto,w_780,h_439/mpx/2704722219/2024_10/f_mo_beirut_airport_explosions_240930.00_00_08_25.Still001-ughiuv.jpg" width="780" height="439" loading="lazy" fetchPriority="low" alt="Video shows smoke and explosions in distance at Beirut airport" class="block" q:id="1p"></picture></figure><!--/qv--></div><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=1q q:key=5auE:Smoke1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=1q q:key=--><!--/qv--><!--qv q:id=1r q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="1s">Smoke can be seen in the distance as explosions happen at Beirut-Rafic Hariri International Airport shortly after officials said Israel’s ground incursion into Lebanon had begun.</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=w q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57593--><!--qv q:id=1t q:key=5MJu:card-rcrd57593--><!--qv q:key=r0_14--><div id="rcrd57593" data-pubat="2024-10-01T02:47:00.622Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="1u"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 10:47 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=1v-->Critics question Israel&#39;s description of ground operation<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=1w q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/doha-madani-ncpn915866" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="1x"><!--qv q:s q:sref=1w q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=1t q:key=--><!--qv q:id=1y q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=1z q:key=5auE:Somec0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=1z q:key=--><!--/qv--><!--qv q:id=20 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="21">Some critics have expressed skepticism about the description of Israel’s ground operation in Lebanon as “targeted,” recalling similar representations of Israel’s ground assault into Rafah in May. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=22 q:key=5auE:<ahre1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=22 q:key=--><!--/qv--><!--qv q:id=23 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="24"><a href="https://www.nbcnews.com/news/world/israel-stand-alone-netanyahu-biden-rafah-weapons-hamas-rcna151608" target="_blank">Biden had threatened to withhold arms</a> from Israel if there was a major ground offensive in Rafah but later said <a href="https://www.nbcnews.com/news/world/israel-rafah-strike-ground-assault-dont-cross-bidens-red-line-rcna154428" target="_blank">the offensive did not cross his administration's “red line”</a> because it was limited to a strategic area in order to fight Hamas.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=25 q:key=5auE:InJul2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=25 q:key=--><!--/qv--><!--qv q:id=26 q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="27">In July, <a href="https://www.nbcnews.com/news/world/israel-hamas-war-rafah-destroyed-tunnels-idf-visit-cease-fire-talks-rcna160651" target="_blank">NBC News was able to visit the city</a> and documented a devastated ghost town. Buildings were completely leveled, and there was almost no one to be found, whereas just weeks before it was home to more than 1 million Palestinians.  </p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=1t q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57499--><!--qv q:id=28 q:key=5MJu:card-rcrd57499--><!--qv q:key=r0_14--><div id="rcrd57499" data-pubat="2024-10-01T01:24:32.856Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="29"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 9:24 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=2a-->British families of Israeli hostages tell Netanyahu to make a deal for their return<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=2b q:key=7CbQ:r0_7--><a href="https://www.nbcnews.com/author/mirna-alsharif-ncpn1297517" target="_self" data-testid="link-if" class="_linkedAuthor_ghmuq_130" q:id="2c"><!--qv q:s q:sref=2b q:key=--><!--/qv--></a><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=28 q:key=--><!--qv q:id=2d q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=2e q:key=5auE:Briti0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=2e q:key=--><!--/qv--><!--qv q:id=2f q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="2g">British families of Israeli hostages had a message for Prime Minister Benjamin Netanyahu at a London news conference today: make a deal so their loved ones can come home.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=2h q:key=5auE:“Myme1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=2h q:key=--><!--/qv--><!--qv q:id=2i q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="2j">“My message to him is to listen to the people of Israel and get that deal,” said Sharone Lifschitz, whose father, Oded, 84, remains in captivity in Gaza after he was captured on Oct. 7. Lifschitz's mother, Yocheved, was freed last year as part of an exchange for Palestinian prisoners.  </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=2k q:key=5auE:“Idon2--><!--qv q:key=Rz_1--><!--qv q:s q:sref=2k q:key=--><!--/qv--><!--qv q:id=2l q:key=JbNX:markupp2--><p class="feedBody" q:key="Il_0" q:id="2m">“I don't think that he should wait until after the election to reach a deal. There is the possibility of a deal now, and what is missing is the will of both sides,” she added. </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=2n q:key=5auE:Steph3--><!--qv q:key=Rz_1--><!--qv q:s q:sref=2n q:key=--><!--/qv--><!--qv q:id=2o q:key=JbNX:markupp3--><p class="feedBody" q:key="Il_0" q:id="2p">Stephen Brisley, whose brother-in-law Eli Sharabi, 52, remains in Gaza, called on Netanyahu to “become statesmanlike and do the right thing and secure a deal.” </p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=2q q:key=5auE:“Tool4--><!--qv q:key=Rz_1--><!--qv q:s q:sref=2q q:key=--><!--/qv--><!--qv q:id=2r q:key=JbNX:markupp4--><p class="feedBody" q:key="Il_0" q:id="2s">“Too long has passed with the deal in various iterations over the last six or eight months," Brisley said. "It’s unfathomable to me that it’s been impossible to get one of those deals over the line."</p><!--/qv--><!--/qv--><!--/qv--><div id="bodyEnd" data-testid="markupembeds-bodyend"></div><!--/qv--><!--/qv--><!--/qv--></div></div><!--qv q:s q:sref=28 q:key=replies--><!--/qv--><!--/qv--><!--/qv--><!--/qv--><!--qv q:key=feed-item-rcrd57506--><div data-testid="feed-ad-qwik" class="sm-only:hidden md:hidden" q:key="feed-ad-wrapper-rcrd57506"><!--qv q:id=2t q:key=00Of:feed-ad-rcrd57506--><!--qv q:key=8z_1--><div data-ad-label="Advertisement" data-testid="ad-slot-component" class="adSlot col-bleed overflow-hidden mx-auto _adSlot_s90ez_8 mb-6 _feedAd_1ykwf_26 boxinline" on-document:qinit="q-DsrYXPsO.js#_hW[0]" on-document:auth-update="q-DsrYXPsO.js#s_nGUOX1fLPWM[1]" on-window:mps-loaded="q-AV1mBZyF.js#s_6hNYGwo30Rs[2]" q:id="2u"><div id="div-libra-feed-ad-rcrd57506" data-render-on-view="true" data-slot="boxinline" data-sizes="[[[1000,1],[]],[[758,1],[[300,250],[700,50],[5,5],[728,90],[360,360]]],[[0,0],[[300,250],[700,50],[5,5],[360,360]]]]" data-active-tab="true" data-offset-viewport="50" data-loadset="0" data-mps="true" data-targeting="{}" class="mps-slot text-center _mpsSlot_s90ez_25 "></div></div><!--/qv--><!--/qv--></div><!--qv q:id=2v q:key=5MJu:card-rcrd57506--><!--qv q:key=r0_14--><div id="rcrd57506" data-pubat="2024-10-01T00:18:31.034Z" data-testid="card-qwik" class="card relative _card_ghmuq_8" on:qvisible="q-Crk00-Ea.js#_hW[0]" q:id="2w"><div class="timestamp _timestamp_ghmuq_70 flex items-center">578d ago / 8:18 PM EDT</div><h2 class="headline _headline_ghmuq_114" q:key="r0_1"><!--t=2x-->World is &#39;safer&#39; without Hezbollah leader, Blinken says<!----></h2><div class="_authorsContainer_ghmuq_133"><!--qv q:id=2y q:key=7CbQ:r0_7--><!--qv q:s q:sref=2y q:key=--><!--/qv--><!--/qv--></div><div data-icid="liveBlogCardLink" class="_body_ghmuq_175"><!--qv q:s q:sref=2v q:key=--><!--qv q:id=2z q:key=jP3B:FF_3--><!--qv q:key=0Z_3--><!--qv q:id=30 q:key=5auE:Secre0--><!--qv q:key=Rz_1--><!--qv q:s q:sref=30 q:key=--><!--/qv--><!--qv q:id=31 q:key=JbNX:markupp0--><p class="feedBody" q:key="Il_0" q:id="32">Secretary of State Antony Blinken called Hezbollah leader Hassan Nasrallah a “brutal terrorist” today and said Lebanon, the Middle East and the world are safer without him.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=33 q:key=5auE:Speak1--><!--qv q:key=Rz_1--><!--qv q:s q:sref=33 q:key=--><!--/qv--><!--qv q:id=34 q:key=JbNX:markupp1--><p class="feedBody" q:key="Il_0" q:id="35">Speaking at the D-ISIS Ministerial meeting at the State Department, Blinken also underscored that pursuing diplomacy was the only route to bring stability to the region.</p><!--/qv--><!--/qv--><!--/qv--><!--qv q:id=36 q:key=5auE:mmvo220459589958--><!--qv q:id=37 q:key=q9JX:Rz_2--><!--qv q:id=39 q:key=C4ZI:Bn_0--><div data-testid="jwplayer-with-overlay" class="_jwPlayerWithOverlayContainer_1calw_2 grid-stack-container jwplayerEmbed mb-10 mt-4 feedBody" on-document:qinit="q-B6-FC0L-.js#_hW[0]" on-document:auth-update="q-B6-FC0L-.js#s_4eLncuS6TBY[1]" on-document:qidle="q--_M_9sWK.js#_hW[2]" q:key="GH_17" q:id="3a"><div class="_overlay_1calw_48"><div class="_overlayBackgroundGradient_1calw_217 _fadeOutWithControls_1calw_224"></div><div class="_overlayMeta_1calw_104"><div class="_title_1calw_114 _fadeOutWithControls_1calw_224" q:key="GH_5"><!--qv q:id=3b q:key=7CbQ:GH_4--><a href="https://www.nbcnews.com/video/blinken-reacts-to-hezbollah-leaders-death-says-world-is-safer-without-him-220459589958" target="_self" data-testid="link-if" class="_titleLink_1calw_115" q:id="3c"><!--qv q:s q:sref=3b q:key=--><!--t=3d-->Blinken reacts to Hezbollah leaders death, says world is ‘safer without him’<!----><!--/qv--></a><!--/qv--></div><div class="_timestamp_1calw_135 _fadeOutWithControls_1calw_224" q:key="GH_6"><!--t=3e-->00:57<!----></div></div><div class="_shareContainer_1calw_140 _fadeOutWithControls_1calw_224"><button id="jwplayer-l5biiz-C4ZIm9X4sDY-38-share-options-button" aria-controls="jwplayer-l5biiz-C4ZIm9X4sDY-38-share-options" aria-expanded="false" aria-label="More options" aria-haspopup="menu" class="_threeDotsButton_1calw_145" on:click="q--_M_9sWK.js#s_Et0810rY3jo[0 1]" on:keydown="q--_M_9sWK.js#s_T6vt0LKi0pM[0]" q:id="3f"><div class="_threeDotsIcon_1calw_159" q:key="GH_7"></div></button><ul id="jwplayer-l5biiz-C4ZIm9X4sDY-38-share-options" aria-labelledby="jwplayer-l5biiz-C4ZIm9X4sDY-38-share-opt