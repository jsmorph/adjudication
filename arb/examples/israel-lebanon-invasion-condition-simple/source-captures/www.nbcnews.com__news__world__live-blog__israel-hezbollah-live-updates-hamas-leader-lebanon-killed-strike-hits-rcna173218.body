dnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777589942479_nn_vng_patient_battles_to_get_heart_surgery_covered_260430.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777589942479_nn_vng_patient_battles_to_get_heart_surgery_covered_260430.vtt",{"srt":"13f","webvtt":"13g"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nn_vng_patient_battles_to_get_heart_surgery_covered_260430/1/abs/index.m3u8",211.112,4197000,{"assetType":"gy","format":"gz","publicUrl":"13i","height":"h1","width":"h2","assetDuration":"13j","bitrate":"13k"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/04/1777589942479_nn_vng_patient_battles_to_get_heart_surgery_covered_260430_6.mp4",4197154,{"assetType":"h6","format":"h7","publicUrl":"13m","height":"h1","width":"h2","assetDuration":"13j","bitrate":"13n"},["13l","13o"],{"type":"gb","id":"12u","mpxMetadata":"12x","primaryImage":"134","url":"137","duration":"138","sentiment":"i5","videoType":"i6","headline":"13a","description":"13c","publisher":"13d","source":"13e","closedCaptioning":"13h","videoAssets":"13p"},["101","10z","11w","12t","13q"],{"headline":"z4","videos":"13r"},{"id":"xz","type":"gb","duration":"y0","dateBroadcast":"y1","date":"y4","liveVideoStatus":"gg","playable":"e7","mpxMetadata":"y7","sentiment":"gk","videoType":"i6","contentRules":"y9","headline":"yb","description":"yd","url":"yg","closedCaptioning":"yj","videoAssets":"yr","primaryImage":"yy","teaseImage":"z3","associatedVideoPlaylist":"13s"},{"type":"g9","video":"13t"},"Israel Defense Forces troops have begun a ground incursion into Lebanon, Israel said, adding that the operation will be limited in scope.",{"type":"eb","element":"ec","html":"13v"},"\"A few hours ago, the IDF began limited, localized, and targeted ground raids based on precise intelligence against Hezbollah terrorist targets and infrastructure in southern Lebanon,\" the IDF said in a statement.",{"type":"eb","element":"ec","html":"13x"},"The declaration of a limited mission comes amid fear of a full-on regional war. Hezbollah militants, who energized their attacks on Israel after Hamas militants' Oct. 7 terrorist attack on the country, are backed by Iran.",{"type":"eb","element":"ec","html":"13z"},"The IDF said the incursion is meant to protect Israeli citizens who live along the border with Lebanon.",{"type":"eb","element":"ec","html":"141"},"<a href=\"https://www.nbcnews.com/news/world/israel-lebanon-ground-invasion-rcna172913\" target=\"_blank\"><strong><em>Read the full story here. </em></strong></a>",{"type":"eb","element":"ec","html":"143"},["13u","13w","13y","140","142","144"],"Read the full story here. ",["13v","13x","13z","141","146"],{"markupAndEmbeds":"145","text":"147"},"2024-09-30T23:06:49.163Z","2024-10-01T00:08:11.272Z",{"createdAt":"149","publishedAt":"149","modifiedAt":"14a"},"Israel Defense Forces troops have begun a ground incursion into Lebanon, Israel said, adding that the operation will be limited in scope. \"A few hours ago, the",{"primary":"14c","seo":"14c"},"Israel says it has begun 'limited, localized and targeted' ground incursion",{"primary":"14e","seo":"14e","social":"14e"},{"style":"fg"},"https://www.nbcnews.com/news/world/live-blog/israel-hezbollah-live-updates-hamas-leader-lebanon-killed-strike-hits-rcna173218#rcrd57551",{"primary":"14h"},[],{"markupAndEmbeds":"14j"},[],{"markupAndEmbeds":"14l"},[],{"markupAndEmbeds":"14n"},{"analysis":"14k","citations":"14m","verdict":"14o"},[],{"nativeAd":"e2","id":"x2","authors":"xy","isHeadlineHidden":"e2","content":"148","date":"14b","description":"14d","headline":"14f","presentation":"14g","primaryImage":"eh","teaseImage":"eh","url":"14i","reportingFrom":"eh","factCheckContent":"14p","replies":"14q"},"rcrd57546","Courtney Kube is a correspondent covering national security and the military for the NBC News Investigative Unit.",{"type":"eb","element":"ec","html":"14t"},["14u"],"ncpn3621",[],"Courtney Kube","https://media-cldnry.s-nbcnews.com/image/upload/newscms/2025_26/3694246/250624-courtney-kube.jpg",{"primary":"14z"},{"altText":"14y","height":"p3","url":"150","width":"p3"},{"name":"em","subType":"eh","type":"en"},"@ckubeNBC",{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"153","youtube":"eh"},"https://www.nbcnews.com/author/courtney-kube-ncpn3621","courtney-kube-ncpn3621",{"canonical":"155","primary":"155","slug":"156"},[],[],[],{"bio":"14v","liveBlogShortBio":"eg","shortBio":"eh","id":"14w","email":"eh","jobTitle":"14x","name":"14y","primaryImage":"151","publisher":"152","socialMediaProfiles":"154","subType":"eh","type":"eq","url":"157","worksFor":"eh","experience":"158","educationAndExpertise":"159","awards":"15a"},"Carol E. Lee is the Washington managing editor.",{"type":"eb","element":"ec","html":"15c"},["15d"],"Carol E. Lee is the Washington managing editor.","ncpn788956","Carol.Lee@nbcuni.com",[],"Carol E. Lee","Image: Carol Lee","https://media-cldnry.s-nbcnews.com/image/upload/newscms/2020_02/3181656/carol-lee-circle-byline-template.jpg",{"primary":"15l"},{"altText":"15k","height":"p3","url":"15m","width":"p3"},{"name":"em","subType":"eh","type":"en"},"@carolelee",{"email":"eh","facebook":"eh","instagram":"eh","pinterest":"eh","snapchat":"eh","twitter":"15p","youtube":"eh"},"https://www.nbcnews.com/author/carol-e-lee-ncpn788956","carol-e-lee-ncpn788956",{"canonical":"15r","primary":"15r","slug":"15s"},[],[],[],{"bio":"15e","liveBlogShortBio":"15f","shortBio":"15f","id":"15g","email":"15h","jobTitle":"15i","name":"15j","primaryImage":"15n","publisher":"15o","socialMediaProfiles":"15q","subType":"eh","type":"eq","url":"15t","worksFor":"eh","experience":"15u","educationAndExpertise":"15v","awards":"15w"},["15b","15x"],"mmvo220485701804","PT2M29S","Mon Sep 30 2024 22:48:34 GMT+0000 (UTC)","2024-09-30T22:48:28.000Z","2024-09-30T22:48:27.000Z",{"publishedAt":"162","createdAt":"163"},"220485701804","now_hallie_lebanon_israeli_groundinc_240930",{"id":"165","guid":"166","externalAdvertiserId":"166"},"original",[],{"contentClassifications":"169"},"Israel incursion in Lebanon has begun, officials say",{"primary":"eg","seo":"16b"},"According to two U.S. officials, Israeli ground forces have begun the process of crossing the border into southern Lebanon. The officials said the U.S. does not have independent confirmation, but the timing tracks with what the Israelis notified the U.S. it had planned.",{"primary":"16d"},"https://www.nbcnews.com/now/video/israel-incursion-in-lebanon-has-begun-officials-say-220485701804","israel-incursion-in-lebanon-has-begun-officials-say-220485701804",{"canonical":"16f","primary":"16f","slug":"16g"},"https://nbcnewsdigital-static.nbcuni.com/media/captions/NBC_News_Digital/2024/09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930.srt","https://nbcnewsdigital-static.nbcuni.com/media/captions/NBC_News_Digital/2024/09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930.vtt",{"srt":"16i","webvtt":"16j"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/now_hallie_lebanon_israeli_groundinc_240930/1/abs/index.m3u8",149.217,4012000,{"assetType":"gy","format":"gz","publicUrl":"16l","height":"h1","width":"h2","assetDuration":"16m","bitrate":"16n"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2024/09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930_6.mp4",4012648,{"assetType":"h6","format":"h7","publicUrl":"16p","height":"h1","width":"h2","assetDuration":"16m","bitrate":"16q"},["16o","16r"],"vidimg2685973970",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2024_09/1727736491100_now_hallie_lebanon_israeli_groundinc_240930_1920x1080-d9o77m.jpg",{"primary":"16v"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"16t","headline":"16u","caption":"eh","altText":"eh","url":"16w","encodingFormat":"eh","height":"eh","width":"eh","date":"16x","authors":"16y","source":"eh"},{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},{"primary":"16v"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"16t","headline":"170","caption":"eh","altText":"eh","url":"171","encodingFormat":"eh","height":"eh","width":"eh","date":"172","authors":"173","source":"eh"},"Israel-Hamas war",{"primary":"175"},"mmvo262085701968","262085701968","now_hallie_israel_gaza_war_260424",{"id":"178","guid":"179","externalAdvertiserId":"179"},"vidimg2648115398",{"primary":"eh","tease":"eh","seo":"eh","social":"eh"},"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_04/1777071686851_now_hallie_israel_gaza_war_260424_S3_1920x1080-c5t5hk.jpg",{"primary":"17d"},{"publishedAt":"eg","createdAt":"eg","modifiedAt":"eg"},[],{"id":"17b","headline":"17c","caption":"eh","altText":"eh","url":"17e","encodingFormat":"eh","height":"eh","width":"eh","date":"17f","authors":"17g","source":"eh"},"https://www.nbcnews.com/video/gazans-still-living-in-rubble-six-months-into-israel-hamas-ceasefire-262085701968","gazans-still-living-in-rubble-six-months-into-israel-hamas-ceasefire-262085701968",{"canonical":"17i","primary":"17i","slug":"17j"},"PT3M7S","Palestinians in Gaza still living in rubble six months into Israel-Hamas ceasefire","Gazans still living in rubble six months into Israel-Hamas ceasefire",{"primary":"17m","seo":"17n"},"Six months into the Israel-Hamas ceasefire, Palestinians in the Gaza Strip continue living in unsanitary conditions and struggle to rebuild. Mother Ezyia Abu Haya tells NBC News the reality of daily life in Gaza. Matt Bradley reports.",{"primary":"17p"},{"name":"em"},"Hallie Jackson NOW",{"name":"17s"},"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777071686851_now_hallie_israel_gaza_war_260424.srt","https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/04/1777071686851_now_hallie_israel_gaza_war_260424.vtt",{"srt":"