<script type="text/javascript">
	if(window.jQuery) {
		jQuery(document).ready(function(){
			jQuery('.nav__countries_letter').prev().addClass('nav__countries_last');
			jQuery('#country-search').on('change paste keyup', function(){
				//alert(jQuery('#country-search').val());
				jQuery('.nav__country').removeClass('nav__countries_last');
				var state_country_search = jQuery('#country-search').val().toLowerCase();
				jQuery('.nav__countries_letter').hide();
				if ( jQuery('#country-search').val() == '' ) {
					jQuery('#country_navigation_chosen .chosen-results a').each(function(){
						jQuery(this).html(jQuery(this).html().replace('<u>',''));
						jQuery(this).html(jQuery(this).html().replace('</u>',''));
						//jQuery(this).html(jQuery(this).html().replace(/(^\w{1})|(\s+\w{1})/g, letter => letter.toUpperCase());
					});
					jQuery('.nav__countries_letter').show();
					jQuery('.nav__countries_letter').prev().addClass('nav__countries_last');
				}
				jQuery('#country_navigation_chosen .chosen-results a').each(function(){
					var state_country_each_value = jQuery(this).html().toLowerCase();
					state_country_each_value = state_country_each_value.replace('<u>','');
					state_country_each_value = state_country_each_value.replace('</u>','');
					//state_country_each_value = state_country_each_value.charAt(0).toUpperCase() + state_country_each_value.slice(1);
					//state_country_each_value.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.substring(1)).join(' ');

					//jQuery(this).html(jQuery(this).html().replace(//g))
					//alert('1');
					if ( state_country_each_value.indexOf(state_country_search) != -1 ) {
						jQuery(this).show();
						var state_countries_split_screen = state_country_each_value.split(state_country_search);
						var state_current_country_nav_value = '';
						for (let index = 0; index < state_countries_split_screen.length; index++) {
							state_current_country_nav_value += state_countries_split_screen[index];
							if ( (index + 1) < state_countries_split_screen.length) {
								state_current_country_nav_value += '<u>' + state_country_search + '</u>';
							}
						}
						//jQuery(this).html(state_current_country_nav_value);
						//alert('.nav__countries_' + state_country_each_value.charAt(0));
						jQuery('.nav__countries_' + state_country_each_value.charAt(0) + '').show();
					} else {
						jQuery(this).html(jQuery(this).html().replace('<u>',''));
						jQuery(this).html(jQuery(this).html().replace('</u>',''));
						//jQuery(this).html(jQuery(this).html().replace(/(^\w{1})|(\s+\w{1})/g, letter => letter.toUpperCase());
						jQuery(this).hide();
					}
				});
			})
		})
	}
</script>

