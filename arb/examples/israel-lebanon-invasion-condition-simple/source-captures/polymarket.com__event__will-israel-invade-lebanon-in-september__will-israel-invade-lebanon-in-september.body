Tuned":"Stay tuned for updates via email","redirecting":"Redirecting...","somethingWentWrong":"Something went wrong!","requestAgain":"Please request again in your Polymarket settings","contactUs":"Contact us","ifYouNeedHelp":"if you need help."},"portfolio":{"today":"past day","availableToTrade":"Available to trade","profitLoss":"Profit/Loss","pastDay":"Past Day","pastWeek":"Past Week","pastMonth":"Past Month","pastYear":"Past Year","yearToDate":"Year to Date","allTime":"All-Time","meta":{"title":"Your Portfolio | Polymarket","description":"View your Polymarket portfolio and track your trades and winnings."},"claim":{"youWon":"You won","claim":"Redeem","polymarketsWon":"Polymarkets won","totalReturn":"Total return","proceeds":"Proceeds","bet":"Traded","won":"Won","value":"Value"},"status":{"won":"Won","lost":"Lost"},"tabs":{"positions":"Positions","orders":"Open orders","liquidity":"Liquidity","history":"History","marketRewards":"Sponsorships","manageYourPortfolio":"Manage your portfolio"},"filters":{"search":"Search","closeLosses":"Close Losses","export":"Export","loading":"Loading","loadMore":"Load more"},"table":{"activity":"ACTIVITY","market":"MARKET","value":"VALUE","side":"SIDE","outcome":"OUTCOME","price":"PRICE","filled":"FILLED","total":"TOTAL","expiration":"EXPIRATION","time":"Time","showMore":"Show more","showMorePositions":"Show more positions","showMoreHistory":"Show more history","showMoreRewards":"Show more rewards","cancelAll":"Cancel all"},"sharesAt":"{shares} shares at {price}","messages":{"noTradesYet":"You haven't traded any polymarkets yet","noOpenOrdersFound":"No open orders found.","loadingError":"There was an error loading your activity. Please try refreshing the page.","noActivityFound":"No activity found.","noPositionsFound":"No positions found.","failedToRedeem":"Failed to redeem position"},"sponsorships":{"search":"Search sponsorships","viewSponsorships":"View Sponsorships","noSponsorshipsFound":"No sponsorships found","errorLoading":"There was an error loading sponsorships. Please try refreshing the page.","headers":{"status":"STATUS","market":"MARKET","startDate":"START DATE","endDate":"END DATE","progress":"PROGRESS"},"sortBy":{"currentValue":"Current value","startDate":"Start date","endDate":"End date","dailyRate":"Daily rate","alphabetically":"Alphabetically"},"status":{"active":"Active","ended":"Ended","upcoming":"Pending"},"perDay":"/day","daysLeft":"{count} days left","refunded":"Refunded","refundTooltip":"Refunds are processed daily between 12–1 AM UTC. ","confirming":"Confirming...","cancelling":"Cancelling","cancellingTooltip":"Your refund covers the period from 12:00 AM UTC onward. Rewards continue until then. Any portion not earned by liquidity provider is also refunded after 12:00 AM UTC.","linkCopied":"Link copied!","linkCopiedDescription":"Market link copied to clipboard"},"notAvailable":"N/A","errorState":{"title":"Something went wrong","message":"We encountered an error while loading your data.","errorDetails":"Error details"},"redeemAmount":{"receive":"Receive","sellingShares":"Selling {shares} shares @ {avgPrice}"},"modals":{"close":{"title":"Polymarkets Lost","description":"You can close out these resolved positions to realize the loss.","learnMore":"Learn More","closePositions":"Close Positions","closePositionsCount":"Close {count} Positions","processing":"Processing... {current}/{total}","done":"Done","tryAgain":"Try again","successMessage":"You have successfully closed all shares.","positionsClosed":"Positions closed","closedCount":"Closed {count} positions"},"redeem":{"youWon":"You won","greatJob":"Great job predicting the future on Polymarket!","addedToAccount":"added to your account","successDescription":"Your winnings are ready. Get back to trading!","claimProceeds":"Redeem proceeds","shareWinnings":"Share your ${amount} winnings","claimAmount":"Redeem ${amount}","processing":"Processing... {current}/{total}","done":"Done","tryAgain":"Try again","creatingShareLink":"Creating share link...","shareOn":"Share on","tweetText":"I just won ${amount} on @Polymarket!\n\nJoin me and put your money where your mouth is:"},"merge":{"title":"Merge ${amount} in positions","description":"This will merge all eligible market positions.","mergePositions":"Merge positions","processing":"Processing... {current}/{total}","done":"Done","tryAgain":"Try again","successMessage":"You successfully merged all your eligible positions."},"error":{"title":"Redeem Failed","helpArticleText":"Please visit","helpArticleLink":"this help article","forMoreAssistance":"for more assistance.","tryAgain":"Try again"}},"sort":{"currentValue":"Current value","bet":"Traded","profitLossPercent":"Profit \u0026 Loss %","profitLossDollar":"Profit \u0026 Loss $","shares":"Shares","alphabetically":"Alphabetically","endingSoon":"Ending soon","payout":"Payout","latestPrice":"Latest Price","averageCostPerShare":"Average cost per share","newest":"Newest","oldest":"Oldest","filledQuantity":"Filled Quantity","totalQuantity":"Total Quantity","orderDate":"Order Date","resolvingSoonest":"Resolving Soonest","poolShare":"Pool share","fees":"Fees"},"filtersHistory":{"all":"All","trades":"Trades","buy":"Buy","merge":"Merge","redeem":"Redeem","liquidityRewards":"Liquidity Rewards","referralRewards":"Referral Rewards","holdingRewards":"Holding Rewards","sell":"Sell","split":"Split","convert":"Convert","lost":"Lost","deposit":"Deposit","withdraw":"Withdraw"},"orders":{"viewOpenOrders":"View Open Orders","sort":{"market":"Market","filledQty":"Filled Quantity","totalQty":"Total Quantity","orderDate":"Order Date","resolution":"Resolving Soonest"}},"positionsTable":{"market":"MARKET","avg":"AVG","now":"NOW","avgToNowTooltip":"Your average buy price per share vs the current price","howDoSharePricesWork":"How do share prices work?","bet":"TRADED","toWin":"TO WIN","value":"VALUE"},"autoRedeem":{"title":"Get Paid Instantly","reenableTitle":"Re-enable Auto-Redeem","description":"When you win, your payout hits your balance automatically. No more manual steps.","oneTimeApprovalLabel":"One-time approval","oneTimeApprovalDesc":"Sign a single transaction and you're set","startsAfterNextTradeLabel":"Starts after your next trade","startsAfterNextTradeDesc":"Manually redeem winnings one last time.","alwaysOnLabel":"Always on","alwaysOnDesc":"Once enabled, it stays on permanently.","approving":"Approving...","enableAutoRedeem":"Enable Auto-Redeem","enabledToastTitle":"Auto-Redeem Enabled","enabledToastDesc":"Your winnings will be redeemed automatically.","failedToastTitle":"Auto-Redeem Failed","failedToastDesc":"Something went wrong. Please try again.","txFailedError":"Transaction failed to confirm. Please try again!","signatureRejectedError":"The signature was rejected. Please try again!","genericError":"Something went wrong. Please try again!","settingTitle":"Auto-redeem your wins","settingEnabled":"Enabled","settingEnabling":"Enabling...","settingEnable":"Enable","settingActiveDesc":"Your winnings are redeemed automatically when markets close.","settingInactiveDesc":"Automatically redeem your winnings from markets when they close. One-time approval, always on.","settingDisable":"Disable","settingDisabling":"Disabling...","disabledToastTitle":"Auto-Redeem Disabled","disabledToastDesc":"Your winnings will no longer be redeemed automatically."},"copyAddress":"Copy address","copied":"Copied!","walletAddressTitle":"Your Polymarket Wallet Address","walletAddressWarning":"Do not send funds to this address. This address is for API use only.","chartIntervalOneDay":"1D","chartIntervalOneWeek":"1W","chartIntervalOneMonth":"1M","chartIntervalOneYear":"1Y","chartIntervalYtd":"YTD","chartIntervalAll":"ALL","pleaseTryAgain":"Please try again","tooltipShare":"Share","tooltipCloseLostPosition":"Close lost position"},"orders":{"filled":"Filled","remaining":"{count} remaining","ordersCancelled":"Orders cancelled","cancelOrdersError":"Error cancelling orders","cancelOrdersCount":"{count} orders were cancelled","areYouSure":"Are you sure?","cancelMultipleOrders":"You will cancel {count} open orders.","cancelSingleOrder":"Are you sure you want to cancel this open order?","neverMind":"Never mind","confirm":"Confirm","cannotBeUndone":"This action cannot be undone.","cancelOneOpenOrder":"Cancel 1 open order","cancelNOpenOrders":"Cancel {count} open orders","cancelOneOrder":"Cancel 1 order","cancelNOrders":"Cancel {count} orders","orderCancelledSuccessfully":"Order cancelled successfully","ordersCancelledSuccessfully":"{count} orders cancelled successfully","earningRewards":"Earning rewards","cancel":"Cancel","cancelAll":"Cancel All","viewOpen":"View Open","nOrders":"{count} orders","nOrdersTitle":"{count} Orders","nOrdersWereCancelled":"{count} orders were cancelled","errorCancellingNOrders":"Error cancelling {count} orders"},"shareCards":{"shareProfile":"Share Profile","sharePnlChart":"Share Profit/Loss Chart","shareTrade":"Share Trade","profileTweetText":"Check out my profile on @Polymarket.","pnlTweetText":"Check out my P\u0026L on @Polymarket.","ownTradeTweetText":"I just put my money where my mouth is on @Polymarket.\n\nTrade against me:","thirdPartyTradeTweetText":"Check out this trade on @Polymarket.","copied":"Copied!","copyLink":"Copy Link","copyImage":"Copy Image","sharing":"Sharing...","share":"Share","shareWin":"Share Win","cashoutTweetText":"I just won on @Polymarket."},"events":{"negRiskBadge":{"title":"Winner-take-all","onlyOneWinner":"Only 1 winner","supportsNegativeRisk":"Supports negative risk (convert No shares to Yes of the other options)","completeNegativeRisk":"Complete negative risk","completeNegativeRiskDescription":"users who convert will receive Yes shares in any outcomes added in the future"},"headerMeta":{"volume":"Vol.","estimatedEndDateTooltip":"This is estimated end date. See rules below for specific resolution details.","holdingRewardsTooltip":"To keep long-term pricing accurate, we're paying a 4% reward on your total position on this market."},"resolution":{"outcomeProposed":"Outcome proposed","outcomeProposal":"Outcome proposal","disputeWindow":"Dispute window","noDispute":"No dispute","final":"Final","finalReview":"Final review","inReview":"In Review","finalOutcome":"Final outcome","disputed":"Disputed","finalDispute":"Final dispute","proposeResolution":"Propose resolution","noOutcomeProposedYet":"No outcome has been proposed yet.","dispute":"Dispute","viewDetails":"View details"},"accordionHeader":{"outcome":"OUTCOME","chance":"% CHANCE","refresh":"Refresh","result":"RESULT","cancelAllOrders":"Cancel all orders"},"grokEventSummary":{"marketContext":"Market Context","generate":"Generate","gettingSources":"Getting sources...","resultsExperimental":"Results are experimental.","contextDisclaimer":"Experimental AI-generated summary referencing Polymarket data. This is not trading advice and plays no role in how this market resolves.","contextUpdated":"Updated"},"aboutSection":{"about":"About","rules":"Rules","showLess":"Show less","showMore":"Show more","createdAt":"Market Opened:","resolver":"Resolver","sources":"Sources","resolutionSource":"Resolution Source","liveDataDisclaimer":"Live data may be delayed by a few seconds and can be influenced by price activity on other exchanges and broader market conditions."},"statistics":{"volume":"Volume","endDate":"End Date","createdAt":"Market Opened"},"backToTop":"Back to top","lowerState":{"comments":"Comments","holders":"Top Holders","positions":"Positions","activity":"Activity","related":"Related"},"tabs":{"markets":"Markets","positions":"Positions","orders":"Orders","history":"History","orderBook":"Order Book","graph":"Graph","openOrders":"Open Orders","resolution":"Resolution"},"orderHeaders":{"type":"type","side":"side","outcome":"outcome","price":"price","filled":"filled","total":"total","expiration":"expiration","expiry":"expiry"},"resolutionCountdown":{"eventHasEnded":"Event has ended","day":"Day","days":"Days","hr":"Hr","hrs":"Hrs","min":"Min","mins":"Mins","sec":"Sec","secs":"Secs","left":"left","resolutionTime":"Resolution Time"},"returnCell":{"unrealized":"Unrealized","realized":"Realized","total":"Total"},"marketUpdates":{"additionalContext":"Additional context","updated":"Updated {date}"},"netPositions":{"title":"Net Positions","description":"Your gains for each outcome scenario based on all your positions.","viewNetPositions":"View Net Positions","payout":"Payout"},"dateDisplay":{"resolvedAgo":"Resolved {days} ago","inDays":"In {days}","estimatedTimeRemaining":"Estimated time remaining: {countdown}","seeRulesBelow":"See rules below for specific resolution details.","estimatedEndDate":"This is estimated end date. See rules below for specific resolution details."},"videoEmbed":{"watchStream":"Watch Stream","ended":"Ended","beginsIn":"Starts in"},"goToLiveMarket":"Go to live market","finalPrice":"Final price","noPositionsYet":"No positions yet","marketInsights":"Market Insights","relatedXPosts":"Related X Posts","seeXPosts":"See X Posts","unableToLoadChart":"Unable to load chart data","scoreboard":"Scoreboard","liveStream":"Live Stream","notCurrentlyLive":"Not Currently Live","logInToViewStream":"Please log in to view this stream.","convertPositions":{"title":"Convert positions","description":"Convert your \"No\" positions to the complementary \"Yes\" positions (and potentially USDC).","learnMore":"Learn more","selectOneOrMore":"Select one or more","noPositions":"No Positions","enterAmount":"Enter amount","review":"Review","completed":"Completed","youHaveNewShares":"You have new shares","okay":"Okay","convert":"Convert","shares":"shares"}},"eventFaq":{"title":"Frequently Asked Questions","whatIsMarket":{"q":"What is the \"{title}\" prediction market?","binaryA":"\"{title}\" is a prediction market on Polymarket where traders buy and sell \"Yes\" or \"No\" shares based on whether they believe this event will happen. The current crowd-sourced probability is {leadingProbabilityDisplay} for \"{leadingOutcome}.\" For example, if \"Yes\" is priced at {leadingProbabilityCents}, the market collectively assigns a {leadingProbabilityDisplay} chance that this event will occur. These odds shift continuously as traders react to new developments and information. Shares in the correct outcome are redeemable for $1 each upon market resolution.","multiWithSecondA":"\"{title}\" is a prediction market on Polymarket with {outcomeCountDisplay} possible outcomes where traders buy and sell shares based on what they believe will happen. The current leading outcome is \"{leadingOutcome}\" at {leadingProbabilityDisplay}, followed by \"{secondOutcome}\" at {secondProbabilityDisplay}. Prices reflect real-time crowd-sourced probabilities. For example, a share priced at {leadingProbabilityCents} implies that the market collectively assigns a {leadingProbabilityDisplay} chance to that outcome. These odds shift continuously as traders react to new developments and information. Shares in the correct outcome are redeemable for $1 each upon market resolution.","multiWithoutSecondA":"\"{title}\" is a prediction market on Polymarket with {outcomeCountDisplay} possible outcomes where traders buy and sell shares based on what they believe will happen. The current leading outcome is \"{leadingOutcome}\" at {leadingProbabilityDisplay}. Prices reflect real-time crowd-sourced probabilities. For example, a share priced at {leadingProbabilityCents} implies that the market collectively assigns a {leadingProbabilityDisplay} chance to that outcome. These odds shift continuously as traders react to new developments and information. Shares in the correct outcome are redeemable for $1 each upon market resolution."},"activity":{"q":"How much trading activity has \"{title}\" generated on Polymarket?","highVolumeA":"As of today, \"{title}\" has generated {totalVolumeRounded} in total trading volume{datePart}. This level of trading activity reflects strong engagement from the Polymarket community and helps ensure that the current odds are informed by a deep pool of market participants. You can track live price movements and trade on any outcome directly on this page.","highVolumeDatePart":" since the market launched on {createdAt}","newMarketA":"\"{title}\" is a newly created market on Polymarket{datePart}. As an early market, this is your opportunity to be among the first traders to set the odds and establish the market's initial price signals. You can also bookmark this page to track volume and trading activity as the market gains traction over time.","newMarketDatePart":", launched on {createdAt}"},"howToTrade":{"q":"How do I trade on \"{title}\"?","binaryA":"To trade on \"{title},\" simply choose whether you believe the answer is \"Yes\" or \"No.\" Each side has a current price that reflects the market's implied probability. Enter your amount and click \"Trade.\" If you buy \"Yes\" shares and the outcome resolves as \"Yes,\" each share pays out $1. If it resolves as \"No,\" your \"Yes\" shares pay $0. You can also sell your shares at any time before resolution if you want to lock in a profit or cut a loss.","multiA":"To trade on \"{title},\" browse the {outcomeCountDisplay} available outcomes listed on this page. Each outcome displays a current price representing the market's implied probability. To take a position, select the outcome you believe is most likely, choose \"Yes\" to trade in favor of it or \"No\" to trade against it, enter your amount, and click \"Trade.\" If your chosen outcome is correct when the market resolves, your \"Yes\" shares pay out $1 each. If it's incorrect, they pay out $0. You can also sell your shares at any time before resolution if you want to lock in a profit or cut a loss."},"currentOdds":{"q":"What are the current odds for \"{title}\"?","noTradesA":"This market was recently created and has not yet received its first trade. Be the first to set the opening odds by placing a trade, or bookmark this page to check back as the market develops.","binaryA":"The current probability for \"{title}\" is {leadingProbabilityDisplay} for \"{leadingOutcome}.\" This means the Polymarket crowd currently believes there is a {leadingProbabilityDisplay} chance that this event will occur. These odds update in real-time based on actual trades, providing a continuously updated signal of what the market expects to happen.","wideOpenWithSecondA":"This is a wide-open market. The current leader for \"{title}\" is \"{leadingOutcome}\" at just {leadingProbabilityDisplay}, with \"{secondOutcome}\" close behind at {secondProbabilityDisplay}. With no outcome commanding a strong majority, traders see this as highly uncertain, which can present unique trading opportunities. These odds update in real-time, so bookmark this page to watch how the probabilities evolve.","wideOpenWithoutSecondA":"This is a wide-open market. The current leader for \"{title}\" is \"{leadingOutcome}\" at just {leadingProbabilityDisplay}. With no outcome commanding a strong majority, traders see this as highly uncertain, which can present unique trading opportunities. These odds update in real-time, so bookmark this page to watch how the probabilities evolve.","standardWithSecondA":"The current frontrunner for \"{title}\" is \"{leadingOutcome}\" at {leadingProbabilityDisplay}, meaning the market assigns a {leadingProbabilityDisplay} chance to that outcome. The next closest outcome is \"{secondOutcome}\" at {secondProbabilityDisplay}. These odds update in real-time as traders buy and sell shares, so they reflect the latest collective view of what's most likely to happen. Check back frequently or bookmark this page to follow how the odds shift as new information emerges.","standardWithoutSecondA":"The current frontrunner for \"{title}\" is \"{leadingOutcome}\" at {leadingProbabilityDisplay}, meaning the market assigns a {leadingProbabilityDisplay} chance to that outcome. These odds update in real-time as traders buy and sell shares, so they reflect the latest collective view of what's most likely to happen. Check back frequently or bookmark this page to follow how the odds shift as new information emerges."},"resolution":{"q":"How will \"{title}\" be resolved?","a":"The resolution rules for \"{title}\" define exactly what needs to happen for each outcome to be declared a winner — including the official data sources used to determine the result. You can review the complete resolution criteria in the \"Rules\" section on this page above the comments. We recommend reading the rules carefully before trading, as they specify the precise conditions, edge cases, and sources that govern how this market is settled."},"followWithout":{"q":"Can I follow \"{title}\" without placing a trade?","a":"Yes. You don't need to trade to stay informed. This page serves as a live tracker for \"{title}.\" The outcome probabilities update in real-time as new trades come in. You can bookmark this page and check the comments section to see what other traders are saying. You can also use the time-range filters on the chart to see how the odds have shifted over time. It's a free, real-time window into what the market expects to happen."},"reliability":{"q":"Why are Polymarket's odds for \"{title}\" considered reliable?","highVolumeSchemaA":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to surface accurate predictions. With {totalVolumeRounded} traded on \"{title},\" these prices aggregate the collective knowledge and conviction of thousands of participants — often outperforming polls, expert forecasts, and traditional surveys. Prediction markets like Polymarket have a strong track record of accuracy, especially as events approach their resolution date. For example, Polymarket has a one month accuracy score of {accuracyScore}. For the latest stats on Polymarket's prediction accuracy, visit the accuracy page on Polymarket.","highVolumeBeforeLink":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to surface accurate predictions. With {totalVolumeRounded} traded on “{title},” these prices aggregate the collective knowledge and conviction of thousands of participants — often outperforming polls, expert forecasts, and traditional surveys. Prediction markets like Polymarket have a strong track record of accuracy, especially as events approach their resolution date. For example, Polymarket has a one month accuracy score of {accuracyScore}. For the latest stats on Polymarket’s prediction accuracy, visit the ","highVolumeAfterLink":" on Polymarket.","lowVolumeSchemaA":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to surface accurate predictions. \"{title}\" is still building its trading base, so the odds will become increasingly reliable as more participants enter the market. Prediction markets like Polymarket have a strong track record of accuracy, especially as events approach their resolution date. For example, Polymarket has a one month accuracy score of {accuracyScore}. For the latest stats on Polymarket's prediction accuracy, visit the accuracy page on Polymarket.","lowVolumeBeforeLink":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to surface accurate predictions. “{title}” is still building its trading base, so the odds will become increasingly reliable as more participants enter the market. Prediction markets like Polymarket have a strong track record of accuracy, especially as events approach their resolution date. For example, Polymarket has a one month accuracy score of {accuracyScore}. For the latest stats on Polymarket’s prediction accuracy, visit the ","lowVolumeAfterLink":" on Polymarket.","linkText":"accuracy page"},"getStarted":{"q":"How do I start trading on \"{title}\"?","a":"To place your first trade on \"{title},\" sign up for a free Polymarket account and fund it using crypto, a credit or debit card, or a bank transfer. Once your account is funded, return to this page, select the outcome you want to trade, enter your amount, and click \"Trade.\" If you're new to prediction markets, click the \"How it works\" link at the top of any Polymarket page for a quick step-by-step walkthrough of how trading works."},"priceMeaning":{"binaryQ":"What does a price of {leadingProbabilityCents} for \"{leadingOutcome}\" mean?","binaryA":"On Polymarket, the price of \"Yes\" or \"No\" represents the market's implied probability. A \"Yes\" price of {leadingProbabilityCents} for \"{title}\" means traders collectively believe there is a {leadingProbability}% chance this event will happen. If you buy \"Yes\" at {leadingProbabilityCents} and the event does happen, you receive $1.00 per share — a profit of {payoutMathDisplay} per share. If the event doesn't happen, those shares are worth $0.","multiQ":"What does a price of {leadingProbabilityCents} for \"{leadingOutcome}\" mean?","multiA":"On Polymarket, the price of each outcome represents the market's implied probability. A price of {leadingProbabilityCents} for \"{leadingOutcome}\" in the \"{title}\" market means traders collectively believe there is roughly a {leadingProbabilityDisplay} chance that \"{leadingOutcome}\" will be the correct result. If you buy \"Yes\" shares at {leadingProbabilityCents} and the outcome is correct, you receive $1.00 per share — a profit of {payoutMathDisplay} per share. If incorrect, those shares are worth $0."},"marketClose":{"q":"When does the \"{title}\" market close?","resolvedA":"The \"{title}\" market has been resolved. The final result has been determined and the market is no longer open for trading. You can still review the historical odds, outcome probabilities, and comments on this page to see how predictions evolved over time.","endDatePassedA":"The \"{title}\" market's scheduled end date has passed, but the market has not yet been officially resolved. The end date indicates when the underlying event is expected to occur or become knowable. It is not the moment trading stops. The market remains open for trading until the outcome is formally resolved through the resolution process. You can still buy, sell, or close your position while the market is pending resolution. Check the resolution status tracker and \"Rules\" section on this page for updates on the resolution timeline.","noEndDateA":"This market will resolve when the event's official outcome is determined. Check the \"Rules\" section on this page for the specific resolution criteria and timing.","longTermA":"The \"{title}\" market is a long-term prediction with a resolution date of {endDate} — that's roughly {timeUntilResolution} away. Long-term markets on Polymarket often see their odds shift significantly as events unfold, making them useful for tracking evolving sentiment. You can trade at any time or bookmark this page to follow the odds over the months and years ahead.","standardA":"The \"{title}\" market is scheduled to resolve on or around {endDate}. This means trading will remain open and the odds will continue to shift as new information emerges until that date. The exact resolution timing depends on when the official result becomes available, as outlined in the \"Rules\" section on this page."},"tradersSaying":{"q":"What are traders saying about \"{title}\"?","activeCommunity":"an active community of {countDisplay} comments","growingDiscussion":"a growing discussion of {countDisplay} comments","activeA":"The \"{title}\" market has {communityPhrasing} where traders share their analysis, debate outcomes, and discuss breaking developments. Scroll down to the comments section below to read what other participants think. You can also filter by \"Top Holders\" to see what the market's biggest traders are positioned on, or check the \"Activity\" tab for a real-time feed of trades.","newMarketA":"The \"{title}\" market was recently created. Be one of the first to share your analysis by posting a comment below, or check back as the market grows to read what other traders think. You can also view the \"Activity\" tab for a real-time feed of recent trades."},"whatIsPolymarket":{"q":"What is Polymarket?","a":"Polymarket is the world's largest prediction market, where you can stay informed and profit from your knowledge of real-world events. Traders buy and sell shares on outcomes for topics ranging from politics and elections to crypto, finance, sports, tech, and culture, including markets like \"{title}.\" Prices reflect real-time, crowd-sourced probabilities backed by financial conviction, often providing faster and more accurate signals than polls, pundits, or traditional surveys."},"timeUntil":{"aboutOneDay":"about 1 day","aboutDays":"about {count} days","aboutOneMonth":"about 1 month","aboutMonths":"about {count} months","overOneYear":"over 1 year","overYears":"over {count} years"}},"comments":{"addComment":"Add a comment...","post":"Post","bewareExternalLinks":"Beware of external links.","newest":"Newest","mostLiked":"Most liked","holders":"Holders","reply":"Reply","replies":"{count} Replies","share":"Share","report":"Report","delete":"Delete","noComments":"No comments","readMore":"Read more","showLess":"Show less","linkCopied":"Link copied!","linkCopiedDescription":"Comment link copied to clipboard","failedToCopyLink":"Failed to copy link","pleaseTryAgain":"Please try again","reported":{"title":"Comment reported","description":"You reported this comment.","alreadyReported":"You already reported this comment."},"deleteDialog":{"title":"Delete comment","description":"Are you sure you want to delete your comment?","cancel":"Never mind","confirm":"Confirm"},"emojiPicker":{"search":"Search emoji","loading":"Loading...","noResults":"No emoji found."},"giphyPicker":{"search":"Search Giphy","title":"GIFs","description":"Search and select GIFs","noResults":"No GIFs found"}},"topHolders":{"holders":"holders","shares":"shares","noHolders":"There are no holders.","noNameHolders":"No {name}","live":"Live","positionFilters":{"all":"All","open":"Open","closed":"Closed","desc":"Desc","asc":"Asc"},"pnl":"PnL","avg":"avg","bought":"bought"},"chart":{"settings":{"embed":"Embed","exportData":"Export Data","autoscale":"Autoscale","xAxis":"X-Axis","yAxis":"Y-Axis","horizontalGrid":"Horizontal Grid","verticalGrid":"Vertical Grid","annotations":"Annotations","bothOutcomes":"Both Outcomes","chartOptions":"Chart Options","switchTo":"Switch to {outcome}","settings":"Settings","closeSettings":"Close settings","options":"Options","closeOptions":"Close options","closeAnnotations":"Close annotations"},"options":{"showOnChart":"Show on chart","selectMaximum":"Select a maximum of 4"},"intervals":{"oneHour":"1H","sixHours":"6H","oneDay":"1D","oneWeek":"1W","oneMonth":"1M","all":"ALL","max":"Max"}},"tooltips":{"watchLivestream":"Watch Livestream","cancel":"Cancel","share":"Share","closeLostPosition":"Close lost position","scrollToGame":"Scroll to Game"},"embed":{"title":"Embed","preview":"Preview","showVolume":"Show Volume","showChart":"Show Chart","showTimeRangeSelector":"Show Time Range Selector","copy":"Copy","light":"Light","dark":"Dark"},"rewards":{"earn4Percent":"Earn 4%","earn4PercentHoldingRewards":"Earn 4% holding rewards","earnRewardsByPlacingLimitOrders":"Earn rewards by placing limit orders near the midpoint.","earnRewardsByPlacingOrdersWithinSpread":"Earn rewards by placing competitive limit orders.","learnMore":"Learn more","rewards":"Rewards","maxSpread":"Max Spread","minShares":"Min Shares","dailyRewards":"Daily Rewards","earnings":"Earnings","enableRewards":"Enable Rewards","uplTemporarilyDisabled":"UPL is temporarily disabled","minimumRewardPayout":"Minimum reward payout is $1; amounts below this will not be paid.","rewardsDisplayedOnceThreshold":"Min. payout: {polyThreshold} (Polymarket), {userThreshold} (User Sponsored).\nRewards are accruing and paid once thresholds are reached.","market":"Market","reward":"Reward","changes":"Changes","competitive":"Comp.","percent":"Percent","price":"Price","rules":"Rules","noFavorites":"No polymarkets currently on Watchlist","noResults":"No results","maxSpreadTooltip":"Maximum distance orders must be from market's midpoint to score (inclusive)","competitiveTooltip":"How competitive is providing liquidity in this market","earningsTooltip":"Rewards currently earned today","polyRewards":"Polymarket Rewards","userSponsoredRewards":"User Sponsored Rewards","percentTooltip":"The percent of scoring liquidity you are currently providing in this market","changeLog":{"increased":"Increased","decreased":"Decreased","time":"Time","type":"Type","value":"Value","reward":"Reward","minShares":"Min shares","maxSpread":"Max spread","minutesAgo":"m ago","hoursAgo":"h ago","daysAgo":"d ago"},"categories":{"all":"all","politics":"politics","sports":"sports","crypto":"crypto","popCulture":"pop culture","middleEast":"middle east","business":"business","science":"science"},"endOfDay":"End of day","custom":"Custom","expiry":"Expiry","date":"Date","time":"Time","apply":"Apply","expirationError":"Expiration must be in future. Try again","expirationModal":{"relativeTime":"Relative time","relativeTimeHint":"e.g 15m or 2h 30m","relativeTimeError":"Use values like \"15m\" or \"2h 30m\"","expiresIn":"Expires in {time}","in30Seconds":"In 30 seconds","saveThisOption":"Save this option","orPickDateTime":"or pick date/time","savedOptions":"Saved options","fiveMinutes":"5m","oneHour":"1h","twelveHours":"12h","twentyFourHours":"24h"},"removeFromFavorites":"Remove from favorites","addToFavorites":"Add to favorites","withPositions":"Positions","withOpenOrders":"Open Orders","mergeablePositions":"Mergeable","favoritePolymarkets":"Favorites","addSponsor":"Add","liveSponsor":"Live","addingSponsor":"Adding","trading":{"place":"Place","clear":"Clear","cancelAll":"Cancel all","orders":"Orders","positions":"Positions","history":"History","tradeHistory":"Trade history","trade":"TRADE","time":"TIME","min":"MIN","max":"MAX","shares":"SHARES"},"tabs":{"rewards":"Rewards","openOrders":"Open orders"},"searchMarkets":"Search markets","sort":{"percent":"Percent","earnings":"Earnings","competition":"Competition","maxSpread":"Max Spread","minSize":"Min Size","market":"Market","ratePerDay":"Rate Per Day","price":"Price"},"filters":{"decreasedRewards":"Decreased rewards","removedRewards":"Removed rewards","cancelFiltered":"Cancel filtered","rewardDecreased":"Reward decreased","rewardRemoved":"Reward removed","orderCancelledTitle":"Order cancelled","ordersCancelledTitle":"Orders cancelled","nOrderWasCancelled":"order was cancelled","nOrdersWereCancelled":"orders were cancelled","errorCancellingOrderTitle":"Error cancelling order","errorCancellingOrdersTitle":"Error cancelling orders","errorCancellingNOrder":"order","errorCancellingNOrders":"orders"},"mobile":{"maxSpread":"Max Spread","minSize":"Min size","totalRewards":"Total rewards","earnings":"Earnings","percent":"Percent","price":"Price","competition":"Competition"},"competitiveLevel":{"none":"No competition","low":"Low competition","mild":"Mild competition","medium":"Medium competition","high":"High competition","intense":"Intense competition","spreadTooLarge":"Spread too large"},"sponsor":{"attractLiquidity":"Attract more liquidity by sponsoring rewards for this market.","learnMore":"Learn more","loading":"Loading...","trackOrder":"Track order","notAvailableInRegion":"Not available in your region.","seeTerms":"See Terms.","perDay":"/day","utcSuffix":"UTC","noProxyAddress":"No proxy address found. Please connect your wallet.","invalidParameters":"Invalid sponsorship parameters","txTimeout":"Transaction confirmation timed out after 2 minutes","txFailed":"Transaction failed to confirm","signatureRejected":"Signature rejected","unknownError":"Unknown error occurred","invalidMarketId":"Invalid market ID","unavailable":"Unavailable","marketSponsored":"Market Sponsored"},"makerRebate":{"description":"Earn daily USDC rebates by placing limit orders that get filled.","learnMore":"Learn more","label":"Maker Rebate"},"addRewards":"Add Rewards","validation":{"orderError":"Order Error","minimumShares":"Minimum {amount} shares for limit orders","notEnoughShares":"Not Enough Shares","orderMustBeGreaterThanDollar":"Order must be greater than $1","limitBuyExceedsBalance":"Limit Buy Exceeds Balance"},"aria":{"decreaseDuration":"Decrease duration","increaseDuration":"Increase duration","copyMarketId":"Copy market ID"},"sponsorshipModal":{"sponsorRewards":"Sponsor Market Rewards","sponsorDescriptionPre":"Pay liquidity providers to trade on a market you want to see more activity on. ","sponsorDescriptionBold":"You won't earn rewards yourself","sponsorDescriptionPost":", your funds go directly to market makers.","rule1Pre":"Funds are ","rule1Bold":"locked","rule1Post":" for the duration of the sponsorship.","rule2Pre":"Rewards are distributed ","rule2Bold":"daily","rule2Post":" to eligible liquidity providers.","rule3Pre":"Unused funds are ","rule3Bold":"refunded","rule3Post":" if the market resolves early.","acceptAndContinue":"Accept \u0026 Continue","logInToContinue":"Log in to continue","deposit":"Deposit","continue":"Continue","day":"day","days":"days","amount":"Amount","balance":"Balance:","minimumRequired":"Minimum ${amount} required for {days} {daysLabel}","minimumSponsorship":"Minimum sponsorship is ${amount}","duration":"Duration","daysUnit":"days","dailyRewardRate":"Daily reward rate","commitmentEnds":"Commitment ends","unusedFundsReturn":"Unused funds are returned if the market resolves early","sponsorshipMinPerDay":"Minimum ${amount}/day required","market":"Market","marketId":"Market ID","totalAmount":"Total amount","dailyRate":"Daily rate","startDate":"Start date","endDate":"End date","reviewTitle":"Review Order","reviewDescription":"Please review your sponsorship details before confirming.","reviewWarningPre":"You can cancel anytime. ","reviewWarningBold":"Your refund covers the remaining balance from the next 12:00 AM UTC onward.","reviewWarningPost":" Today's allocation stays in the pool for liquidity providers. Any portion not earned by liquidity providers will be also returned at 12:00 AM UTC. ","learnMore":"Learn more","editOrder":"Edit Order","confirming":"Confirming...","confirmOrder":"Confirm Order","trackSponsorshipProgress":"Track progress","view":"View","sponsorshipActive":"Sponsorship Active","reviewOrCancel":"Review or cancel your sponsorship in","portfolioSponsorships":"Portfolio Sponsorships","firstDistribution":"First distribution","sponsorship":"Sponsorship","sponsorshipLive":"Sponsorship Live","contributionSuccess":"Your contribution of ${amount} has been successfully added to the market rewards.","earlyResolveNote":"If this market resolves before your sponsorship ends, unused funds will automatically return to your balance.","returnToMarket":"Return to Market","trackProgress":"Track Progress","configError":"Configuration Error","noConditionId":"No condition ID found for this market","sponsorshipFailed":"Sponsorship Failed","unexpectedError":"An unexpected error occurred"},"cancelModal":{"cancelSponsorship":"Cancel Sponsorship","sponsorshipCancelled":"Sponsorship Cancelled","market":"Market","totalAmount":"Total amount","dailyRate":"Daily rate","availableForWithdrawal":"Available for withdrawal","warningText":"Your refund is processed immediately, but only covers the period after the next 12:00 AM UTC. Today's allocation stays committed to the reward pool. Any portion not earned by liquidity providers will be also returned at 12:00 AM UTC.","close":"Close","cancelling":"Cancelling...","cancel":"Cancel","cancellationFailed":"Cancellation Failed","unexpectedError":"An unexpected error occurred","successHeading":"Sponsorship cancelled","successDescription":"Your unused sponsorship balance will be refunded automatically.","done":"Done","withdrawalTooltip":"This sponsorship ends before the next 12:00 AM UTC epoch. Today's full allocation is already committed to the reward pool."}},"sports":{"parlays":"Parlays","seriesTotals":"Series Totals","positionBreakdown":"Position Breakdown","viewAllGames":"View all {league} games","seriesLines":"Series Lines","backTo":"Back to","noEventsYet":"No events yet.","noGamesToDisplay":"No games to display","noLiveEsportsGamesRightNow":"No live esports games right now","upcomingEsportsGames":"Upcoming Esports Games","viewUpcomingGames":"View Upcoming Games","noUpcomingEsportsGamesScheduled":"No upcoming esports games scheduled","viewLiveGames":"View Live Games","noMarketsToDisplay":"No markets to display","goToHome":"Go to home","loadingMore":"Loading more...","week":"Week","matchday":"Matchday","spreads":"Spreads","totals":"Totals","spreadsTotals":"Spreads + Totals","showSpreadsTotals":"Show Spreads + Totals","settings":"Settings","oddsFormat":"Odds Format","price":"Price","american":"American","decimal":"Decimal","fractional":"Fractional","percentage":"Percentage","indonesian":"Indonesian","hongKong":"Hong Kong","malaysian":"Malaysian","live":"Live","upcoming":"Upcoming","startingSoon":"Starting Soon","popular":"Popular","allSports":"All Sports","allTournaments":"All Tournaments","futures":"Futures","games":"Games","game1":"Game 1","game2":"Game 2","game3":"Game 3","game4":"Game 4","game5":"Game 5","map1":"Map 1","map2":"Map 2","map3":"Map 3","map4":"Map 4","map5":"Map 5","props":"Props","bracket":"Bracket","events":"Events","moneyline":"Moneyline","spread":"Spread","total":"Total","gameView":"Game View","final":"FINAL","postponed":"POSTPONED","game":"Game","bestOf":"Best of","set":"Set","endH1":"End H1","endH2":"End H2","h1":"H1","h2":"H2","firstHalf":"1st Half","h1Moneyline":"1H Moneyline","h1Spread":"1H Spread","h1Spreads":"1H Spreads","h1Total":"1H Total","h1Totals":"1H Totals","overview":"Overview","gameLines":"Game Lines","teamTotals":"Team Totals","touchdowns":"Touchdowns","rushing":"Rushing","receiving":"Receiving","points":"Points","assists":"Assists","rebounds":"Rebounds","goalscorers":"Goalscorers","exactScore":"Exact Score","halftimeResult":"Halftime Result","corners":"Corners","types":{"soccer":"Soccer","football":"Football","americanFootball":"American Football","basketball":"Basketball","baseball":"Baseball","hockey":"Hockey","tennis":"Tennis","golf":"Golf","mma":"MMA","boxing":"Boxing","cricket":"Cricket","rugby":"Rugby","esports":"Esports","chess":"Chess","pickleball":"Pickleball","formula1":"Formula 1","ufc":"UFC","winterOlympics":"Winter Games","tableTennis":"Table Tennis","lacrosse":"Lacrosse"},"esportsFaq":{"title":"Frequently Asked Questions","general":{"q1":"What is esports trading on Polymarket?","a1":"Polymarket lets you trade on the outcomes of professional esports matches across titles like CS2, League of Legends, Dota 2, Valorant, and more. Buy shares in the team you think will win — if they do, your shares pay out at $1 each.","q2":"Which esports titles are available?","a2":"Polymarket covers major competitive titles including Counter-Strike 2, League of Legends, Dota 2, Valorant, Call of Duty, Overwatch, Mobile Legends, Rainbow Six Siege, Rocket League, Honor of Kings, StarCraft II, and more. New titles and tournaments are added regularly.","q3":"How do esports markets work?","a3":"Each match has a moneyline market where you can buy shares in either team. Prices reflect the community's estimated probability of each team winning. You can also trade on map handicaps, total maps, and individual map winners when available.","q4":"Can I watch the matches while trading?","a4":"Yes. When a live stream is available for a match, you'll see a \"Watch Stream\" button on the scoreboard. Clicking it opens a floating video player that you can drag, resize, and keep open while you continue browsing and trading.","q5":"How are esports markets resolved?","a5":"Markets are resolved based on official match results from tournament organizers. Once a match concludes, winning shares pay out at $1 and losing shares go to $0. Results are typically confirmed within minutes of a match ending.","q6":"What is Polymarket?","a6":"Polymarket is the world's largest prediction market platform. It lets you trade on the outcomes of real-world events — from politics and sports to crypto and culture — using real money. Prices reflect the crowd's real-time probability estimates for each outcome."},"league":{"q1":"What is {league} trading on Polymarket?","a1":"Polymarket lets you trade on the outcomes of professional {league} matches. Buy shares in the team you think will win — if they do, your shares pay out at $1 each. You can trade on live and upcoming {league} matches from major tournaments worldwide.","q2":"What {league} markets are available?","a2":"Each {league} match typically has a moneyline market where you pick the winner. Depending on the match format, you may also find map handicaps, total maps, and individual map or game winner markets.","q3":"How do {league} odds work on Polymarket?","a3":"Odds are expressed as share prices between 0¢ and 99¢. A team priced at 65¢ means the market gives them roughly a 65% chance of winning. If you buy at 65¢ and they win, you earn 35¢ profit per share. Prices update in real time as traders buy and sell.","q4":"Can I watch {league} matches while trading?","a4":"Yes. When a live stream is available, you'll see a \"Watch Stream\" button on the match scoreboard. It opens a floating video player you can drag and resize, so you can watch the action while browsing other markets or placing trades.","q5":"How are {league} markets resolved?","a5":"Markets are resolved based on official results from tournament organizers. Once a match concludes, winning shares pay out at $1 and losing shares go to $0. Results are typically confirmed within minutes of a match ending.","q6":"What is Polymarket?","a6":"Polymarket is the world's largest prediction market platform. It lets you trade on the outcomes of real-world events — from politics and sports to crypto and culture — using real money. Prices reflect the crowd's real-time probability estimates for each outcome."},"esportsTeam":{"q1":"What {game} markets are available for {team} on Polymarket?","a1":"Polymarket currently hosts {marketCount} active markets for {team} ({teamAbbr}) with over ${volume} in total trading volume. You can trade on match winners, handicaps, totals, and various prop markets across all of their competitive fixtures. Each market is priced as an implied probability — for example, a price of 65¢ means traders collectively believe there is a 65% chance of that outcome. New markets are added as upcoming {team} matches are announced.","q2":"Who is on {team}'s current roster?","a2":"{team}'s active {game} roster currently has {rosterCount} players: {rosterNames}. Roster changes — including substitutions, stand-ins, and player transfers — can significantly affect market odds. This page updates automatically to reflect the latest official roster, so you can see exactly who is competing before trading on any {team} market.","q3":"What is {team}'s recent match record and win rate?","a3":"Based on their recent competitive matches, {team} has a {winRate}% win rate with a record of {matchRecord}. You can view their full match history on this page, including scores, opponents, and tournament context. Recent form is one of the strongest factors influencing market odds — a team on a winning streak will typically see higher implied probabilities, while a losing run often shifts odds against them.","q4":"How do {game} prediction markets work on Polymarket?","a4":"Each {game} market on Polymarket is structured as a yes/no question — for example, \"Will {team} win?\" You buy shares in \"Yes\" or \"No\" at the current market price, which reflects the crowd-sourced implied probability. If your side is correct when the match concludes, your shares pay out $1 each. If incorrect, they pay $0. You can also sell your shares at any time before the match ends to lock in a profit or cut a loss. Prices update in real-time as traders react to news like roster changes, patch updates, and tournament developments.","q5":"How are {team} markets resolved?","a5":"All {team} markets resolve based on the official match results as reported by the tournament organizer. Series winner markets resolve when the final game of the series concludes. Prop markets resolve based on in-game data from the official broadcast or tournament data provider. You can check the \"Rules\" tab on any individual market page to see the exact resolution criteria and sources.","q6":"Why are Polymarket's {game} odds considered reliable?","a6":"Polymarket odds are set by real traders putting real money behind their positions, which tends to produce well-calibrated probabilities. With over ${volume} traded on {team} markets alone, these prices aggregate the collective knowledge of participants who follow {game} closely — factoring in team form, roster changes, meta shifts, and head-to-head records. Prediction markets have a strong track record of accuracy, often outperforming traditional bookmakers by reflecting the latest information as it emerges. For the latest stats, visit the accuracy page on Polymarket.","q7":"What factors influence {team}'s market odds?","a7":"Several factors can move {team}'s odds on Polymarket. The most impactful include recent match results and form, roster changes such as substitutions or transfers, tournament stage (group stage vs. playoffs), head-to-head history against specific opponents, and meta or patch changes that may favor or disadvantage their playstyle. Traders incorporate all of these variables into the price, which is why odds can shift rapidly when new information becomes available.","q8":"Can I follow {team} odds and results without trading?","a8":"Yes. This page is a free resource for tracking {team}'s match results, current roster, win rate, and live market odds — no account or trade required. You can monitor how odds shift in real-time as a way to gauge market sentiment on {team}'s upcoming matches. If you decide to trade later, you can sign up and fund your account at any time.","q9":"How do I start trading on {team} matches?","a9":"Sign up for a free Polymarket account and fund it using crypto, a credit or debit card, or a bank transfer. Then return to this page, choose any active {team} market, select the side you want to trade, enter your amount, and confirm. Your position will be visible in your portfolio, and you can sell at any time before the market resolves.","q10":"What is Polymarket?","a10":"Polymarket is the world's largest prediction market, where you can stay informed and trade on real-world events. Traders buy and sell shares on outcomes across politics, sports, crypto, finance, tech, culture, and esports — including {game} matches for teams like {team}. Prices reflect real-time, crowd-sourced probabilities backed by real money, offering a transparent, market-driven alternative to traditional odds sources. Visit polymarket.com to explore all available markets."},"sportsTeam":{"q1":"What {game} markets are available for {team} on Polymarket?","a1":"Polymarket currently hosts {marketCount} active markets for {team} ({teamAbbr}) with over ${volume} in total trading volume. You can trade on game winners (moneyline), spreads, totals (over/under), and other markets across all of their upcoming games. Each market is priced as an implied probability — for example, a price of 65¢ means traders collectively believe there is a 65% chance of that outcome. New markets are added as {team}'s schedule progresses.","q2":"What is {team}'s recent record and win rate?","a2":"Based on their recent games, {team} has a {winRate}% win rate with a record of {matchRecord}. You can view their full game-by-game results on this page, including scores, opponents, and context. Recent form is one of the strongest factors influencing market odds — a team on a winning streak will typically see higher implied probabilities, while a losing run often shifts odds against them.","q3":"How do {game} prediction markets work on Polymarket?","a3":"Each {game} market on Polymarket is structured as a yes/no question — for example, \"Will {team} win?\" You buy shares in \"Yes\" or \"No\" at the current market price, which reflects the crowd-sourced implied probability. If your side is correct when the game concludes, your shares pay out $1 each. If incorrect, they pay $0. You can also sell your shares at any time before the game ends to lock in a profit or cut a loss. Prices update in real-time as traders react to news like injury reports, lineup changes, and other developments.","q4":"How are {team} markets resolved?","a4":"All {team} markets resolve based on official game results, including overtime or extra periods where applicable. Moneyline markets resolve based on the final result of the game. Spread markets resolve based on the final margin relative to the posted line. Totals (over/under) resolve based on the combined final score. You can check the Rules on any individual market page to see the exact resolution criteria, including how postponements or cancellations are handled.","q5":"Why are Polymarket's {game} odds considered reliable?","a5":"Polymarket odds are set by real traders putting real money behind their positions, which tends to produce well-calibrated probabilities. With over ${volume} traded on {team} markets alone, these prices aggregate the collective knowledge of participants who follow {game} closely — factoring in team form, injuries, schedule strength, and head-to-head records. Prediction markets have a strong track record of accuracy, often outperforming traditional sources by reflecting the latest information as it emerges. Visit the accuracy page on Polymarket for the latest accuracy metrics across different time periods.","q6":"What factors influence {team}'s market odds?","a6":"Several factors can move {team}'s odds on Polymarket. The most impactful include recent results and form, injury reports and lineup changes, schedule context (regular season vs. playoffs), head-to-head history against specific opponents, and home vs. away performance. Traders incorporate all of these variables into the price, which is why odds can shift rapidly when new information like a key player being ruled out becomes available.","q7":"Can I follow {team} odds and results without trading?","a7":"Yes. This page is a free resource for tracking {team}'s game results, win rate, and live market odds — no account or trade required. You can monitor how odds shift in real-time as a way to gauge market sentiment on {team}'s upcoming games. If you decide to trade later, you can sign up and fund your account at any time.","q8":"How do I start trading on {team} games?","a8":"Sign up for a free Polymarket account and fund it using crypto, a credit or debit card, or a bank transfer. Then return to this page, choose any active {team} market, select the side you want to trade, enter your amount, and confirm. Your position will be visible in your portfolio, and you can sell at any time before the market resolves.","q9":"What does a price of 65¢ for \"{teamAbbr}\" mean?","a9":"On Polymarket, the price of each side in a market represents the market's implied probability. A price of 65¢ for {teamAbbr} on the moneyline means traders collectively believe there is roughly a 65% chance that {team} will win that game. If you buy {teamAbbr} shares at 65¢ and they win, you receive $1 per share — a profit of 35¢ per share. If they lose, those shares are worth $0. Prices shift in real-time as new information emerges and traders update their positions.","q10":"What is Polymarket?","a10":"Polymarket is the world's largest prediction market, where you can stay informed and trade on real-world events. Traders buy and sell shares on outcomes across politics, sports, crypto, finance, tech, culture, and esports — including {game} games for teams like {team}. Prices reflect real-time, crowd-sourced probabilities backed by real money, offering a transparent, market-driven alternative to traditional odds sources. Visit polymarket.com to explore all available markets."},"matchSportsTeam":{"q1":"What {game} markets are available for {team} on Polymarket?","a1":"Polymarket currently hosts {marketCount} active markets for {team} ({teamAbbr}) with over ${volume} in total trading volume. You can trade on match winners (moneyline), spreads, totals (over/under), and other markets across all of their upcoming matches. Each market is priced as an implied probability — for example, a price of 65¢ means traders collectively believe there is a 65% chance of that outcome. New markets are added as {team}'s schedule progresses.","q2":"What is {team}'s recent record and win rate?","a2":"Based on their recent matches, {team} has a {winRate}% win rate with a record of {matchRecord}. You can view their full match-by-match results on this page, including scores, opponents, and context. Recent form is one of the strongest factors influencing market odds — a team on a winning streak will typically see higher implied probabilities, while a losing run often shifts odds against them.","q3":"How do {game} prediction markets work on Polymarket?","a3":"Each {game} market on Polymarket is structured as a yes/no question — for example, \"Will {team} win?\" You buy shares in \"Yes\" or \"No\" at the current market price, which reflects the crowd-sourced implied probability. If your side is correct when the match concludes, your shares pay out $1 each. If incorrect, they pay $0. You can also sell your shares at any time before the match ends to lock in a profit or cut a loss. Prices update in real-time as traders react to news like injury reports, lineup changes, and other developments.","q4":"How are {team} markets resolved?","a4":"All {team} markets resolve based on official match results, including overtime or extra periods where applicable. Moneyline markets resolve based on the final result of the match. Spread markets resolve based on the final margin relative to the posted line. Totals (over/under) resolve based on the combined final score. You can check the Rules on any individual market page to see the exact resolution criteria, including how postponements or cancellations are handled.","q5":"Why are Polymarket's {game} odds considered reliable?","a5":"Polymarket odds are set by real traders putting real money behind their positions, which tends to produce well-calibrated probabilities. With over ${volume} traded on {team} markets alone, these prices aggregate the collective knowledge of participants who follow {game} closely — factoring in team form, injuries, schedule strength, and head-to-head records. Prediction markets have a strong track record of accuracy, often outperforming traditional sources by reflecting the latest information as it emerges. Visit the accuracy page on Polymarket for the latest accuracy metrics across different time periods.","q6":"What factors influence {team}'s market odds?","a6":"Several factors can move {team}'s odds on Polymarket. The most impactful include recent results and form, injury reports and lineup changes, schedule context (regular season vs. playoffs), head-to-head history against specific opponents, and home vs. away performance. Traders incorporate all of these variables into the price, which is why odds can shift rapidly when new information like a key player being ruled out becomes available.","q7":"Can I follow {team} odds and results without trading?","a7":"Yes. This page is a free resource for tracking {team}'s match results, win rate, and live market odds — no account or trade required. You can monitor how odds shift in real-time as a way to gauge market sentiment on {team}'s upcoming matches. If you decide to trade later, you can sign up and fund your account at any time.","q8":"How do I start trading on {team} matches?","a8":"Sign up for a free Polymarket account and fund it using crypto, a credit or debit card, or a bank transfer. Then return to this page, choose any active {team} market, select the side you want to trade, enter your amount, and confirm. Your position will be visible in your portfolio, and you can sell at any time before the market resolves.","q9":"What does a price of 65¢ for \"{teamAbbr}\" mean?","a9":"On Polymarket, the price of each side in a market represents the market's implied probability. A price of 65¢ for {teamAbbr} on the moneyline means traders collectively believe there is roughly a 65% chance that {team} will win that match. If you buy {teamAbbr} shares at 65¢ and they win, you receive $1 per share — a profit of 35¢ per share. If they lose, those shares are worth $0. Prices shift in real-time as new information emerges and traders update their positions.","q10":"What is Polymarket?","a10":"Polymarket is the world's largest prediction market, where you can stay informed and trade on real-world events. Traders buy and sell shares on outcomes across politics, sports, crypto, finance, tech, culture, and esports — including {game} matches for teams like {team}. Prices reflect real-time, crowd-sourced probabilities backed by real money, offering a transparent, market-driven alternative to traditional odds sources. Visit polymarket.com to explore all available markets."}},"teams":{"playerRoster":"Player Roster","active":"Active","inactiveFormer":"Inactive / Former","player":"Player","name":"Name","role":"Role","country":"Country","matchHistory":"Match History","date":"Date","match":"Match","score":"Score","tournament":"Tournament","upcomingMatches":"Upcoming Matches","moreMatches":"More {game} Matches","upcomingGames":"Upcoming Games","moreGames":"More {game} Games","allMarkets":"All Markets","showAllMarkets":"Show all {count} markets","marketsCount":"{count} markets","tradingVolume":"Trading Volume","activeMarkets":"Active Markets","winRate":"Win Rate","matchRecord":"Record","loadingTeamData":"Loading team data...","aboutTeam":"About {team}","readMore":"READ MORE","playersCount":"{count} players","aboutParagraph1":"{team} ({abbreviation}) is a professional esports organization competing in {game}, based in {location}. {rosterLine}","aboutParagraph2":"On Polymarket, you can trade on {team} match outcomes, map handicaps, total maps, and game-specific props across all their competitive fixtures. {team} currently has {marketCount} active markets with over ${volume} in total trading volume on the platform. Their recent competitive record stands at {matchRecord} for a {winRate}% win rate.","aboutParagraph3":"Polymarket's prediction markets aggregate real-time odds driven by crowd-sourced data from informed traders who understand team form, meta shifts, and roster dynamics. These odds often outperform traditional bookmakers by reflecting the latest information as it emerges. Each market resolves based on official match results from trusted sources.","aboutParagraph4":"Track {team}'s latest odds, predictions, and match results on this page. Whether you're following their competitive journey or looking to profit from your {game} knowledge, Polymarket offers the most comprehensive esports prediction markets available.","rosterLine":"The current roster features {playerNames}.","nationality":"Nationality","weightClass":"Weight Class","fighter":{"profile":"Fighter Profile","nickname":"Nickname","height":"Height","reach":"Reach","weight":"Weight","age":"Age"},"sportsAboutParagraph1":"{team} ({abbreviation}) is a professional team competing in {game}. {rosterLine}","sportsAboutParagraph2":"On Polymarket, you can trade on {team} game outcomes including moneyline, spreads, totals (over/under), and player props across all their scheduled games. {team} currently has {marketCount} active markets with over ${volume} in total trading volume on the platform. Their current record stands at {matchRecord} for a {winRate}% win rate.","sportsAboutParagraph3":"Polymarket's prediction markets aggregate real-time odds driven by crowd-sourced data from informed traders who understand team form, injuries, schedule strength, and matchup history. These odds often outperform traditional sportsbooks by reflecting the latest information as it emerges. Each market resolves based on official game results.","sportsAboutParagraph4":"Track {team}'s latest odds, predictions, and game results on this page. Whether you're following their season or looking to profit from your {game} knowledge, Polymarket offers the most comprehensive sports prediction markets available.","individualAboutParagraph1":"{team} ({abbreviation}) is a professional athlete competing in {game}.","individualAboutParagraph2":"On Polymarket, you can trade on {team}'s match outcomes and related props across all their upcoming competitions. {team} currently has {marketCount} active markets with over ${volume} in total trading volume on the platform.","individualAboutParagraph3":"Polymarket's prediction markets aggregate real-time odds driven by crowd-sourced data from informed traders who understand athlete form, conditioning, and head-to-head matchup history. These odds often outperform traditional sources by reflecting the latest information as it emerges. Each market resolves based on official results.","individualAboutParagraph4":"Track {team}'s latest odds, predictions, and results on this page. Whether you're following their career or looking to profit from your {game} knowledge, Polymarket offers the most comprehensive prediction markets available.","matchSportsAboutParagraph1":"{team} ({abbreviation}) is a professional team competing in {game}. {rosterLine}","matchSportsAboutParagraph2":"On Polymarket, you can trade on {team} match outcomes including moneyline, spreads, totals (over/under), and player props across all their scheduled matches. {team} currently has {marketCount} active markets with over ${volume} in total trading volume on the platform. Their current record stands at {matchRecord} for a {winRate}% win rate.","matchSportsAboutParagraph3":"Polymarket's prediction markets aggregate real-time odds driven by crowd-sourced data from informed traders who understand team form, injuries, schedule strength, and matchup history. These odds often outperform traditional sportsbooks by reflecting the latest information as it emerges. Each market resolves based on official match results.","matchSportsAboutParagraph4":"Track {team}'s latest odds, predictions, and match results on this page. Whether you're following their season or looking to profit from your {game} knowledge, Polymarket offers the most comprehensive sports prediction markets available."}},"sportsFaq":{"whatIsMarket":{"q":"What is the “{title}” prediction market?","a":"The “{title}” market on Polymarket lets you trade on the outcome of the {leagueName} game between the {awayTeamFullName} and the {homeTeamFullName}, scheduled for {gameDate} at {gameTime} ET. The primary market is the moneyline — which team will win the game — where {favoredTeam} is currently priced at {favoredTeamPrice}¢ ({favoredTeamPrice}% implied probability) and {underdogTeam} at {underdogTeamPrice}¢ ({underdogTeamPrice}%). Beyond the moneyline, sports markets on Polymarket may feature spreads, totals (over/under), and player props, giving you multiple ways to trade on this game. Prices reflect real-time crowd-sourced probabilities. Shares in the correct outcome pay out $1 each when the market resolves after the game ends."},"activity":{"q":"How much trading activity has “{title}” generated on Polymarket?","a":"As of now, the “{title}” market has generated {totalVolume} in total trading volume across all market types (moneyline, spreads, totals, and player props). This volume reflects active engagement from the Polymarket trading community, and a deeper pool of traders generally means more informative, reliable odds. You can track live price movements and trade on any market directly on this page."},"howToTrade":{"q":"How do I trade on “{title}”?","a":"To trade on “{title},” start by choosing the market type you want to trade: Moneyline (which team wins), Spreads (margin of victory), Totals (combined score over/under), or Player Props (individual player stat lines). Each market shows the current price for each side — for example, the moneyline shows {awayTeamAbbreviation} at {awayTeamPrice}¢ and {homeTeamAbbreviation} at {homeTeamPrice}¢. Select the side you want to trade, choose Buy to take a position or Sell to close an existing one, enter your amount, and click Trade. If your chosen side is correct when the game ends and the market resolves, your shares pay out $1 each. If it’s incorrect, they pay out $0. You can also sell your shares at any time before the game ends to lock in a profit or cut a loss."},"currentOdds":{"q":"What are the current odds for “{title}”?","a":"The current moneyline odds for “{title}” show {favoredTeamFullName} at {favoredTeamPrice}¢ ({favoredTeamPrice}% implied probability) and {underdogTeamFullName} at {underdogTeamPrice}¢ ({underdogTeamPrice}%). All odds update in real-time as traders buy and sell shares, reflecting the latest collective view of how this game will play out. Check back frequently or bookmark this page to follow how the odds shift as game time approaches."},"resolution":{"q":"How will “{title}” be resolved?","a":"The “{title}” market resolves based on the official final score of the {leagueName} game as reported by {leagueName}’s official results, including overtime if applicable. Moneyline markets resolve to the team that wins the game. Spread markets resolve based on the final margin of victory relative to the posted line. Totals (over/under) markets resolve based on the combined final score of both teams. Player prop markets resolve based on official box score statistics. If the game is postponed or canceled, the market resolution rules (available in the Rules section on this page) specify how that scenario is handled. We recommend reviewing the full resolution criteria before trading."},"followWithout":{"q":"Can I follow “{title}” without placing a trade?","a":"Yes. You don’t need to trade to stay informed. This page serves as a live odds tracker for the {awayTeamFullName} vs. {homeTeamFullName} game. The moneyline, spread, totals, and player prop odds all update in real-time as new trades come in. You can use the chart to track line movement as game time approaches — shifts in the odds often signal new information like injury updates, lineup changes, or sharp action from big traders. Bookmark this page, check the comments section to see what other traders are saying, and use the time-range filters on the chart to review how the odds have shifted. It’s a free, real-time window into what the market expects."},"reliability":{"q":"Why are Polymarket’s odds for “{title}” considered reliable?","schemaA":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to produce well-calibrated probabilities. With {totalVolume} traded on “{title},” these prices aggregate the collective knowledge and conviction of active participants — similar to how traditional sportsbooks reflect sharp and public money, but in an open, transparent market anyone can participate in. Prediction markets have a strong track record of accuracy, especially as events approach their resolution. Polymarket’s overall one-month accuracy score is {accuracyScore}. For the latest stats, visit the accuracy page on Polymarket.","beforeLink":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to produce well-calibrated probabilities. With {totalVolume} traded on “{title},” these prices aggregate the collective knowledge and conviction of active participants — similar to how traditional sportsbooks reflect sharp and public money, but in an open, transparent market anyone can participate in. Prediction markets have a strong track record of accuracy, especially as events approach their resolution. Polymarket’s overall one-month accuracy score is {accuracyScore}. For the latest stats, visit the ","afterLink":" on Polymarket.","linkText":"accuracy page"},"getStarted":{"q":"How do I start trading on “{title}”?","a":"To place your first trade on “{title},” sign up for a free Polymarket account and fund it using crypto, a credit or debit card, or a bank transfer. Once your account is funded, return to this page and choose a market type — Moneyline, Spreads, Totals, or Player Props — select the side you want to trade (e.g., {awayTeamAbbreviation} or {homeTeamAbbreviation} on the moneyline), enter your amount, and click Trade. If you’re new to prediction markets, click the “How it works” link at the top of any Polymarket page for a step-by-step walkthrough."},"priceMeaning":{"q":"What does a price of {favoredTeamPrice}¢ for “{favoredTeamAbbreviation}” mean?","a":"On Polymarket, the price of each side in a market represents the market’s implied probability. A price of {favoredTeamPrice}¢ for {favoredTeamAbbreviation} on the moneyline means traders collectively believe there is roughly a {favoredTeamPrice}% chance that the {favoredTeamFullName} will win this game. If you buy {favoredTeamAbbreviation} shares at {favoredTeamPrice}¢ and they win, you receive $1 per share — a profit of {profitPerShare}¢ per share. If they lose, those shares are worth $0. The same logic applies to spreads, totals, and player props: a lower price means a higher potential payout but a lower implied probability of being correct."},"marketClose":{"q":"When does the “{title}” market close?","a":"The “{title}” game is scheduled for {gameDate} at {gameTime} ET. Trading remains open and odds will continue to shift as new information emerges leading up to the game. The market resolves once the game concludes and the official final score is confirmed. The exact resolution timing depends on when the game ends, including overtime if applicable."},"tradersSaying":{"q":"What are traders saying about “{title}”?","activeA":"The “{title}” market has {commentCountDisplay} comments where traders share their analysis, debate game outcomes, and discuss breaking developments like injury updates and lineup changes. Scroll down to the comments section to join the conversation. You can also check the Top Holders tab to see how the market’s biggest traders are positioned, or view the Activity tab for a real-time feed of trades being placed.","newA":"The “{title}” market’s comments section is open for discussion — be the first to share your analysis on this game. Scroll down to the comments section to join the conversation. You can also check the Top Holders tab to see how the market’s biggest traders are positioned, or view the Activity tab for a real-time feed of trades being placed."},"whatIsPolymarket":{"q":"What is Polymarket?","a":"Polymarket is the world’s largest prediction market, where you can stay informed and trade on real-world events. Traders buy and sell shares on outcomes across politics, sports, crypto, finance, tech, and culture — including {leagueName} events and games. Prices reflect real-time, crowd-sourced probabilities backed by real money, offering a transparent, market-driven alternative to traditional odds sources. Whether you’re a seasoned sports trader or just getting started, Polymarket lets you put your knowledge to work."}},"esportsEventFaq":{"whatIsMarket":{"q":"What is the “{title}” prediction market?","a":"The “{title}” market on Polymarket lets you trade on the outcome of the {gameTitle} match between {teamA} and {teamB} in the {tournamentName}, scheduled for {gameDate} at {gameTime} ET. This is a Best of {boCount} series. The primary market is the series moneyline — which team will win the match — where {teamA} is currently priced at {teamAPrice}¢ ({teamAPrice}% implied probability) and {teamB} at {teamBPrice}¢ ({teamBPrice}%). Beyond the series moneyline, esports markets on Polymarket may feature individual {unit} winners, {unit} handicaps, and total {unitPlural}, giving you multiple ways to trade on this match. Prices reflect real-time crowd-sourced probabilities. Shares in the correct outcome pay out $1 each when the market resolves after the match ends.","aNoBoCount":"The “{title}” market on Polymarket lets you trade on the outcome of the {gameTitle} match between {teamA} and {teamB} in the {tournamentName}, scheduled for {gameDate} at {gameTime} ET. The primary market is the series moneyline — which team will win the match — where {teamA} is currently priced at {teamAPrice}¢ ({teamAPrice}% implied probability) and {teamB} at {teamBPrice}¢ ({teamBPrice}%). Beyond the series moneyline, esports markets on Polymarket may feature individual {unit} winners, {unit} handicaps, and total {unitPlural}, giving you multiple ways to trade on this match. Prices reflect real-time crowd-sourced probabilities. Shares in the correct outcome pay out $1 each when the market resolves after the match ends."},"activity":{"q":"How much trading activity has “{title}” generated on Polymarket?","a":"As of now, the “{title}” market has generated {totalVolume} in total trading volume across all market types (series moneyline, individual {unit} winners, {unit} handicaps, and total {unitPlural}). This volume reflects active engagement from the Polymarket trading community, and a deeper pool of traders generally means more informative, reliable odds. You can track live price movements and trade on any market directly on this page."},"howToTrade":{"q":"How do I trade on “{title}”?","a":"To trade on “{title},” start by choosing the market type you want to trade: Series Moneyline (which team wins the match), Individual {unitCap} Winners (who wins a specific {unit} in the series), {unitCap} Handicap ({unit}-win margin), or Total {unitPluralCap} (over/under on the number of {unitPlural} played). Each market shows the current price for each side — for example, the moneyline shows {teamAAbbreviation} at {teamAPrice}¢ and {teamBAbbreviation} at {teamBPrice}¢. Select the side you want to trade, choose Buy to take a position or Sell to close an existing one, enter your amount, and click Trade. If your chosen side is correct when the match ends and the market resolves, your shares pay out $1 each. If it's incorrect, they pay out $0. You can also sell your shares at any time before the match ends to lock in a profit or cut a loss."},"currentOdds":{"q":"What are the current odds for “{title}”?","a":"The current series moneyline odds for “{title}” show {teamA} at {teamAPrice}¢ ({teamAPrice}% implied probability) and {teamB} at {teamBPrice}¢ ({teamBPrice}%). All odds update in real-time as traders buy and sell shares, reflecting the latest collective view of how this match will play out. Check back frequently or bookmark this page to follow how the odds shift as match time approaches."},"followWithout":{"q":"Can I follow “{title}” without placing a trade?","a":"Yes. You don't need to trade to stay informed. This page serves as a live odds tracker for the {teamA} vs. {teamB} match. The series moneyline, individual {unit} winner, {unit} handicap, and total {unitPlural} odds all update in real-time as new trades come in. You can use the chart to track line movement as match time approaches — shifts in the odds often signal new information like roster changes, recent form, or sharp action from big traders. Check out Head to Head, Form Guide, and Map Winrate on certain matchups for deeper data and context. Bookmark this page, check the comments section to see what other traders are saying, and use the time-range filters on the chart to review how the odds have shifted. It's a free, real-time window into what the market expects."},"reliability":{"q":"Why are Polymarket's odds for “{title}” considered reliable?","schemaA":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to produce well-calibrated probabilities. With {totalVolume} traded on “{title},” these prices aggregate the collective knowledge and conviction of active participants — similar to how traditional sportsbooks reflect sharp and public money, but in an open, transparent market anyone can participate in. Prediction markets have a strong track record of accuracy, especially as events approach their resolution. For the latest stats, visit the accuracy page on Polymarket.","beforeLink":"Polymarket odds are set by real traders putting real money behind their beliefs, which tends to produce well-calibrated probabilities. With {totalVolume} traded on “{title},” these prices aggregate the collective knowledge and conviction of active participants — similar to how traditional sportsbooks reflect sharp and public money, but in an open, transparent market anyone can participate in. Prediction markets have a strong track record of accuracy, especially as events approach their resolution. For the latest stats, visit the ","afterLink":" on Polymarket.","linkText":"accuracy page"},"getStarted":{"q":"How do I start trading on “{title}”?","a":"To place your first trade on “{title},” sign up for a free Polymarket account and fund it using crypto, a credit or debit card, or a bank transfer. Once your account is funded, return to this page and choose a market type — Series Moneyline, Individual {unitCap} Winners, {unitCap} Handicap, or Total {unitPluralCap} — select the side you want to trade (e.g., {teamAAbbreviation} or {teamBAbbreviation} on the moneyline), enter your amount, and click Trade. If you're new to prediction markets, click the “How it works” link at the top of any Polymarket page for a step-by-step walkthrough."},"priceMeaning":{"q":"What does a price of {teamAPrice}¢ for “{teamAAbbreviation}” mean?","a":"On Polymarket, the price of each side in a market represents the market's implied probability. A price of {teamAPrice}¢ for {teamAAbbreviation} on the series moneyline means traders collectively believe there is roughly a {teamAPrice}% chance that {teamA} will win this match. If you buy {teamAAbbreviation} shares at {teamAPrice}¢ and they win, you receive $1 per share — a profit of {teamAPayout}¢ per share. If they lose, those shares are worth $0. The same logic applies to individual {unit} winners, {unit} handicaps, and total {unitPlural}: a lower price means a higher potential payout but a lower implied probability of being correct."},"marketClose":{"q":"When does the “{title}” market close?","a":"The “{title}” match is scheduled for {gameDate} at {gameTime} ET in the {tournamentName}. Trading remains open and odds will continue to shift as new information emerges leading up to the match. The market resolves once the series concludes and the official results are confirmed by the resolution source. The exact resolution timing depends on how many {unitPlural} are played in the Best of {boCount} series.","aNoBoCount":"The “{title}” match is scheduled for {gameDate} at {gameTime} ET in the {tournamentName}. Trading remains open and odds will continue to shift as new information emerges leading up to the match. The market resolves once the series concludes and the official results are confirmed by the resolution source."},"tradersSaying":{"q":"What are traders saying about “{title}”?","activeA":"The “{title}” market has {commentCountDisplay} comments where traders share their analysis, debate match outcomes, and discuss breaking developments like roster changes and recent form. Scroll down to the comments section to join the conversation. You can also check the Top Holders tab to see how the market's biggest traders are positioned, or view the Activity tab for a real-time feed of trades being placed.","newA":"The “{title}” market's comments section is open for discussion — be the first to share your analysis on this match. Scroll down to the comments section to join the conversation. You can also check the Top Holders tab to see how the market's biggest traders are positioned, or view the Activity tab for a real-time feed of trades being placed."},"whatIsPolymarket":{"q":"What is Polymarket?","a":"Polymarket is the world's largest prediction market, where you can stay informed and trade on real-world events. Traders buy and sell shares on outcomes across politics, sports, crypto, finance, tech, culture, and esports — including tournaments and matches across League of Legends, CS2, Valorant, Dota 2, and more. Prices reflect real-time, crowd-sourced probabilities backed by real money, offering a transparent, market-driven alternative to traditional odds sources. Whether you're a seasoned esports trader or just getting started, Polymarket lets you put your knowledge to work."}},"upDownFaq":{"whatIsMarket":{"q":"What is the \"{title}\" prediction market?","a":"\"{title}\" is a {windowLabel} prediction market on Polymarket where traders buy and sell shares on whether {cryptoName}'s price will finish higher (\"Up\") or lower (\"Down\") than its opening price over the {windowLabel} window specified in the title. The current market probability is {leadingProbabilityDisplay} for \"{leadingOutcome}.\" A price of {leadingProbabilityDisplay} means the market collectively assigns a {leadingProbabilityDisplay} chance to that outcome. Prices update in real-time as traders react to live {cryptoName} price movements. Shares in the correct outcome are redeemable for $1 each upon market resolution."},"activity":{"q":"How much trading activity has \"{title}\" generated on Polymarket?","highVolumeA":"As of today, \"{title}\" has generated {totalVolumeRounded} in total trading volume. {cryptoName} Up or Down markets attract active traders reacting to live price movements in real time — this level of activity helps ensure the current Up/Down odds are informed by a deep pool of market participants. You can track live prices and place a trade directly on this page.","lowVolumeA":"\"{title}\" is an active short-term market on Polymarket. Trading volume can accumulate quickly as the {windowLabel} window progresses — jump in early to help set the odds before this window closes."},"howToTrade":{"q":"How do I trade on \"{title}\"?","chainlinkA":"To trade on \"{title},\" decide whether you believe {cryptoName}'s price will finish above or below the opening \"Price to Beat\"{priceToBeatPart}{endTimePart}. Buy \"Up\" if you think the price will rise, or \"Down\" if you think it will fall. Enter your amount and click \"Trade.\" If your chosen outcome is correct at resolution, each share pays out $1.00. If incorrect, shares are worth $0. Because this market resolves in {windowDuration}, the window to exit your position before resolution is short — trade with that in mind.","hourlyA":"To trade on \"{title},\" decide whether you believe {cryptoName}'s price will close higher (\"Up\") or lower (\"Down\") at the end of the {windowLabel} candle{startTimePart}. Buy \"Up\" if you think the close price will be higher than the open, or \"Down\" if you think it will be lower. Enter your amount and click \"Trade.\" If your chosen outcome is correct at resolution, each share pays out $1.00. If incorrect, shares are worth $0.","dailyA":"To trade on \"{title},\" decide whether you believe {cryptoName}'s price at noon ET on {resolutionDate} will be higher (\"Up\") or lower (\"Down\") than {cryptoName}'s price at noon ET on {referenceDate}. Buy \"Up\" if you think the price will rise day-over-day, or \"Down\" if you think it will fall. Enter your amount and click \"Trade.\" If your chosen outcome is correct at resolution, each share pays out $1.00. If incorrect, shares are worth $0."},"currentOdds":{"q":"What are the current odds for \"{title}\"?","resolvedA":"This {windowLabel} window has closed and resolved. The final outcome was \"{outcome}.\" Use the time-range navigation bar at the top of this page to view adjacent windows or find the current live market.","liveA":"The current probability for \"{title}\" is {leadingProbabilityDisplay} for \"{leadingOutcome},\" meaning the Polymarket crowd currently assigns a {leadingProbabilityDisplay} chance that {cryptoName}'s price will finish {upDown} over this {windowLabel} window. These odds update in real-time as traders react to live {cryptoName} price data. {urgency} Check back frequently or trade now before the window closes."},"resolution":{"q":"How will \"{title}\" be resolved?","chainlinkA":"The \"{title}\" market resolves based on whether {cryptoName}'s price at the end of the {windowLabel} window is greater than or equal to its price at the start of that window — if so, the outcome is \"Up\"; otherwise it is \"Down.\" The resolution source is the Chainlink {cryptoTicker}/USD data stream. You can review the complete resolution criteria and data source in the \"Rules\" section on this page. We recommend reading the rules carefully before trading, as they specify the precise conditions, edge cases, and data sources that govern how this market is settled.","hourlyA":"The \"{title}\" market resolves based on whether the closing price of the {cryptoName}/USDT 1-hour candle{startTimePart} on Binance is greater than or equal to its opening price — if so, the outcome is \"Up\"; otherwise it is \"Down.\" The resolution source is Binance ({cryptoTicker}/USDT). You can review the complete resolution criteria and data source in the \"Rules\" section on this page.","dailyA":"The \"{title}\" market resolves based on a comparison of {cryptoName}'s price at noon ET on {resolutionDate} versus noon ET on {referenceDate}, using Binance {cryptoTicker}/USDT 1-minute candle close prices. If the {resolutionDate} noon price is higher, the outcome is \"Up\"; if lower, \"Down\"; if equal, the market resolves 50-50. You can review the complete resolution criteria and data source in the \"Rules\" section on this page."},"followWithout":{"q":"Can I follow \"{title}\" without placing a trade?","shortWindowA":"Yes. You don't need to trade to stay informed. Each \"{title}\" page shows the live \"Price to Beat\"{priceToBeatPart} ({cryptoName}'s opening reference price for this window), the current live {cryptoName} price, and real-time Up/Down probabilities. Because each market window lasts {windowDuration}, individual pages resolve quickly — use the time-range navigation features at the top of the page to jump between windows and track how odds evolved across multiple intervals. You can also view the Order Book and Activity tab for a real-time feed of trade flow.","hourlyA":"Yes. You don't need to trade to stay informed. Each \"{title}\" page displays a live countdown timer showing how much time remains in the current hour, alongside real-time Up/Down probabilities. Use the time-range navigation features at the top of the page to browse past and upcoming hourly windows. You can also view the Order Book and Activity tab for a real-time feed of trade flow.","dailyA":"Yes. You don't need to trade to stay informed. Each \"{title}\" page shows real-time Up/Down probabilities reflecting trader sentiment on whether {cryptoName} will be higher or lower at noon ET tomorrow versus today. Use the date navigation features at the top of the page to browse past and upcoming daily windows. You can also view the Order Book and Activity tab for a real-time feed of trade flow."},"reliability":{"q":"Why are Polymarket's odds for \"{title}\" considered reliable?","highVolumeSchemaA":"Polymarket odds are set by real traders putting real money behind their beliefs. With {totalVolumeRounded} traded on \"{title},\" the Up/Down probabilities reflect the collective judgment of traders watching {cryptoName}'s live price in real time. For {windowLabel} markets like this one, the odds represent an instantaneous crowd consensus on {cryptoName}'s price momentum — most meaningful as the window approaches its close, when traders have the most current price information available. For the latest stats on Polymarket's overall prediction accuracy, visit the accuracy page on Polymarket.","highVolumeBeforeLink":"Polymarket odds are set by real traders putting real money behind their beliefs. With {totalVolumeRounded} traded on “{title},” the Up/Down probabilities reflect the collective judgment of traders watching {cryptoName}’s live price in real time. For {windowLabel} markets like this one, the odds represent an instantaneous crowd consensus on {cryptoName}’s price momentum — most meaningful as the window approaches its close, when traders have the most current price information available. For the latest stats on Polymarket’s overall prediction accuracy, visit the ","highVolumeAfterLink":" on Polymarket.","lowVolumeSchemaA":"Polymarket odds are set by real traders putting real money behind their beliefs. \"{title}\" is still building its trading base for this window, so the current Up/Down probabilities may reflect only a small number of trades. As more participants enter before the window closes, the odds will become increasingly robust. For the latest stats on Polymarket's overall prediction accuracy, visit the accuracy page on Polymarket.","lowVolumeBeforeLink":"Polymarket odds are set by real traders putting real money behind their beliefs. “{title}” is still building its trading base for this window, so the current Up/Down probabilities may reflect only a small number of trades. As more participants enter before the window closes, the odds will become increasingly robust. For the latest stats on Polymarket’s overall prediction accuracy, visit the ","lowVolumeAfterLink":" on Polymarket.","linkText":"accuracy page"},"getStarted":{"q":"How do I start trading on \"{title}\"?","a":"To place your first trade on \"{title},\" sign up for a free Polymarket account and fund it using crypto, a credit or debit card, or a bank transfer. Once your account is funded, return to this page — or navigate to the current active {windowLabel} window using the navigation bar at the top of the page — select \"Buy Up\" or \"Buy Down,\" enter your amount, and click \"Trade.\" If the window shown in the title has already closed, use the navigation bar to find the current live window. If you're new to prediction markets, click the \"How it works\" link at the top of any Polymarket page for a quick step-by-step walkthrough."},"priceMeaning":{"q":"What does a price of {leadingProbabilityCents} for \"{leadingOutcome}\" mean?","a":"On Polymarket, the price of each outcome represents the market's implied probability. A price of {leadingProbabilityCents} for \"{leadingOutcome}\" in the \"{title}\" market means traders collectively believe there is roughly a {leadingProbabilityDisplay} chance that {cryptoName}'s price will finish {upDown} over this {windowLabel} window. If you buy \"{leadingOutcome}\" shares at {leadingProbabilityCents} and {cryptoName} finishes in that direction, you receive $1.00 per share — a profit of {payoutMathDisplay} per share. If {cryptoName} moves the other way, those shares are worth $0. {volatilityNote}"},"marketClose":{"q":"When does the \"{title}\" market close?","liveA":"The \"{title}\" market is live and resolves{endTimePart}{timePart}. Trading is open. The Up/Down odds will continue shifting in real time as {cryptoName}'s price moves and traders react. Once the window closes, the market resolves based on {resolutionSummary}","resolvedA":"This {windowLabel} window closed{endTimePart} and has been resolved. The final outcome was \"{outcome}.\" Use the navigation bar at the top of this page to view adjacent windows or find the current live market.","pendingA":"This {windowLabel} window closed{endTimePart} but has not yet been officially resolved. Resolution typically follows within seconds to minutes of the window closing. Check the Rules section on this page for the exact resolution process and timeline."},"tradersSaying":{"q":"What are traders saying about \"{title}\"?","activeA":"The \"{title}\" market has {countDisplay} comments where traders share their analysis and react to live {cryptoName} price movements. Scroll down to the comments section to read what other participants think. You can also check the \"Activity\" tab for a real-time feed of trades on this window.","newMarketA":"No comments yet for this {windowLabel} window — check the \"Activity\" tab for a real-time feed of trades, or browse comments on other {cryptoName} Up or Down windows using the navigation bar above."},"whatIsPolymarket":{"q":"What is Polymarket?","a":"Polymarket is the world's largest prediction market, where you can stay informed and profit from your knowledge of real-world events. Traders buy and sell shares on outcomes for topics ranging from politics and elections to crypto, finance, sports, tech, and culture — including {windowLabel} {cryptoName} direction markets like \"{title}.\" Prices reflect real-time, crowd-sourced probabilities backed by financial conviction, often providing faster and more accurate signals than polls, pundits, or traditional surveys."},"windowUrgency":{"fiveminute":"Because this window resolves in 5 minutes, odds can shift sharply in the final seconds.","fifteen":"Because this window resolves in 15 minutes, odds can move quickly as new price data comes in.","hourly":"As the hour progresses, odds reflect the latest live price action relative to the open.","fourhour":"Over a 4-hour window, odds shift as broader price trends develop.","daily":"Over a full day, odds reflect evolving sentiment as the day's price action unfolds."},"priceVolatility":{"fiveminute":"Because this market resolves in 5 minutes, prices can shift dramatically in a very short time.","fifteen":"Because this market resolves in 15 minutes, prices can move quickly as new price data comes in.","hourly":"Prices can shift meaningfully during the hour as {cryptoName}'s live price action evolves.","fourhour":"Over a 4-hour window, prices shift as broader trends and market sentiment develop.","daily":"Prices can shift throughout the day as {cryptoName}'s price action unfolds toward the noon ET close."},"fragments":{"ofPriceToBeat":" of {priceToBeat}","byEndTime":" by {endTime}","atEndTime":" at {endTime}","beginningAtStartTime":" beginning at {startTime}","approximatelyFromNow":" — approximately {timeRemaining} from now","priceToBeatParens":" ({priceToBeat})","theResolutionDate":"the resolution date","theReferenceDate":"the reference date"},"resolutionSummary":{"chainlink":"whether the final Chainlink {cryptoTicker}/USD price is above or below the opening Price to Beat.","chainlinkWithPtb":"whether the final Chainlink {cryptoTicker}/USD price is above or below the opening Price to Beat of {priceToBeat}.","hourly":"whether the Binance {cryptoTicker}/USDT 1-hour candle closing price is above or below its opening price.","daily":"whether {cryptoName}'s Binance price at noon ET on {resolutionDate} is higher or lower than at noon ET on {referenceDate}.","pyth":"whether the Pyth-published price for {cryptoName} ({cryptoTicker}) at market close is higher or lower than the reference price at market open."},"windowLabels":{"fiveminute":"5-minute","fifteen":"15-minute","hourly":"hourly","fourhour":"4-hour","daily":"daily"},"windowDurations":{"fiveminute":"5 minutes","fifteen":"15 minutes","hourly":"1 hour","fourhour":"4 hours","daily":"1 day"},"timeRemaining":{"aboutOneMinute":"about 1 minute","aboutMinutes":"about {count} minutes","aboutOneHour":"about 1 hour","aboutHours":"about {count} hours","aboutOneDay":"about 1 day"}},"sportsCategoryFaq":{"title":"Frequently Asked Questions","noMarkets":{"q":"Are there {name} markets on Polymarket right now?","a":"There are no active {name} markets at the moment. New markets are typically listed ahead of the next {name} season or event — check back closer to game day, or browse other live markets from the left-side menu."},"sport":{"q1":{"q":"What is a {sportName} prediction market on Polymarket?","withMatchups":"A {sportName} prediction market lets traders buy and sell shares in real-world {sportName} outcomes for matchups like {topMarkets}. Each share is priced between 0¢ and 100¢, and the price reflects the market's implied probability that the outcome occurs.","noMatchups":"A {sportName} prediction market lets traders buy and sell shares in real-world {sportName} outcomes. Each share is priced between 0¢ and 100¢, and the price reflects the market's implied probability that the outcome occurs."},"q2":{"q":"How do {sportName} odds work on Polymarket?","withSample":"Polymarket uses probability-based pricing rather than traditional moneyline or spread odds. A {sportName} contract trading at {samplePrice}¢ implies the market believes there is a {samplePrice}% chance of that outcome. Prices update continuously as traders incorporate new information — injuries, weather, sportsbook movement, and in-play developments.","noSample":"Polymarket uses probability-based pricing rather than traditional moneyline or spread odds. A {sportName} contract priced between 0¢ and 100¢ reflects the market's implied probability of that outcome. Prices update continuously as traders incorporate new information — injuries, weather, sportsbook movement, and in-play developments."},"q3":{"q":"What are the most active {sportName} markets right now?","a":"The most-traded {sportName} markets at the moment include {topMarkets}. Trading volume reflects how much real money is flowing through each market and is a useful signal of where consensus is forming."},"q4":{"q":"When do new {sportName} markets get listed?","a":"New {sportName} markets are typically listed ahead of major fixtures, tournaments, and seasons. Markets are added as schedules are finalized and resolved once outcomes are official."},"q5":{"q":"How many {sportName} prediction markets are live on Polymarket right now?","withLeagues":"There are {activeCount} live {sportName} prediction markets, including ones for {topLeagues}, on Polymarket.","noLeagues":"There are {activeCount} live {sportName} prediction markets on Polymarket."},"q6":{"q":"Is Polymarket's {sportName} pricing reliable?","a":"Polymarket {sportName} prices reflect the consensus of traders putting real money at risk on {sportName} outcomes — what research often calls the \"wisdom of crowds\" with skin in the game."},"q7":{"q":"How are {sportName} predictions and {sportName} odds different on Polymarket?","a":"On Polymarket, {sportName} predictions aren't tips, picks, or guarantees — they're the live, market-driven view of how likely each {sportName} outcome is. {sportName} odds are shown as prices between 0¢ and 100¢, and that price is the implied probability of the outcome. So a {sportName} prediction is the question being asked (\"who wins?\"), and the {sportName} odds are the real-time, real-money answer the market is giving."}},"league":{"q1":{"q":"What is a {leagueName} prediction market on Polymarket?","a":"A {leagueName} prediction market lets traders take positions on real-world {leagueName} outcomes. Each market offers shares priced between 0¢ and 100¢, where the price represents the implied probability that the outcome occurs. You can browse all live {leagueName} markets on this page."},"q2":{"q":"How many {leagueName} markets are live on Polymarket right now?","withVolume":"There are currently {activeCount} active {leagueName} markets, with a combined trading volume of {totalVolume}. The full list is available on this page.","noVolume":"There are currently {activeCount} active {leagueName} markets on Polymarket. The full list is available on this page."},"q3":{"q":"What are today's most-traded {leagueName} markets?","a":"The top {leagueName} markets by volume right now are {topMarkets}. These are typically driven by upcoming matchups, breaking injury news, and lineup confirmations."},"q4":{"q":"What's the next big {leagueName} event I can trade on?","a":"The next scheduled {leagueName} event with a market on Polymarket is {nextEvent} on {nextDate}."},"q5":{"q":"How do I read {leagueName} odds in cents?","a":"Each contract is priced between 0¢ and 100¢. A {leagueName} team or player priced at 65¢, for example, means the market is implying a 65% probability that they win or hit the stated outcome. The other side trades at 35¢."},"q6":{"q":"What types of {leagueName} markets can I trade on Polymarket?","a":"{leagueName} markets typically cover individual game and match outcomes, season-long awards, championship futures, and player props where available. The exact mix depends on the {leagueName} schedule and what traders are most active on at any given time — see the live list on this page for what's currently open."},"q7":{"q":"What factors usually move {leagueName} prices the most?","a":"Prices tend to move fastest on news that changes who is playing or how they'll perform — confirmed lineups, injury updates, suspensions, weather, and in-play developments. The 24–48 hours before a {leagueName} event are typically the most active window for price movement."}}},"homepageV2":{"featuredMarketsSectionHeading":"Featured markets","featuredMarketsCarousel":"Featured markets carousel","allMarkets":"All markets","exploreAll":"Explore all","breakingNews":"Breaking news","hotTopics":"Hot topics","today":"today","endedAt":"Ended at {time}","endedOn":"Ended on {date}","ends":"Ends {date}","vol":"Vol","live":"Live","topTraders":"Top Traders","trader":"Trader","side":"Side","pnl":"PnL","spread":"Spread","total":"Total","sports":"Sports","priceToBeat":"Price To Beat","currentPrice":"Current Price","endsIn":"Ends in","chance":"chance","yes":"Yes","no":"No","draw":"DRAW","up":"Up","down":"Down","upOrDown":"Up or Down","pickedForYou":"Picked for you","showMore":"Show more"},"breaking":{"title":"Breaking News","description":"See the polymarkets that moved the most in the last 24 hours","movers":{"categories":{"all":"All","politics":"Politics","world":"World","sports":"Sports","crypto":"Crypto","finance":"Finance","tech":"Tech","culture":"Culture"},"emptyState":"No significant market movements in this category","emptyStateDescription":"Try selecting 